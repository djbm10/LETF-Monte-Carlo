def fetch_fama_french_data(start_date: str, end_date: str) -> pd.DataFrame:
    """
    Fetch daily market returns from the Fama-French Data Library.
    
    The Fama-French data goes back to July 1926, giving us nearly 100 years
    of market history including:
    - The Great Depression (1929-1932)
    - World War II (1941-1945)
    - Post-war boom (1945-1950)
    
    Data source: Kenneth French's website (via pandas_datareader)
    https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/data_library.html
    
    Args:
        start_date: Start date as 'YYYY-MM-DD'
        end_date: End date as 'YYYY-MM-DD'
    
    Returns:
        DataFrame with columns:
        - SPY_Ret: Daily market return (decimal, e.g., 0.01 for 1%)
        - RF: Daily risk-free rate (decimal)
        - SPY_Price: Synthetic price series (for compatibility)
    """
    
    print("  📚 Fetching Fama-French daily data (1926-present)...")
    
    try:
        # Fetch the Fama-French 3 Factors (Daily)
        # This includes Mkt-RF, SMB, HML, and RF
        ff_data = web.DataReader(
            'F-F_Research_Data_Factors_daily',
            'famafrench',
            start=start_date,
            end=end_date
        )
        
        # The data is returned as a dict with one DataFrame
        # Key '0' contains the daily data
        ff_df = ff_data[0].copy()
        
        print(f"  ✓ Fama-French data retrieved: {len(ff_df):,} days")
        print(f"    Date range: {ff_df.index[0]} to {ff_df.index[-1]}")
        
    except Exception as e:
        print(f"  ✗ Error fetching Fama-French data: {e}")
        print("  Attempting alternative download method...")
        
        try:
            # Alternative: Direct CSV download from Kenneth French's website
            import urllib.request
            import zipfile
            import io
            
            url = "https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/ftp/F-F_Research_Data_Factors_daily_CSV.zip"
            
            # Download the zip file
            with urllib.request.urlopen(url) as response:
                zip_data = response.read()
            
            # Extract and read the CSV
            with zipfile.ZipFile(io.BytesIO(zip_data)) as z:
                csv_name = [n for n in z.namelist() if n.endswith('.CSV')][0]
                with z.open(csv_name) as f:
                    # Skip header rows and read data
                    ff_df = pd.read_csv(f, skiprows=3)
            
            # Clean up the data
            ff_df.columns = ['Date', 'Mkt-RF', 'SMB', 'HML', 'RF']
            ff_df['Date'] = pd.to_datetime(ff_df['Date'], format='%Y%m%d')
            ff_df.set_index('Date', inplace=True)
            ff_df = ff_df.apply(pd.to_numeric, errors='coerce')
            
            # Filter to date range
            ff_df = ff_df.loc[start_date:end_date]
            
            print(f"  ✓ Fama-French data (alternative): {len(ff_df):,} days")
            
        except Exception as e2:
            print(f"  ✗ Alternative download also failed: {e2}")
            return None
    
    # Create output DataFrame
    result = pd.DataFrame(index=ff_df.index)
    
    # Convert from percentage points to decimals
    # Fama-French data is in percentage points (e.g., 1.5 = 1.5%)
    # We need decimals (e.g., 0.015)
    
    # Market return = Mkt-RF + RF
    result['SPY_Ret'] = (ff_df['Mkt-RF'] + ff_df['RF']) / 100.0
    
    # Risk-free rate (for borrowing costs)
    result['RF'] = ff_df['RF'] / 100.0
    
    # IRX convention: annual percentage points (e.g. 5.0 = 5%/yr).
    # ff_df['RF'] is in daily PERCENTAGE POINTS (e.g. 0.02 = 0.02%/day), already ×100.
    # Annualise by ×252 only — do NOT multiply by another 100.
    result['IRX'] = ff_df['RF'] * 252  # daily pct-points → annual pct-points
    
    # Create synthetic price series (for compatibility with existing code)
    # Start at 100 and compound returns
    result['SPY_Price'] = (1 + result['SPY_Ret']).cumprod() * 100
    
    # For pre-1950, we don't have NASDAQ, so approximate it
    # Historical beta of NASDAQ to S&P is roughly 1.2-1.3
    # This is a rough approximation for synthetic LETF calculation
    result['NASDAQ_Ret'] = result['SPY_Ret'] * 1.25
    result['QQQ_Ret'] = result['NASDAQ_Ret']  # QQQ tracks NASDAQ
    
    # Synthetic VIX (volatility index didn't exist before 1990)
    # Approximate using 20-day rolling volatility
    rolling_vol = result['SPY_Ret'].rolling(20).std() * np.sqrt(252) * 100
    result['VIX'] = rolling_vol.fillna(20.0)  # Default to 20 if not enough data
    
    # Treasury returns approximation for pre-1950
    # Use inverse correlation to equity as rough proxy
    # Historical correlation of long bonds to stocks is roughly -0.2 to -0.3
    result['TLT_Ret'] = result['SPY_Ret'] * -0.25 + result['RF']
    
    # Mark all Fama-French data as from this source
    result['Data_Source'] = 'Fama-French'
    
    print(f"  ✓ Fama-French data processed")
    print(f"    Sample return (first day): {result['SPY_Ret'].iloc[0]*100:.2f}%")
    print(f"    Sample RF (first day): {result['RF'].iloc[0]*100:.4f}%")
    
    return result


def combine_data_sources(ff_data: pd.DataFrame, yf_data: pd.DataFrame, 
                         cutoff_date: str = "1950-01-01") -> pd.DataFrame:
    """
    Combine Fama-French (pre-1950) and yfinance (1950+) data.
    
    This function:
    1. Uses Fama-French data for dates BEFORE cutoff_date
    2. Uses yfinance data for dates ON or AFTER cutoff_date
    3. Ensures smooth transition at the cutoff
    
    Args:
        ff_data: DataFrame from fetch_fama_french_data()
        yf_data: DataFrame from yfinance processing
        cutoff_date: Date to switch from FF to yfinance
    
    Returns:
        Combined DataFrame with full history
    """
    
    print(f"\n  🔗 Combining data sources at {cutoff_date}...")
    
    cutoff = pd.to_datetime(cutoff_date)
    
    # Filter each dataset
    ff_before = ff_data[ff_data.index < cutoff].copy()
    yf_after = yf_data[yf_data.index >= cutoff].copy()
    
    print(f"    Fama-French (pre-{cutoff_date}): {len(ff_before):,} days")
    print(f"    yfinance ({cutoff_date}+): {len(yf_after):,} days")
    
    # Mark data sources
    if 'Data_Source' not in ff_before.columns:
        ff_before['Data_Source'] = 'Fama-French'
    if 'Data_Source' not in yf_after.columns:
        yf_after['Data_Source'] = 'yfinance'
    
    # Align columns - use yfinance columns as the standard
    # Add any missing columns to ff_before with NaN
    for col in yf_after.columns:
        if col not in ff_before.columns:
            ff_before[col] = np.nan
    
    # For columns in ff_before but not yf_after, they'll be kept
    # This is fine - we'll have full data where available
    
    # Concatenate
    combined = pd.concat([ff_before, yf_after], axis=0)
    combined = combined.sort_index()
    
    # Remove any duplicate dates (prefer yfinance data)
    combined = combined[~combined.index.duplicated(keep='last')]
    
    # Recalculate price series to be continuous
    # The SPY_Price needs to be continuous across the boundary
    if 'SPY_Ret' in combined.columns:
        combined['SPY_Price'] = (1 + combined['SPY_Ret'].fillna(0)).cumprod() * 100
    
    print(f"    Combined total: {len(combined):,} days")
    print(f"    Date range: {combined.index[0].date()} to {combined.index[-1].date()}")
    
    # Verify the transition
    transition_idx = combined.index.get_indexer([cutoff], method='nearest')[0]
    if transition_idx > 0 and transition_idx < len(combined) - 1:
        before_ret = combined.iloc[transition_idx - 1]['SPY_Ret']
        after_ret = combined.iloc[transition_idx]['SPY_Ret']
        print(f"    Transition check: day before = {before_ret*100:.2f}%, day of = {after_ret*100:.2f}%")
    
    return combined


def _fetch_fred_monthly_series(series_id: str,
                               start_date: str,
                               end_date: str,
                               timeout_sec: float = 6.0) -> Optional[pd.Series]:
    """Fetch monthly macro series from FRED CSV endpoint; returns None on failure."""
    try:
        import urllib.request
        url = f"https://fred.stlouisfed.org/graph/fredgraph.csv?id={series_id}"
        with urllib.request.urlopen(url, timeout=float(timeout_sec)) as resp:
            raw = resp.read()
        tmp = pd.read_csv(io.BytesIO(raw))
        if 'DATE' not in tmp.columns:
            return None
        value_cols = [c for c in tmp.columns if c != 'DATE']
        if len(value_cols) == 0:
            return None
        dt = pd.to_datetime(tmp['DATE'], errors='coerce')
        vals = pd.to_numeric(tmp[value_cols[0]], errors='coerce')
        s = pd.Series(vals.values, index=dt).sort_index()
        s = s.replace([np.inf, -np.inf], np.nan).dropna()
        if len(s) == 0:
            return None
        s = s.loc[pd.Timestamp(start_date) - pd.Timedelta(days=366):pd.Timestamp(end_date) + pd.Timedelta(days=31)]
        if len(s) == 0:
            return None
        return s.astype(float)
    except Exception:
        return None


def _derive_cape_proxy_series(df: pd.DataFrame) -> pd.Series:
    """
    CAPE proxy fallback when direct Shiller series is unavailable.
    Uses real-price over 10-year real-price average, re-centered to CAPE-like levels.
    """
    if 'SPY_Price' in df.columns:
        px = pd.Series(df['SPY_Price']).astype(float).replace([np.inf, -np.inf], np.nan)
    else:
        px = (1.0 + pd.Series(df['SPY_Ret']).fillna(0.0)).cumprod() * 100.0
    px = px.ffill().bfill().fillna(method='ffill')

    infl_daily = (1.0 + float(HISTORICAL_INFLATION)) ** (1.0 / 252.0) - 1.0
    cpi = np.cumprod(np.full(len(px), 1.0 + infl_daily, dtype=float))
    real_px = px.to_numpy(dtype=float) / np.clip(cpi, 1e-9, None)
    real_px_s = pd.Series(real_px, index=px.index)

    earn_proxy = real_px_s.rolling(2520, min_periods=756).mean() / 15.0
    cape = real_px_s / np.clip(earn_proxy, 1e-8, None)
    cape = cape.replace([np.inf, -np.inf], np.nan)

    finite = cape[np.isfinite(cape)]
    if len(finite) > 120:
        med = float(np.nanmedian(finite))
        if med > 1e-6:
            cape = cape * (float(STRUCTURAL_CAPE_FALLBACK_LEVEL) / med)
    cape = cape.clip(lower=5.0, upper=85.0).ffill().bfill().fillna(float(STRUCTURAL_CAPE_FALLBACK_LEVEL))
    return cape.astype(float)


def attach_valuation_series(df: pd.DataFrame) -> pd.DataFrame:
    """Attach daily CAPE valuation series (Shiller if available, proxy fallback)."""
    out = df.copy()
    if not STRUCTURAL_CAPE_ENABLED:
        out['CAPE'] = float(STRUCTURAL_CAPE_FALLBACK_LEVEL)
        out['CAPE_Source'] = 'disabled_fallback_constant'
        return out

    cape_daily = None
    cape_source = None
    for sid in STRUCTURAL_CAPE_SERIES_IDS:
        s = _fetch_fred_monthly_series(
            series_id=str(sid),
            start_date=str(out.index.min().date()),
            end_date=str(out.index.max().date())
        )
        if s is None or len(s) < 24:
            continue
        d = pd.Series(index=out.index, dtype=float)
        d[:] = np.nan
        d = d.combine_first(s.reindex(out.index, method='ffill'))
        if d.notna().sum() >= 252:
            cape_daily = d.astype(float)
            cape_source = f'fred:{sid}'
            break

    if cape_daily is None:
        cape_daily = _derive_cape_proxy_series(out)
        cape_source = 'proxy_real_price_ma10y'

    out['CAPE'] = cape_daily.astype(float).clip(5.0, 85.0).ffill().bfill().fillna(float(STRUCTURAL_CAPE_FALLBACK_LEVEL))
    out['CAPE_Source'] = str(cape_source)
    return out


def calibrate_structural_economic_model(df: pd.DataFrame) -> Dict[str, Any]:
    """
    Calibrate structural macro drivers:
    - valuation mean reversion (CAPE)
    - interest-rate regime effects
    - term-structure effects
    """
    model: Dict[str, Any] = {
        'enabled': bool(STRUCTURAL_CAPE_ENABLED),
        'model_version': STRUCTURAL_MACRO_MODEL_VERSION,
        'cape_center': float(STRUCTURAL_CAPE_FALLBACK_LEVEL),
        'cape_scale': 6.0,
        'cape_kappa_annual': float(STRUCTURAL_CAPE_MEAN_REVERT_SPEED),
        'cape_sigma_annual': float(STRUCTURAL_CAPE_DAILY_SIGMA),
        'cape_rate_low_shift': 1.5,
        'cape_rate_high_shift': -2.0,
        'beta_cape_annual': -0.012,
        'beta_rate_annual': -0.0025,
        'beta_curve_annual': 0.0015,
        'beta_inversion_annual': -0.0020,
        'rate_neutral_pct': 3.0,
        'rate_low_cut_pct': 2.0,
        'rate_high_cut_pct': 5.5,
        'term_inversion_cut_pct': 0.0,
        'qqq_valuation_mult': float(STRUCTURAL_QQQ_VALUATION_MULT),
        'n_obs': 0,
        'cape_source': None
    }
    if df is None or len(df) < 252 * 5:
        return model

    work = df.copy()
    if 'CAPE' not in work.columns:
        work = attach_valuation_series(work)
    if 'SPY_Price' not in work.columns:
        work['SPY_Price'] = (1.0 + work['SPY_Ret'].fillna(0.0)).cumprod() * 100.0

    cape = pd.to_numeric(work.get('CAPE', pd.Series(index=work.index, dtype=float)), errors='coerce')
    cape = cape.replace([np.inf, -np.inf], np.nan).ffill().bfill()
    irx = pd.to_numeric(work.get('IRX', pd.Series(3.0, index=work.index)), errors='coerce').ffill().bfill().fillna(3.0)
    if 'TNX' in work.columns:
        tnx = pd.to_numeric(work['TNX'], errors='coerce').ffill().bfill().fillna(irx + 1.0)
    else:
        tnx = irx + 1.0
    term_spread = tnx - irx

    cape_finite = cape[np.isfinite(cape)]
    if len(cape_finite) > 120:
        center = float(np.nanmedian(cape_finite))
        q25, q75 = np.nanpercentile(cape_finite, [25, 75])
        scale = max(float((q75 - q25) / 1.349), 2.0)
        model['cape_center'] = center
        model['cape_scale'] = scale
        model['cape_source'] = str(work.get('CAPE_Source', 'unknown').iloc[0]) if 'CAPE_Source' in work.columns else 'unknown'

    irx_finite = irx[np.isfinite(irx)]
    if len(irx_finite) > 120:
        model['rate_neutral_pct'] = float(np.nanmedian(irx_finite))
        model['rate_low_cut_pct'] = float(np.nanpercentile(irx_finite, 30))
        model['rate_high_cut_pct'] = float(np.nanpercentile(irx_finite, 75))
    ts_finite = term_spread[np.isfinite(term_spread)]
    if len(ts_finite) > 120:
        model['term_inversion_cut_pct'] = float(np.nanpercentile(ts_finite, 30))

    # Forward 10Y CAGR target.
    h = 252 * 10
    px = work['SPY_Price'].to_numpy(dtype=float)
    fwd10 = np.full(len(work), np.nan, dtype=float)
    if len(px) > h and np.all(px[:len(px) - h] > 0):
        fwd10[:len(px) - h] = (px[h:] / np.clip(px[:len(px) - h], 1e-9, None)) ** (1.0 / 10.0) - 1.0

    z_cape = (cape.to_numpy(dtype=float) - float(model['cape_center'])) / max(float(model['cape_scale']), 1.0)
    rate_dev = irx.to_numpy(dtype=float) - float(model['rate_neutral_pct'])
    ts = term_spread.to_numpy(dtype=float)
    inversion = np.maximum(-ts, 0.0)
    X = np.column_stack([
        np.ones(len(work), dtype=float),
        z_cape,
        rate_dev,
        ts,
        inversion
    ])
    y = np.asarray(fwd10, dtype=float)
    mask = np.isfinite(y) & np.all(np.isfinite(X), axis=1)
    if int(mask.sum()) >= 400:
        Xf = X[mask]
        yf = y[mask]
        reg = np.diag([1e-6, 2e-3, 2e-3, 2e-3, 2e-3])
        beta = np.linalg.solve(Xf.T @ Xf + reg, Xf.T @ yf)
        # Enforce sign-consistent valuation mean reversion and bounded effects.
        beta_cape = float(np.clip(beta[1], -0.030, -0.002))
        beta_rate = float(np.clip(beta[2], -0.010, 0.004))
        beta_curve = float(np.clip(beta[3], -0.006, 0.006))
        beta_inv = float(np.clip(beta[4], -0.010, 0.004))
        model['beta_cape_annual'] = beta_cape
        model['beta_rate_annual'] = beta_rate
        model['beta_curve_annual'] = beta_curve
        model['beta_inversion_annual'] = beta_inv
        model['n_obs'] = int(mask.sum())

    print(f"  Structural macro drivers: CAPE center={model['cape_center']:.2f}, "
          f"scale={model['cape_scale']:.2f}, beta_cape={model['beta_cape_annual']:+.4f}/yr, "
          f"beta_rate={model['beta_rate_annual']:+.4f}/yr, "
          f"beta_curve={model['beta_curve_annual']:+.4f}/yr, "
          f"n_obs={model['n_obs']}")
    return model


