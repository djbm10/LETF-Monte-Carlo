def calibrate_regime_model_volatility(df):
    """
    Fit 3-state volatility/drawdown regime model.

    State design:
    - 0: low-volatility regime (calm expansion)
    - 1: high-volatility shock regime (VIX spike / acute stress)
    - 2: bear-market regime (prolonged equity drawdown, months to years)

    Topology calibration still uses post-1990 actual VIX where available.
    """
    global HIGH_VOL_LOGIT_SHIFT, STRESS_LOGIT_PARAMS
    cached = load_cache(REGIME_MODEL_CACHE)
    if cached is not None:
        if isinstance(cached, dict) and cached.get('schema_version') == REGIME_MODEL_SCHEMA_VERSION:
            HIGH_VOL_LOGIT_SHIFT = float(cached.get('logit_shift', 0.0))
            STRESS_LOGIT_PARAMS = dict(cached.get('stress_logit_params', DEFAULT_STRESS_LOGIT_PARAMS))
            print(f"✓ Using cached regime model (logit_shift={HIGH_VOL_LOGIT_SHIFT:+.3f})")
            return cached
        print("  ⚠ Cached regime model schema mismatch — recalibrating")

    print(f"\n{'='*80}")
    print("CALIBRATING REGIME MODEL FROM VOLATILITY (CORRECT APPROACH)")
    print(f"{'='*80}\n")
    print(f"  Fitting {N_REGIMES}-regime model to VIX levels...")

    vix_series = df['VIX'].to_numpy(dtype=float)
    spy_returns = df['SPY_Ret'].to_numpy(dtype=float)
    realized_vol = df['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0) * np.sqrt(252)
    term_spread = (df['TNX'] - df['IRX']).values if 'TNX' in df.columns and 'IRX' in df.columns else None
    recession_proxy = df['USREC'].to_numpy(dtype=float) if 'USREC' in df.columns else None
    p_bear = np.zeros(len(df), dtype=float)
    bear_label_diag = {}

    # Fix 1: pre-1990 synthetic VIX is lagged realized vol that never spikes to real-crisis
    # levels (effective p=0.5 threshold at VIX≈38), so regime topology must come from
    # post-1990 actual VIX data.  Pre-1990 periods are labelled via a realized-vol threshold
    # derived from the post-1990 calibration.
    has_pre_1990 = df.index[0] < pd.Timestamp('1990-01-01')
    if has_pre_1990:
        print("  (Pre-1990 detected: regime topology calibrated from post-1990 actual VIX)")
        df_cal  = df.loc[df.index >= '1990-01-01']
        rv_cal  = df_cal['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0).values * np.sqrt(252)
        vix_cal = df_cal['VIX'].values
        ts_cal  = (df_cal['TNX'] - df_cal['IRX']).values if 'TNX' in df_cal.columns and 'IRX' in df_cal.columns else None
        calibrated_params = calibrate_stress_logit_parameters(
            vix_series=vix_cal, realized_vol=rv_cal, term_spread=ts_cal,
            vix_stress_threshold=HIGH_VOL_STRESS_LABEL_VIX_THRESHOLD
        )
        STRESS_LOGIT_PARAMS = dict(calibrated_params)
        cal_logit_shift = float(calibrated_params.get('intercept', DEFAULT_STRESS_LOGIT_PARAMS['intercept']) -
                                DEFAULT_STRESS_LOGIT_PARAMS['intercept'])
        HIGH_VOL_LOGIT_SHIFT = cal_logit_shift
        print(f"  (Calibrated stress-logit params: intercept={calibrated_params['intercept']:+.3f}, "
              f"vix={calibrated_params['beta_vix']:.3f}, rv={calibrated_params['beta_rv']:.3f}, "
              f"curve={calibrated_params['beta_ts']:.3f})")
        print(f"  (Calibrated high-vol logit shift vs default: {cal_logit_shift:+.3f})")
        _rv_ref = float(np.nanmedian(rv_cal)) if len(rv_cal) > 0 else 0.18
        _ts_ref = float(np.nanmedian(ts_cal)) if ts_cal is not None and len(ts_cal) > 0 else 0.0
        _vix_p50 = estimate_effective_vix_p50(calibrated_params, _rv_ref, _ts_ref)
        if np.isfinite(_vix_p50):
            print(f"  (Effective p=0.5 VIX crossing at median conditions: {_vix_p50:.1f})")
        base_regimes_cal = infer_regime_from_vix(
            vix_series=vix_cal, realized_vol=rv_cal, term_spread=ts_cal,
            logit_shift=0.0, logit_params=calibrated_params
        )
        p_high_cal  = compute_high_vol_probability(
            vix_series=vix_cal, realized_vol=rv_cal, term_spread=ts_cal,
            logit_shift=0.0, logit_params=calibrated_params
        )
        # Midpoint of median calm vs median shock-vol → threshold for pre-1990
        rv_calm_m   = np.median(rv_cal[base_regimes_cal == REGIME_LOW]) if np.any(base_regimes_cal == REGIME_LOW) else 0.12
        rv_crisis_m = np.median(rv_cal[base_regimes_cal == REGIME_HIGH_VOL]) if np.any(base_regimes_cal == REGIME_HIGH_VOL) else 0.28
        rv_threshold = (rv_calm_m + rv_crisis_m) / 2.0
        print(f"  (Realized-vol threshold for pre-1990 labeling: {rv_threshold*100:.1f}%)")

        # Full-timeline baseline labels: vol-threshold for pre-1990, VIX-based for post-1990
        rv_full    = realized_vol.values
        base_regimes_full = (rv_full > rv_threshold).astype(int)
        p_high_vol = (rv_full > rv_threshold).astype(float)
        post_mask  = np.asarray(df.index >= pd.Timestamp('1990-01-01'))
        base_regimes_full[post_mask] = base_regimes_cal
        p_high_vol[post_mask] = p_high_cal

        if N_REGIMES >= 3:
            bear_cal, bear_cal_diag = _calibrate_bear_mask_to_share(
                spy_returns=df_cal['SPY_Ret'].to_numpy(dtype=float),
                vix_series=vix_cal,
                recession_proxy=df_cal['USREC'].to_numpy(dtype=float) if 'USREC' in df_cal.columns else None,
                target_share=BEAR_LABEL_TARGET_SHARE,
                max_share=BEAR_LABEL_MAX_SHARE,
                target_median_days=BEAR_LABEL_TARGET_MEDIAN_DAYS,
                max_median_days=BEAR_LABEL_MAX_MEDIAN_DAYS,
                target_p90_days=BEAR_LABEL_TARGET_P90_DAYS,
                max_p90_days=BEAR_LABEL_MAX_P90_DAYS,
                max_spell_days=BEAR_LABEL_MAX_SPELL_DAYS
            )
            regimes_cal = np.asarray(base_regimes_cal, dtype=int).copy()
            regimes_cal[bear_cal] = REGIME_BEAR

            bear_full, bear_full_diag = _calibrate_bear_mask_to_share(
                spy_returns=spy_returns,
                vix_series=vix_series,
                recession_proxy=recession_proxy,
                target_share=BEAR_LABEL_TARGET_SHARE,
                max_share=BEAR_LABEL_MAX_SHARE,
                target_median_days=BEAR_LABEL_TARGET_MEDIAN_DAYS,
                max_median_days=BEAR_LABEL_MAX_MEDIAN_DAYS,
                target_p90_days=BEAR_LABEL_TARGET_P90_DAYS,
                max_p90_days=BEAR_LABEL_MAX_P90_DAYS,
                max_spell_days=BEAR_LABEL_MAX_SPELL_DAYS
            )
            regimes = np.asarray(base_regimes_full, dtype=int).copy()
            regimes[bear_full] = REGIME_BEAR
            regimes[post_mask] = regimes_cal
            p_bear = bear_full.astype(float)
            p_bear[post_mask] = bear_cal.astype(float)
            bear_label_diag = {
                'topology': bear_cal_diag,
                'full_sample': bear_full_diag
            }
        else:
            regimes = np.asarray(base_regimes_full, dtype=int)
            regimes_cal = np.asarray(base_regimes_cal, dtype=int)

        # Topology (TM, Weibull) comes from reliable post-1990 labels only.
        regimes_for_topology = np.asarray(regimes_cal, dtype=int)
        df_for_topology = df_cal
    else:
        calibrated_params = calibrate_stress_logit_parameters(
            vix_series=vix_series, realized_vol=realized_vol.values, term_spread=term_spread,
            vix_stress_threshold=HIGH_VOL_STRESS_LABEL_VIX_THRESHOLD
        )
        STRESS_LOGIT_PARAMS = dict(calibrated_params)
        cal_logit_shift = float(calibrated_params.get('intercept', DEFAULT_STRESS_LOGIT_PARAMS['intercept']) -
                                DEFAULT_STRESS_LOGIT_PARAMS['intercept'])
        HIGH_VOL_LOGIT_SHIFT = cal_logit_shift
        print(f"  (Calibrated stress-logit params: intercept={calibrated_params['intercept']:+.3f}, "
              f"vix={calibrated_params['beta_vix']:.3f}, rv={calibrated_params['beta_rv']:.3f}, "
              f"curve={calibrated_params['beta_ts']:.3f})")
        print(f"  (Calibrated high-vol logit shift vs default: {cal_logit_shift:+.3f})")
        _rv_ref = float(np.nanmedian(realized_vol.values)) if len(realized_vol) > 0 else 0.18
        _ts_ref = float(np.nanmedian(term_spread)) if term_spread is not None and len(term_spread) > 0 else 0.0
        _vix_p50 = estimate_effective_vix_p50(calibrated_params, _rv_ref, _ts_ref)
        if np.isfinite(_vix_p50):
            print(f"  (Effective p=0.5 VIX crossing at median conditions: {_vix_p50:.1f})")
        base_regimes = infer_regime_from_vix(
            vix_series=vix_series, realized_vol=realized_vol.values, term_spread=term_spread,
            logit_shift=0.0, logit_params=calibrated_params
        )
        p_high_vol = compute_high_vol_probability(
            vix_series=vix_series, realized_vol=realized_vol.values, term_spread=term_spread,
            logit_shift=0.0, logit_params=calibrated_params
        )
        if N_REGIMES >= 3:
            bear_mask, bear_mask_diag = _calibrate_bear_mask_to_share(
                spy_returns=spy_returns,
                vix_series=vix_series,
                recession_proxy=recession_proxy,
                target_share=BEAR_LABEL_TARGET_SHARE,
                max_share=BEAR_LABEL_MAX_SHARE,
                target_median_days=BEAR_LABEL_TARGET_MEDIAN_DAYS,
                max_median_days=BEAR_LABEL_MAX_MEDIAN_DAYS,
                target_p90_days=BEAR_LABEL_TARGET_P90_DAYS,
                max_p90_days=BEAR_LABEL_MAX_P90_DAYS,
                max_spell_days=BEAR_LABEL_MAX_SPELL_DAYS
            )
            regimes = np.asarray(base_regimes, dtype=int).copy()
            regimes[bear_mask] = REGIME_BEAR
            p_bear = bear_mask.astype(float)
            bear_label_diag = dict(bear_mask_diag)
        else:
            regimes = np.asarray(base_regimes, dtype=int)
        regimes_for_topology = np.asarray(regimes, dtype=int)
        df_for_topology = df

    stress_share = _stress_share(regimes_for_topology)
    bear_share = float(np.mean(np.asarray(regimes_for_topology, dtype=int) == REGIME_BEAR)) if N_REGIMES >= 3 else 0.0
    print(f"\n  Regime assignment: probabilistic stress score + hysteresis")
    print(f"  Stress occupancy (shock + bear): {stress_share*100:.2f}%")
    if N_REGIMES >= 3:
        print(f"  Bear-market occupancy (topology sample): {bear_share*100:.2f}%")
        if isinstance(bear_label_diag, dict) and len(bear_label_diag) > 0:
            if 'topology' in bear_label_diag:
                _bdiag = bear_label_diag.get('topology', {})
                _tag = "post-1990 topology"
            else:
                _bdiag = bear_label_diag
                _tag = "sample"
            if isinstance(_bdiag, dict) and len(_bdiag) > 0:
                _share = float(_bdiag.get('share', np.nan))
                _med = float(_bdiag.get('median_days', np.nan))
                _p90 = float(_bdiag.get('p90_days', np.nan))
                _max = float(_bdiag.get('max_days', np.nan))
                print(f"  Bear-label calibration ({_tag}): "
                      f"enter={_bdiag.get('enter_drawdown', np.nan):.2f}, "
                      f"exit={_bdiag.get('exit_drawdown', np.nan):.2f}, "
                      f"min={int(_bdiag.get('min_spell', 0))}d, "
                      f"join={int(_bdiag.get('max_join_gap', 0))}d, "
                      f"share={_share*100:.2f}%, "
                      f"med={_med:.0f}d, "
                      f"p90={_p90:.0f}d, "
                      f"max={_max:.0f}d")

    regime_params = {}
    for regime_id in range(N_REGIMES):
        mask = regimes == regime_id
        regime_returns = df['SPY_Ret'].values[mask]
        daily_mean = regime_returns.mean() if mask.sum() > 0 else 0.0
        daily_std = regime_returns.std() if mask.sum() > 0 else 0.01
        regime_params[regime_id] = {
            'daily_mean': daily_mean,
            'daily_std': daily_std,
            'annual_mean': daily_mean * 252,
            'annual_vol': daily_std * np.sqrt(252),
            'frequency': mask.sum() / len(regimes),
            'avg_vix': float(np.nanmean(vix_series[mask])) if mask.sum() > 0 else 20.0
        }

    duration_samples = {i: [] for i in range(N_REGIMES)}
    if len(regimes_for_topology) > 0:
        run_regime = int(regimes_for_topology[0])
        run_length = 1
        for r in regimes_for_topology[1:]:
            r = int(r)
            if r == run_regime:
                run_length += 1
            else:
                duration_samples[run_regime].append(run_length)
                run_regime = r
                run_length = 1
        duration_samples[run_regime].append(run_length)

    # Estimate transition matrix from observed transitions, with duration-based
    # fallback/floor to avoid near-absorbing rows when transitions are sparse.
    transitions = np.zeros((N_REGIMES, N_REGIMES))
    for i in range(len(regimes_for_topology) - 1):
        transitions[int(regimes_for_topology[i]), int(regimes_for_topology[i + 1])] += 1

    row_sums = transitions.sum(axis=1, keepdims=True)
    row_sums[row_sums == 0] = 1.0
    transition_matrix = transitions / row_sums

    # Duration-regularised transition rows for all regime counts.
    default_offdiag_weights = {
        REGIME_LOW: {REGIME_HIGH_VOL: 0.65, REGIME_BEAR: 0.35},
        REGIME_HIGH_VOL: {REGIME_LOW: 0.55, REGIME_BEAR: 0.45},
        REGIME_BEAR: {REGIME_LOW: 0.70, REGIME_HIGH_VOL: 0.30}
    }
    for i in range(N_REGIMES):
        offdiag_idx = [j for j in range(N_REGIMES) if j != i]
        if not offdiag_idx:
            transition_matrix[i, i] = 1.0
            continue

        smp = duration_samples.get(i, [])
        mean_spell = float(np.mean(smp)) if len(smp) > 0 else float(max(1, MIN_REGIME_DURATION.get(i, 10)))
        max_exit = 0.25 if i == REGIME_LOW else (0.55 if i == REGIME_HIGH_VOL else 0.40)
        min_exit = float(REGIME_MIN_EXIT_PROB.get(i, 1e-4))
        p_exit_spell = float(np.clip(1.0 / max(mean_spell, 1.0), min_exit, max_exit))

        n_off = float(np.sum(transitions[i, offdiag_idx]))
        p_exit_obs = float(np.sum(transition_matrix[i, offdiag_idx]))
        if n_off < 3 or p_exit_obs < 1e-4:
            p_exit = p_exit_spell
        else:
            p_exit = 0.65 * p_exit_obs + 0.35 * p_exit_spell
        p_exit = float(np.clip(p_exit, min_exit, max_exit))

        off_weights = transition_matrix[i, offdiag_idx].astype(float)
        if np.sum(off_weights) <= 1e-12:
            seed_map = default_offdiag_weights.get(i, {})
            off_weights = np.array([float(seed_map.get(j, 1.0)) for j in offdiag_idx], dtype=float)
        off_weights = np.clip(off_weights, 0.0, None)
        if np.sum(off_weights) <= 1e-12:
            off_weights = np.ones(len(offdiag_idx), dtype=float)
        off_weights = off_weights / np.sum(off_weights)

        transition_matrix[i, :] = 0.0
        transition_matrix[i, i] = 1.0 - p_exit
        for k, j in enumerate(offdiag_idx):
            transition_matrix[i, j] = p_exit * off_weights[k]

    # Hard guard against numerical corruption.
    transition_matrix = np.nan_to_num(transition_matrix, nan=0.0, posinf=0.0, neginf=0.0)
    for i in range(N_REGIMES):
        rs = transition_matrix[i].sum()
        if rs <= 0:
            transition_matrix[i, i] = 1.0
        else:
            transition_matrix[i] = transition_matrix[i] / rs

    for i in range(N_REGIMES):
        persistence = transition_matrix[i, i]
        regime_params[i]['avg_duration_days'] = 1.0 / (1.0 - persistence) if persistence < 1.0 else np.inf

    for i in range(N_REGIMES):
        samples = duration_samples[i] if len(duration_samples[i]) > 0 else [int(max(1, MIN_REGIME_DURATION[i]))]
        regime_params[i]['duration_median_days'] = float(np.median(samples))
        regime_params[i]['duration_p90_days'] = float(np.percentile(samples, 90))
        mask_top = regimes_for_topology == i
        regime_params[i]['frequency_topology'] = float(np.mean(mask_top)) if len(regimes_for_topology) > 0 else float('nan')

    eigenvalues, eigenvectors = np.linalg.eig(transition_matrix.T)
    idx = np.argmin(np.abs(eigenvalues - 1.0))
    steady_state = np.real(eigenvectors[:, idx])
    steady_state = np.abs(steady_state)
    steady_state = steady_state / max(steady_state.sum(), 1e-12)

    bear_episodes = _extract_boolean_episodes(np.asarray(regimes_for_topology, dtype=int) == REGIME_BEAR) if N_REGIMES >= 3 else []
    bear_lengths = np.array([e - s + 1 for s, e in bear_episodes], dtype=float) if bear_episodes else np.array([])
    bear_episode_rows = []
    if N_REGIMES >= 3 and len(bear_episodes) > 0 and len(df_for_topology) == len(regimes_for_topology):
        for _s, _e in bear_episodes:
            _start = df_for_topology.index[int(_s)]
            _end = df_for_topology.index[int(_e)]
            bear_episode_rows.append({
                'start': str(pd.Timestamp(_start).date()),
                'end': str(pd.Timestamp(_end).date()),
                'days': int(_e - _s + 1)
            })
    bear_episode_stats = {
        'count': int(len(bear_episodes)),
        'median_days': float(np.median(bear_lengths)) if len(bear_lengths) > 0 else float('nan'),
        'p90_days': float(np.percentile(bear_lengths, 90)) if len(bear_lengths) > 0 else float('nan'),
        'max_days': float(np.max(bear_lengths)) if len(bear_lengths) > 0 else float('nan')
    }

    print(f"\n✓ Volatility Regime Model Calibrated:")
    print(f"{'='*80}")
    for i in range(N_REGIMES):
        params = regime_params[i]
        print(f"{REGIME_NAMES[i]:10s}:")
        print(f"  Annual Return: {params['annual_mean']*100:+6.2f}% (drift is constant!)")
        print(f"  Annual Vol:    {params['annual_vol']*100:5.2f}%")
        print(f"  Avg VIX:       {params['avg_vix']:.2f}")
        topo_freq = params.get('frequency_topology', np.nan)
        topo_str = f"{topo_freq*100:.2f}%" if np.isfinite(topo_freq) else "n/a"
        print(f"  Frequency:     {params['frequency']*100:5.2f}% (steady: {steady_state[i]*100:.2f}%, topo sample: {topo_str})")
        print(f"  Avg Duration:  {params['avg_duration_days']:.0f} days")
        print(f"  Spell Length:  med={params['duration_median_days']:.0f}d p90={params['duration_p90_days']:.0f}d")

    if N_REGIMES >= 3:
        print("\n  Bear episodes (topology sample, equity-drawdown based):")
        print(f"    Count: {bear_episode_stats['count']}")
        if np.isfinite(bear_episode_stats['median_days']):
            print(f"    Duration: med={bear_episode_stats['median_days']:.0f}d  "
                  f"p90={bear_episode_stats['p90_days']:.0f}d  max={bear_episode_stats['max_days']:.0f}d")

    print(f"\nTransition Matrix:")
    print("        " + "  ".join(f"{REGIME_NAMES[j]:>8s}" for j in range(N_REGIMES)))
    for i in range(N_REGIMES):
        row_str = f"{REGIME_NAMES[i]:10s}"
        for j in range(N_REGIMES):
            row_str += f"  {transition_matrix[i,j]:5.3f}"
        print(row_str)

    expected_return = sum(steady_state[i] * regime_params[i]['annual_mean'] for i in range(N_REGIMES))
    print(f"\n  Expected SPY Return: {expected_return*100:.2f}%")
    print(f"  (Note: Similar across regimes - only vol changes!)")

    vix_dynamics = calibrate_vix_dynamics(df_for_topology, regimes_for_topology)
    result = {
        'schema_version': REGIME_MODEL_SCHEMA_VERSION,
        'logit_shift': float(HIGH_VOL_LOGIT_SHIFT),
        'stress_logit_params': dict(STRESS_LOGIT_PARAMS),
        'regime_params': regime_params,
        'transition_matrix': transition_matrix,
        'steady_state': steady_state,
        'expected_return': expected_return,
        'regimes_historical': regimes,
        'duration_samples': duration_samples,
        'regime_probability_high': p_high_vol,
        'regime_probability_bear': p_bear,
        'bear_label_calibration': bear_label_diag,
        'bear_episode_stats': bear_episode_stats,
        'bear_episodes_topology': bear_episode_rows,
        'stress_frequency_topology': stress_share,
        'regime_parameters_are_rolling': False,
        'vix_dynamics': vix_dynamics
    }

    save_cache(result, REGIME_MODEL_CACHE)
    return result

