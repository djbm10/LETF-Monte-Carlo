# PARALLEL MONTE CARLO
# ============================================================================

def parallel_monte_carlo_fixed(strategy_ids, time_horizon, regime_model, correlation_matrices,
                               historical_df: pd.DataFrame = None,
                               historical_anchor_df: Optional[pd.DataFrame] = None,
                               seed_offset: int = 0):
    """
    Parallel Monte Carlo with all fixes.
    
    UPGRADE: Now supports block bootstrap from historical data for fat-tailed returns.
    
    Args:
        strategy_ids: List of strategy IDs to simulate
        time_horizon: Simulation horizon in years
        regime_model: Calibrated regime model
        correlation_matrices: Calibrated correlation matrices
        historical_df: Optional historical data for block bootstrap
        historical_anchor_df: Optional anchor source when
            RANDOM_START_METHOD='historical_anchor'
    """
    print(f"\n{'='*80}")
    print(f"MONTE CARLO: {NUM_SIMULATIONS:,} sims × {time_horizon}Y")
    print(f"{'='*80}")

    regime_model = regime_model.copy()  # local mutable copy for worker payload enrichments
    sim_cfg = get_simulation_config()
    if historical_df is not None:
        # Provide raw historical panel for direct historical-scenario replay mode.
        _cols = [c for c in ['SPY_Ret', 'QQQ_Ret', 'TLT_Ret', 'VIX', 'IRX', 'TNX', 'USREC'] if c in historical_df.columns]
        if len(_cols) > 0:
            regime_model['historical_df_for_returns'] = historical_df[_cols].copy()

    # Pass historical return arrays to workers for historical_backtest mode (Pipeline D).
    # Arrays are stored in regime_model so they survive the ProcessPoolExecutor pickle/IPC
    # boundary on all platforms.
    if MARKET_SCENARIO == 'historical_backtest':
        # ── Pipeline D: HISTORICAL BACKTEST ──────────────────────────────────
        # Slice _HIST1926_* arrays to the user-selected analysis window.
        # The sliced arrays are stored in hist1926_data so the _hist1926 code
        # path handles driver replay — no new branching in simulate_single_path_fixed.
        window_data = _slice_hist1926_to_window(ANALYSIS_START_DATE, ANALYSIS_END_DATE, min_days=2)
        if window_data is not None:
            # ── NASDAQ proxy quality guard ────────────────────────────────────
            # Raise RuntimeError if window is pre-NASDAQ era and only the SPY×1.25
            # beta proxy is available — it produces misleading QQQ reconstruction.
            if _HIST1926_NASDAQ_SOURCE == 'beta_proxy':
                _wstart_ts = pd.Timestamp(window_data.get('dates_start', ANALYSIS_START_DATE))
                _nasdaq_inception = pd.Timestamp('1971-02-05')  # first ^IXIC trading day
                if _wstart_ts < _nasdaq_inception:
                    raise RuntimeError(
                        f"No NASDAQ proxy data available for pre-NASDAQ backtest "
                        f"(window starts {_wstart_ts.date()}, NASDAQ since {_nasdaq_inception.date()}). "
                        "Cannot produce valid QQQ reconstruction. "
                        "Install pandas_datareader and retry (FF HiTec industry portfolio "
                        "will be used as Tier-2 proxy)."
                    )

            # Store a reference copy for the driver immutability test (pre-simulation)
            regime_model['hist1926_data'] = window_data
            regime_model['_reconstruction_window_data_original'] = {
                k: v.copy() if isinstance(v, np.ndarray) else v
                for k, v in window_data.items()
            }
            regime_model['n_simulations_hint'] = int(NUM_SIMULATIONS)
            n_wd = window_data['N']
            print(f"\n  *** Pipeline D: HISTORICAL BACKTEST ***")
            print(f"  Window  : {window_data['dates_start']} → {window_data['dates_end']} "
                  f"({n_wd:,} days, {n_wd/252:.1f} yr)")
            print(f"  Source  : real Fama-French + yfinance total returns")
            print(f"  QQQ source: {_HIST1926_NASDAQ_SOURCE}")
            print(f"  GARCH   : DISABLED   Synthetic jumps: DISABLED   Vol overlay: DISABLED")
            print(f"  Circuit breakers: DISABLED  Tail-event overlay: DISABLED")
            print(f"  TE residuals: deterministic replay (v1.3)  Regime: rolling-vol (v1.3)")
            print(f"  Fund emulation layer (financing, TE): ENABLED (calibrated)")
            spy_cagr_drv = float((np.prod(1.0 + window_data['SPY_Ret']) ** (252.0 / n_wd)) - 1.0)
            print(f"  Driver SPY CAGR (window): {spy_cagr_drv*100:.2f}%")
        else:
            raise RuntimeError(
                f"Could not slice historical_backtest window "
                f"[{ANALYSIS_START_DATE}, {ANALYSIS_END_DATE}] into at least 2 trading days. "
                "Choose a valid date range within the loaded history."
            )

    # ========================================================================
    # RETURN GENERATION PIPELINE SELECTION
    # ========================================================================
    # Three mutually exclusive pipelines; only Pipeline C creates a bootstrap sampler.
    #
    #   Pipeline C  all stochastic scenarios   → institutional GARCH + Student-t
    #   Pipeline D  historical_backtest        → real returns for chosen window (deterministic)
    #   Pipeline E  historical_bootstrap       → block bootstrap from selected window
    #
    # Pipelines D and E must NOT receive a bootstrap sampler in regime_model.
    if MARKET_SCENARIO == 'historical_backtest':
        pass   # already printed above in the data-prep block
    elif MARKET_SCENARIO == 'historical_bootstrap':
        # ── Pipeline E: HISTORICAL BLOCK BOOTSTRAP ────────────────────────────
        # Slice to the user-selected analysis window FIRST, then bootstrap
        # contiguous blocks from that sliced window only.
        if _HIST1926_N > 0:
            _bootstrap_block_size = int(
                _SCENARIO_PRESETS['historical_bootstrap'].get('_hist1926_block_size', 63)
            )
            _bootstrap_seed = _SCENARIO_PRESETS['historical_bootstrap'].get('bootstrap_seed', None)
            _bootstrap_method = str(_SCENARIO_PRESETS['historical_bootstrap'].get('bootstrap_method', 'fixed')).strip().lower()
            _stationary_p = _SCENARIO_PRESETS['historical_bootstrap'].get('stationary_p', None)
            _window_data = _slice_hist1926_to_window(
                ANALYSIS_START_DATE,
                ANALYSIS_END_DATE,
                min_days=2
            )
            if _window_data is None:
                raise RuntimeError(
                    f"historical_bootstrap requires a valid selected window, but "
                    f"[{ANALYSIS_START_DATE}, {ANALYSIS_END_DATE}] could not be sliced."
                )
            regime_model['hist1926_data'] = _window_data
            regime_model['n_simulations_hint'] = int(NUM_SIMULATIONS)
            _bbs_n = int(_window_data['N'])
            _bbs_yrs  = float(_bbs_n / 252)
