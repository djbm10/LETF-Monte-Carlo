def select_random_start_regime(rng: np.random.Generator = None) -> int:
    """
    Randomly select a starting regime based on configured probabilities.
    
    This prevents overfitting to strategies that only work when starting
    in a specific market environment (e.g., always starting in low vol).
    
    Args:
        rng: Random number generator (for reproducibility)
    
    Returns:
        Regime ID (0 = low vol, 1 = high-vol shock, 2 = bear market)
    """
    if rng is None:
        rng = np.random.default_rng()
    
    # Extract regimes and probabilities
    regimes = list(START_REGIME_PROBABILITIES.keys())
    probs = [START_REGIME_PROBABILITIES[r] for r in regimes]
    
    # Normalize probabilities (in case they don't sum to 1)
    probs = np.array(probs) / sum(probs)
    
    return rng.choice(regimes, p=probs)


def select_random_start_offset(buffer_days: int, rng: np.random.Generator = None) -> int:
    """
    Select a random starting offset within a generated buffer.
    
    We generate extra history (buffer_days), then pick a random point
    to start the actual simulation. This tests robustness to different
    entry points in the market cycle.
    
    Args:
        buffer_days: Number of buffer days generated
        rng: Random number generator
    
    Returns:
        Day index to start simulation (0 to buffer_days-1)
    """
    if rng is None:
        rng = np.random.default_rng()
    
    if buffer_days <= 0:
        return 0
    
    # Don't start in the very first few days (need some history for indicators)
    min_offset = min(50, buffer_days // 4)  # At least 50 days or 25% of buffer
    
    return rng.integers(min_offset, buffer_days)


def get_historical_anchor_conditions(historical_df: pd.DataFrame, 
                                     min_history_years: float = 2.0,
                                     rng: np.random.Generator = None) -> Dict:
    """
    Sample starting conditions from actual historical data.
    
    This anchors simulations to real market conditions that actually occurred,
    providing the most realistic test of strategy robustness.
    
    Args:
        historical_df: DataFrame with historical market data
        min_history_years: Minimum years of history before sampling
        rng: Random number generator
    
    Returns:
        Dict with starting conditions:
        - 'regime': Starting regime (inferred from VIX)
        - 'vix': Starting VIX level
        - 'cape': Starting CAPE valuation level (if available)
        - 'spy_ret_20d': Recent 20-day SPY return (for momentum context)
        - 'vol_20d': Recent 20-day volatility
        - 'date': Date of the anchor point (for reference)
    """
    if rng is None:
        rng = np.random.default_rng()
    
    # Calculate minimum days of history needed
    min_days = int(min_history_years * 252)
    
    # Valid anchor points (exclude first min_days and last year for forward sim)
    n_days = len(historical_df)
    valid_start = min_days
    valid_end = n_days - 252  # Leave at least 1 year for forward simulation
    
    if valid_end <= valid_start:
        # Not enough data - return default conditions
        return {
            'regime': 0,
            'vix': 18,
            'cape': float(STRUCTURAL_CAPE_FALLBACK_LEVEL),
            'spy_ret_20d': 0.02,
            'vol_20d': 0.15,
            'date': None
        }
    
    # Select random anchor point
    anchor_idx = rng.integers(valid_start, valid_end)
    
    # Extract conditions at anchor point
    anchor_row = historical_df.iloc[anchor_idx]
    
    # Infer regime from VIX + local drawdown context
    vix = anchor_row.get('VIX', 20)
    recent_window = historical_df['SPY_Ret'].iloc[max(0, anchor_idx-252):anchor_idx+1].fillna(0.0).to_numpy(dtype=float)
    dd_anchor = _drawdown_from_returns(recent_window)[-1] if len(recent_window) > 0 else 0.0
    if dd_anchor <= -0.15 or (vix >= 23 and dd_anchor <= -0.10):
        regime = REGIME_BEAR
    elif vix >= 28:
        regime = REGIME_HIGH_VOL
    else:
        regime = REGIME_LOW
    
    # Get recent market context
    lookback = min(20, anchor_idx)
    recent_returns = historical_df['SPY_Ret'].iloc[anchor_idx-lookback:anchor_idx]
    
    spy_ret_20d = recent_returns.sum() if len(recent_returns) > 0 else 0
    vol_20d = recent_returns.std() * np.sqrt(252) if len(recent_returns) > 0 else 0.15
    cape_anchor = float(anchor_row.get('CAPE', np.nan)) if 'CAPE' in historical_df.columns else float('nan')
    
    # Get date for reference
    anchor_date = historical_df.index[anchor_idx] if hasattr(historical_df.index[anchor_idx], 'strftime') else None
    
    return {
        'regime': regime,
        'vix': vix,
        'cape': cape_anchor,
        'spy_ret_20d': spy_ret_20d,
        'vol_20d': vol_20d,
        'date': anchor_date
    }


def apply_random_start_conditions(sim_id: int, sim_days: int, 
                                  regime_model: Dict,
                                  historical_df: pd.DataFrame = None) -> Dict:
    """
    Apply randomized starting conditions for a simulation.
    
    This is the main function called by simulate_single_path_fixed()
    to set up randomized initial conditions.
    
    Args:
        sim_id: Simulation ID (for reproducible randomization)
        sim_days: Number of simulation days
        regime_model: Regime parameters
        historical_df: Optional historical data for anchor points
    
    Returns:
        Dict with:
        - 'start_regime': Initial regime
        - 'initial_vix': Starting VIX level
        - 'cape': Starting CAPE level (if available from historical anchors)
        - 'buffer_days': Extra days to generate (for offset method)
        - 'start_offset': Day to start actual simulation
        - 'start_method': Which method was used
        - 'anchor_date': Historical anchor date (if applicable)
    """
    # Create reproducible RNG for this simulation
    rng = np.random.default_rng(sim_id + 99999)
    
    result = {
        'start_regime': 0,  # Default: low vol
        'initial_vix': 15,  # Default VIX
        'cape': None,
        'buffer_days': 0,
        'start_offset': 0,
        'start_method': 'default',
        'anchor_date': None
    }
    
    if not USE_RANDOM_START:
        return result
    
    # Apply randomization based on configured method
    if RANDOM_START_METHOD == 'regime_only':
        # Simple: just randomize starting regime
        result['start_regime'] = select_random_start_regime(rng)
        result['start_method'] = 'regime_only'
        
    elif RANDOM_START_METHOD == 'offset':
        # Generate extra buffer, start at random point
        buffer_days = int(RANDOM_START_BUFFER_YEARS * 252)
        start_offset = select_random_start_offset(buffer_days, rng)
        
        result['buffer_days'] = buffer_days
        result['start_offset'] = start_offset
        result['start_method'] = 'offset'
        
        # The starting regime will be determined by the regime at start_offset
        # (handled in the main simulation function)
        
    elif RANDOM_START_METHOD == 'historical_anchor':
        # Anchor to actual historical conditions
        if historical_df is not None and len(historical_df) > 252 * MIN_HISTORY_FOR_ANCHOR:
            anchor = get_historical_anchor_conditions(historical_df, MIN_HISTORY_FOR_ANCHOR, rng)
            
            result['start_regime'] = anchor['regime']
            result['initial_vix'] = anchor['vix']
            result['cape'] = anchor.get('cape', None)
            result['anchor_date'] = anchor['date']
            result['start_method'] = 'historical_anchor'
        else:
            # Fallback to regime_only if no historical data
            result['start_regime'] = select_random_start_regime(rng)
            result['start_method'] = 'regime_only_fallback'
    
    # Randomize initial VIX if enabled
    if RANDOMIZE_INITIAL_VIX and result['start_method'] != 'historical_anchor':
        regime = result['start_regime']
        vix_low, vix_high = INITIAL_VIX_RANGE[regime]
        result['initial_vix'] = rng.uniform(vix_low, vix_high)
    
    return result



def simulate_regime_path_semi_markov(total_days: int,
                                     start_regime: int,
                                     transition_matrix: np.ndarray,
                                     duration_samples: Optional[Dict[int, List[int]]],
                                     rng: np.random.Generator,
                                     calm_scale_factor: float = 1.0,
                                     crisis_scale_factor: float = 1.0) -> np.ndarray:
    """Generate a semi-Markov discrete regime path with Weibull-fitted dwell-time draws.

    Duration model: fits a Weibull_min distribution to each regime's observed dwell times
    (requires ≥ 6 samples).  Weibull allows smooth extrapolation beyond the longest
    observed spell, which is important for realistic crisis clustering in regime 1 where
    observed spells are few and short.  Falls back to bootstrap if fit fails.

    Transition: at spell end, next regime is drawn from the OFF-diagonal mass of the
    transition matrix row, so self-transitions never occur mid-path (true semi-Markov).

    calm_scale_factor: scenario stress knob for stress-entry frequency.
        Scales the Weibull λ (scale parameter) of the calm state (regime 0):
            λ_scaled = λ_calm / calm_scale_factor
        Smaller λ → shorter calm spells → more frequent crisis entry.
        calm_scale_factor > 1  (pessimistic) → more crises
        calm_scale_factor < 1  (optimistic)  → fewer crises
        calm_scale_factor = 1  (neutral)     → calibrated baseline
        Stress frequency is controlled primarily through dwell-time distributions.

    crisis_scale_factor: scenario stress knob for stress duration (independent of frequency).
        Applied to stress states with stronger effect on bear-market dwell times:
            shock λ_scaled = λ_shock × sqrt(crisis_scale_factor)
            bear  λ_scaled = λ_bear  × crisis_scale_factor
        crisis_scale_factor > 1  (pessimistic) → longer stress, especially bears.
        crisis_scale_factor < 1  (optimistic)  → shorter stress episodes.
    """
    if total_days <= 0:
        return np.zeros(0, dtype=int)

    tm = np.asarray(transition_matrix, dtype=float).copy()
    tm = np.nan_to_num(tm, nan=0.0, posinf=0.0, neginf=0.0)
    tm[tm < 0] = 0.0
    for i in range(tm.shape[0]):
        rs = tm[i].sum()
        if rs <= 0:
            tm[i, i] = 1.0
        else:
            tm[i] = tm[i] / rs

    # Pre-fit Weibull_min distribution to each regime's observed dwell times.
    # floc=0.5 ensures minimum generated duration rounds to ≥ 1 day.
    # This is done once per call (O(n_regimes × n_samples), very cheap).
    weibull_params: dict = {}
    if duration_samples:
        for k, samps in duration_samples.items():
            if len(samps) >= 6:
                try:
                    arr = np.array(samps, dtype=float)
                    shape, loc, scale = stats.weibull_min.fit(arr, floc=0.5)
                    if (np.isfinite(shape) and shape > 0.1 and
                            np.isfinite(scale) and scale > 0):
                        weibull_params[k] = (shape, loc, scale)
                except Exception:
                    pass  # fall back to bootstrap for this regime

    # Apply calm_scale_factor to the calm-state (regime 0) Weibull scale parameter.
    # λ_scaled = λ_calm / calm_scale_factor.  Shape and loc are preserved so the
    # hazard function shape is unchanged; only the expected dwell length shifts.
    # Clamp factor to [0.1, 10] to prevent degenerate near-zero or infinite spells.
    _csf = float(np.clip(calm_scale_factor, 0.1, 10.0))
    if _csf != 1.0 and 0 in weibull_params:
        _sh, _lc, _sc = weibull_params[0]
        weibull_params[0] = (_sh, _lc, _sc / _csf)

    # Apply crisis_scale_factor to stress-state Weibull scale parameters.
    # Bear state gets full multiplier; high-vol shock gets sqrt(multiplier) so
    # spike duration increases less aggressively than structural bear duration.
    _crsf = float(np.clip(crisis_scale_factor, 0.1, 10.0))
    _crsf_shock = float(np.sqrt(_crsf))
    if _crsf != 1.0 and REGIME_HIGH_VOL in weibull_params:
        _sh, _lc, _sc = weibull_params[REGIME_HIGH_VOL]
        weibull_params[REGIME_HIGH_VOL] = (_sh, _lc, _sc * _crsf_shock)
    if _crsf != 1.0 and REGIME_BEAR in weibull_params:
        _sh, _lc, _sc = weibull_params[REGIME_BEAR]
        weibull_params[REGIME_BEAR] = (_sh, _lc, _sc * _crsf)

    regime_path_full = np.zeros(total_days, dtype=int)
    current_regime = int(start_regime)
    t = 0

    while t < total_days:
        # Sample dwell time: Weibull if fitted, else bootstrap, else geometric.
        # Use numpy rng.weibull() directly to avoid consuming extra integers from
        # the shared RNG stream (scipy.stats.weibull_min.rvs would require a seed
        # integer per call, perturbing all subsequent GARCH draws).
        # Weibull_min(shape, loc, scale): X = scale * W + loc, W ~ Weibull(shape).
        # Minimum spell length per regime (trading days).
        if current_regime == REGIME_HIGH_VOL:
            _min_spell = max(3, int(MIN_REGIME_DURATION.get(REGIME_HIGH_VOL, 5)))
        elif current_regime == REGIME_BEAR:
            _min_spell = max(20, int(MIN_REGIME_DURATION.get(REGIME_BEAR, 45)))
        else:
            _min_spell = 1

        if current_regime in weibull_params:
            shape, loc, scale = weibull_params[current_regime]
            raw_spell = scale * float(rng.weibull(shape)) + loc
            spell = max(_min_spell, int(round(raw_spell)))
        elif (duration_samples and current_regime in duration_samples
              and len(duration_samples[current_regime]) > 0):
            # Bootstrap fallback: apply dwell-time scaling to drawn spell.
            spell = int(rng.choice(duration_samples[current_regime]))
            if current_regime == 0 and _csf != 1.0:
                spell = max(_min_spell, int(round(spell / _csf)))   # calm: divide
            elif current_regime == REGIME_HIGH_VOL and _crsf != 1.0:
                spell = max(_min_spell, int(round(spell * _crsf_shock)))
            elif current_regime == REGIME_BEAR and _crsf != 1.0:
                spell = max(_min_spell, int(round(spell * _crsf)))
            else:
                spell = max(_min_spell, spell)
        else:
            # Geometric fallback: scale exit probability to match desired mean spell.
            # Geometric mean ≈ 1/(1−p_stay).  Desired new mean = old_mean / factor
            # → 1−p_new = (1−p_old) × factor  (calm, factor=_csf)
            # → 1−p_new = (1−p_old) / factor  (crisis, factor=_crsf)
            p_stay = np.clip(tm[current_regime, current_regime], 0.80, 0.995)
            if current_regime == 0 and _csf != 1.0:
                p_exit_scaled = np.clip((1.0 - p_stay) * _csf, 0.005, 0.20)
                p_stay = 1.0 - p_exit_scaled
            elif current_regime == REGIME_HIGH_VOL and _crsf != 1.0:
                p_exit_scaled = np.clip((1.0 - p_stay) / _crsf_shock, 0.005, 0.25)
                p_stay = 1.0 - p_exit_scaled
            elif current_regime == REGIME_BEAR and _crsf != 1.0:
                p_exit_scaled = np.clip((1.0 - p_stay) / _crsf, 0.003, 0.20)
                p_stay = 1.0 - p_exit_scaled
            spell = max(_min_spell, int(rng.geometric(1 - p_stay)))

        end_t = min(t + spell, total_days)
        regime_path_full[t:end_t] = current_regime
        t = end_t

        if t < total_days:
            row = tm[current_regime].copy()
            # Semi-Markov: pick next state from OFF-diagonal mass only.
            row[current_regime] = 0.0
            rs = row.sum()
            if rs <= 0:
                next_regime = current_regime
            else:
                row = row / rs
                next_regime = int(rng.choice(np.arange(N_REGIMES), p=row))
            current_regime = next_regime

    return regime_path_full


def draw_regime_path_targeted(total_days: int,
                              start_regime: int,
                              transition_matrix: np.ndarray,
                              duration_samples: Optional[Dict[int, List[int]]],
                              base_seed: int,
                              calm_scale_factor: float = 1.0,
                              crisis_scale_factor: float = 1.0,
                              target_crisis_share: Optional[float] = None,
                              target_tolerance: float = 0.08,
                              max_attempts: int = 10) -> Tuple[np.ndarray, Dict[str, float]]:
    """
    Draw a semi-Markov regime path with soft stress-occupancy targeting.

    If target_crisis_share is provided, sample several candidate paths and keep
    the first within tolerance; otherwise keep the closest candidate.
    """
    attempts = max(1, int(max_attempts))
    tol = float(max(0.01, target_tolerance))
    target = float(target_crisis_share) if target_crisis_share is not None and np.isfinite(target_crisis_share) else float('nan')

    # Baseline draw (always evaluated first).
    rng0 = np.random.default_rng(int(base_seed + 1009))
    path0 = simulate_regime_path_semi_markov(
        total_days=total_days,
        start_regime=start_regime,
        transition_matrix=transition_matrix,
        duration_samples=duration_samples,
        rng=rng0,
        calm_scale_factor=calm_scale_factor,
        crisis_scale_factor=crisis_scale_factor
    )
    share0 = _stress_share(path0) if len(path0) > 0 else 0.0

    if not np.isfinite(target):
        diagnostics = {
            'target_crisis_share': float('nan'),
            'actual_crisis_share': float(share0),
            'actual_bear_share': float(np.mean(np.asarray(path0, dtype=int) == REGIME_BEAR)) if len(path0) > 0 else float('nan'),
            'target_tolerance': float(tol),
            'attempts_used': 1.0,
            'within_tolerance': True,
            'selected_calm_scale': float(calm_scale_factor),
            'selected_crisis_scale': float(crisis_scale_factor)
        }
        return path0, diagnostics

    best_path = path0
    best_share = float(share0)
    best_err = float(abs(share0 - target))
    best_calm_scale = float(calm_scale_factor)
    best_crisis_scale = float(crisis_scale_factor)
    accepted = bool(best_err <= tol)
    attempts_used = 1

    # Build scale candidates around baseline to better hit target stress occupancy.
    ratio = float(np.clip(target / max(share0, 1e-4), 0.30, 10.00))
    scale_pairs: List[Tuple[float, float]] = [(float(calm_scale_factor), float(crisis_scale_factor))]
    if ratio < 1.0:
        crisis_grid = np.clip(
            np.array([ratio, 0.92, 0.84, 0.76, 0.68, 0.60, 0.52], dtype=float),
            0.35, 1.20
        )
        for c_scale in crisis_grid:
            # When crisis dwell is reduced, lengthen calm dwell slightly to
            # control occupancy without breaking spell continuity.
            calm_mult = float(np.clip(1.0 + 0.55 * (1.0 - c_scale), 1.0, 2.4))
            scale_pairs.append((
                float(np.clip(calm_scale_factor * calm_mult, 0.30, 4.50)),
                float(np.clip(crisis_scale_factor * c_scale, 0.20, 10.00))
            ))
    else:
        crisis_grid = np.clip(
            np.array([
                ratio,
                max(1.20, ratio * 0.92),
                max(1.40, ratio * 0.80),
                1.60, 2.20, 3.00, 4.20, 5.80, 7.20, 8.80
            ], dtype=float),
            0.90, 10.00
        )
        for c_scale in crisis_grid:
            calm_mult = float(np.clip(1.0 - 0.40 * (c_scale - 1.0), 0.20, 1.0))
            scale_pairs.append((
                float(np.clip(calm_scale_factor * calm_mult, 0.10, 5.00)),
                float(np.clip(crisis_scale_factor * c_scale, 0.20, 10.00))
            ))

    # De-duplicate while preserving order.
    uniq_pairs: List[Tuple[float, float]] = []
    seen = set()
    for ca, cr in scale_pairs:
        key = (round(float(ca), 4), round(float(cr), 4))
        if key in seen:
            continue
        seen.add(key)
        uniq_pairs.append((float(ca), float(cr)))

    # First pass: one draw per scale candidate.
    for idx, (ca_scale, cr_scale) in enumerate(uniq_pairs[1:], start=1):
        if attempts_used >= attempts or accepted:
            break
        rng_k = np.random.default_rng(int(base_seed + 1009 * (idx + 1)))
        path_k = simulate_regime_path_semi_markov(
            total_days=total_days,
            start_regime=start_regime,
            transition_matrix=transition_matrix,
            duration_samples=duration_samples,
            rng=rng_k,
            calm_scale_factor=ca_scale,
            crisis_scale_factor=cr_scale
        )
        share_k = _stress_share(path_k) if len(path_k) > 0 else 0.0
        err_k = abs(share_k - target)
        attempts_used += 1
        if err_k < best_err:
            best_path = path_k
            best_share = float(share_k)
            best_err = float(err_k)
            best_calm_scale = float(ca_scale)
            best_crisis_scale = float(cr_scale)
        if err_k <= tol:
            accepted = True
            break

    # Second pass: local jitter around best scales if still outside tolerance.
    if (not accepted) and attempts_used < attempts:
        remain = attempts - attempts_used
        for j in range(remain):
            if accepted:
                break
            jitter = 0.04 + 0.03 * j
            if best_share > target:
                gap = min(max(best_share - target, 0.0), 0.75)
                ca_scale = float(np.clip(best_calm_scale * (1.0 + (0.35 + 0.45 * gap) * jitter), 0.10, 5.00))
                cr_scale = float(np.clip(best_crisis_scale * (1.0 - (0.55 + 0.50 * gap) * jitter), 0.20, 10.00))
            else:
                gap = min(max(target - best_share, 0.0), 0.75)
                ca_scale = float(np.clip(best_calm_scale * (1.0 - (0.20 + 0.30 * gap) * jitter), 0.10, 5.00))
                cr_scale = float(np.clip(best_crisis_scale * (1.0 + (0.45 + 0.95 * gap) * jitter), 0.20, 10.00))

            rng_k = np.random.default_rng(int(base_seed + 7001 + 1543 * (j + 1)))
            path_k = simulate_regime_path_semi_markov(
                total_days=total_days,
                start_regime=start_regime,
                transition_matrix=transition_matrix,
                duration_samples=duration_samples,
                rng=rng_k,
                calm_scale_factor=ca_scale,
                crisis_scale_factor=cr_scale
            )
            share_k = _stress_share(path_k) if len(path_k) > 0 else 0.0
            err_k = abs(share_k - target)
            attempts_used += 1
            if err_k < best_err:
                best_path = path_k
                best_share = float(share_k)
                best_err = float(err_k)
                best_calm_scale = float(ca_scale)
                best_crisis_scale = float(cr_scale)
            if err_k <= tol:
                accepted = True
                break

    diagnostics = {
        'target_crisis_share': float(target),
        'actual_crisis_share': float(best_share) if np.isfinite(best_share) else float('nan'),
        'actual_bear_share': float(np.mean(np.asarray(best_path, dtype=int) == REGIME_BEAR)) if best_path is not None and len(best_path) > 0 else float('nan'),
        'target_tolerance': float(tol),
        'attempts_used': float(attempts_used),
        'within_tolerance': bool(abs(best_share - target) <= tol),
        'selected_calm_scale': float(best_calm_scale),
        'selected_crisis_scale': float(best_crisis_scale)
    }
    return best_path, diagnostics


def map_underlying_series_for_asset(asset: str,
                                    beta: float,
                                    spy_returns: np.ndarray,
                                    qqq_returns: np.ndarray,
                                    tlt_returns: np.ndarray) -> np.ndarray:
    """Layer A: choose underlying index stream (no ETF frictions applied here)."""
    if asset in ['TQQQ', 'QQQ', 'QLD']:
        # beta_to_spy is for portfolio risk attribution only, not return scaling.
        # QQQ is already the correct underlying — multiplying by beta would inflate
        # TQQQ to ~3.9× QQQ and QLD to ~2.4× QQQ instead of 3× and 2×.
        return qqq_returns
    if asset in ['UPRO', 'SSO', 'SPY']:
        return spy_returns * beta
    if asset == 'TMF':
        return tlt_returns
    return spy_returns


def compute_daily_financing_series(leverage: float,
                                   risk_free_annual: np.ndarray,
                                   vix: np.ndarray,
                                   funding_model: Optional[Dict[str, float]],
                                   fallback_spread: float,
                                   stress_state: Optional[Dict[str, np.ndarray]],
                                   borrow_spread_override: Optional[Dict[str, float]] = None,
                                   spread_scale: float = 1.0) -> np.ndarray:
    """Layer C: state-linked financing cost (daily), separated from return dynamics.

    borrow_spread_override: if provided as {'low': X, 'high': Y} (values in percent,
    e.g. 0.85 = 0.85%), clamps the predicted spread series to [X/100, Y/100] decimal.
    Used by pessimistic/optimistic scenarios to stress-test financing drag without
    replacing the full funding model.
    """
    n = len(risk_free_annual)
    if SIM_ENGINE_MODE == 'institutional_v1' and funding_model is not None:
        irx_level = risk_free_annual * 100
        if stress_state is not None and 'credit' in stress_state:
            cred = np.clip(np.asarray(stress_state['credit'], dtype=float), 0.0, 3.0)
            term_spread = 1.25 - 1.1 * cred
        else:
            term_spread = np.where(vix > 30, -0.25, 1.10)
        tnx_level = irx_level + term_spread

        spread_df = pd.DataFrame({
            'VIX': vix,
            'TNX': tnx_level,
            'IRX': irx_level
        })
        spread_series = predict_borrow_spread_series(spread_df, funding_model, stress_state=stress_state)
    else:
        spread_series = np.full(n, fallback_spread)

    # Asset-level drag retune scale (jointly calibrated with tracking residuals).
    spread_series = spread_series * float(np.clip(spread_scale, 0.40, 2.00))
    if funding_model is not None:
        lo = max(0.0, float(funding_model.get('min_spread', 0.0)) * 0.5)
        hi = max(lo + 1e-6, float(funding_model.get('max_spread', 0.08)) * 1.5)
        spread_series = np.clip(spread_series, lo, hi)

    # Scenario override: clamp spread to [low, high] range (values are in %, convert to decimal).
    if borrow_spread_override is not None:
        _lo = float(borrow_spread_override.get('low',  0.0)) / 100.0
        _hi = float(borrow_spread_override.get('high', 10.0)) / 100.0
        spread_series = np.clip(spread_series, _lo, _hi)

    return np.array([
        calculate_daily_borrow_cost(leverage, risk_free_annual[t], spread_series[t])
        for t in range(n)
    ])




def _stable_asset_seed(sim_id: int, asset: str) -> int:
    """Collision-resistant deterministic seed for per-asset tracking error streams.

    Uses a polynomial rolling hash (base-31) so that anagrams and same-length tickers
    with permuted characters (e.g. QQQ and SSO) get distinct seeds.  The positional-
    weighted sum used previously mapped both QQQ and SSO to h=486, causing identical
    tracking-error RNG streams.
    """
    h = 0
    for ch in asset:
        h = (h * 31 + ord(ch)) & 0x7FFFFFFF
    return int(sim_id + 7919 * (h + 1)) & 0x7FFFFFFF


def _sum_log_returns_safe(returns: np.ndarray,
                          lower_clip: float = ECONOMIC_RETURN_FLOOR + 1e-6,
                          upper_clip: float = 12.0) -> float:
    """Stable sum(log(1+r)) with finite guards for decomposition diagnostics."""
    arr = np.asarray(returns, dtype=float)
    if arr.size == 0:
        return 0.0
    arr = np.where(np.isfinite(arr), arr, 0.0)
    arr = np.clip(arr, float(lower_clip), float(upper_clip))
    return float(np.sum(np.log(np.clip(1.0 + arr, 1e-12, None))))


def _apply_terminal_wealth_policy(raw_final_wealth: float) -> Tuple[float, Dict[str, Any]]:
    """
    Apply terminal wealth policy while preserving raw outcomes by default.
    Raises on non-finite wealth to avoid silently contaminating summary stats.
    """
    raw = float(raw_final_wealth)
    if not np.isfinite(raw):
        raise FloatingPointError(f"non-finite terminal wealth encountered: {raw}")

    # Economic floor: terminal wealth cannot be negative in this engine.
    floored = float(max(raw, 0.0))
    policy = str(TERMINAL_WEALTH_POLICY).strip().lower()
    cap_anchor = float(INITIAL_CAPITAL) * float(TERMINAL_WEALTH_HARD_CAP_MULT)
    applied = False

    if policy == 'legacy_cap':
        final = float(np.clip(floored, 0.0, cap_anchor))
        applied = bool(floored > cap_anchor)
    elif policy == 'soft_cap':
        if floored <= cap_anchor:
            final = floored
        else:
            excess = (floored - cap_anchor) / max(cap_anchor, 1e-12)
            final = float(cap_anchor * (1.0 + np.log1p(excess)))
            applied = True
    else:
        policy = 'raw'
        final = floored

    if not np.isfinite(final):
        raise FloatingPointError(f"terminal wealth policy produced non-finite value: {final}")

    return final, {
        'policy': policy,
        'applied': bool(applied),
        'raw': float(raw),
        'floored': float(floored),
        'cap_anchor': float(cap_anchor),
        'final': float(final),
    }


def _build_asset_decomposition_summary(leverage: float,
                                       underlying_eff: np.ndarray,
                                       daily_borrow: np.ndarray,
                                       expense_ratio: float,
                                       base_returns: np.ndarray,
                                       final_returns: np.ndarray) -> Dict[str, float]:
    """
    Realized component attribution in annualized log-return space.
    Components tracked: underlying, vol drag, financing, fees, tracking error.
    """
    n = int(len(final_returns))
    years = float(max(n / 252.0, 1e-9))

    gross_under = float(leverage) * np.asarray(underlying_eff, dtype=float)
    financing = -np.asarray(daily_borrow, dtype=float)
    fees = np.full(n, -float(expense_ratio) / 252.0, dtype=float)

    log_total = _sum_log_returns_safe(final_returns)
    log_base = _sum_log_returns_safe(base_returns)
    log_under = _sum_log_returns_safe(gross_under)
    log_fin = _sum_log_returns_safe(financing)
    log_fee = _sum_log_returns_safe(fees)

    # Tracking residual includes TE plus execution/tail/circuit-breaker residual channels.
    log_tracking = float(log_total - log_base)
    log_vol_drag = float(log_base - (log_under + log_fin + log_fee))

    def _ann_log(x: float) -> float:
        return float(x / years)

    def _ann_cagr(x: float) -> float:
        return float(np.expm1(_ann_log(x)))

    return {
        'days': int(n),
        'years': years,
        'total_log_ann': _ann_log(log_total),
        'total_cagr_ann': _ann_cagr(log_total),
        'underlying_log_ann': _ann_log(log_under),
        'underlying_cagr_ann': _ann_cagr(log_under),
        'vol_drag_log_ann': _ann_log(log_vol_drag),
        'vol_drag_cagr_ann': _ann_cagr(log_vol_drag),
        'financing_log_ann': _ann_log(log_fin),
        'financing_cagr_ann': _ann_cagr(log_fin),
        'fees_log_ann': _ann_log(log_fee),
        'fees_cagr_ann': _ann_cagr(log_fee),
        'tracking_log_ann': _ann_log(log_tracking),
        'tracking_cagr_ann': _ann_cagr(log_tracking)
    }


def simulate_etf_returns_from_layers(asset: str,
                                     config: Dict,
                                     underlying: np.ndarray,
                                     regime_path: np.ndarray,
                                     vix: np.ndarray,
                                     risk_free_annual: np.ndarray,
                                     sim_id: int,
                                     funding_model: Optional[Dict[str, float]],
                                     tracking_residual_model: Optional[Dict],
                                     stress_state: Optional[Dict[str, np.ndarray]],
                                     borrow_spread_override: Optional[Dict[str, float]] = None,
                                     te_multiplier: float = 1.0,
                                     recon_residuals: Optional[Dict[str, np.ndarray]] = None,
                                     is_reconstruction: bool = False) -> Tuple[np.ndarray, Dict[str, Any]]:
    """Layer B/C/D composition: leverage math, financing drag, calibrated ETF residual.

    borrow_spread_override: passed through to compute_daily_financing_series; clamps the
    predicted spread to [low, high] percent range defined by the active scenario.
    te_multiplier: scenario-level scale on tracking error base (e.g. 1.75 = 75% more TE).
    recon_residuals: per-asset residual arrays for deterministic reconstruction replay.
        When provided and is_reconstruction=True, bypasses generate_tracking_error_ar1.
    is_reconstruction: when True, disables stochastic TE, tail-event overlay, and
        circuit breakers (real historical returns already contain all extreme events).
    """
    leverage = config['leverage']
    expense_ratio = config['expense_ratio']
    spread_scale = 1.0
    if funding_model is not None:
        spread_scale = float(
            funding_model.get('asset_spread_scale', {}).get(
                asset, funding_model.get('global_spread_scale', 1.0)
            )
        )

    _rf_arr = np.asarray(risk_free_annual, dtype=float)
    if len(_rf_arr) != len(np.asarray(underlying, dtype=float)):
        raise RuntimeError(
            f"RF/underlying length mismatch for {asset}: rf={len(_rf_arr)}, underlying={len(np.asarray(underlying, dtype=float))}"
        )
    if np.isnan(_rf_arr).any():
        raise RuntimeError(f"NaN detected in risk_free_annual for {asset}; financing cannot be computed safely.")

    daily_borrow = compute_daily_financing_series(
        leverage=leverage,
        risk_free_annual=_rf_arr,
        vix=vix,
        funding_model=funding_model,
        fallback_spread=config.get('borrow_spread', 0.0),
        stress_state=stress_state,
        borrow_spread_override=borrow_spread_override,
        spread_scale=spread_scale
    )

    te_params = (tracking_residual_model or {}).get(asset, {})

    # ── v1.4 FIX 1: in reconstruction mode, replace VIX-based synthetic spread with
    # RF + calibrated_spread (constant estimated from real fund post-inception history).
    # This ensures borrow cost is historically grounded rather than driven by the
    # stochastic VIX term-spread model (compute_daily_financing_series).
    if is_reconstruction and leverage > 1.0:
        _cs = float(te_params.get('calibrated_spread', 0.0))
        daily_borrow = (leverage - 1.0) * (_rf_arr + _cs) / 252.0

    underlying_scale = float(np.clip(te_params.get('underlying_scale_adjust', 1.0), 0.82, 1.20))
    daily_alpha = float(np.clip(te_params.get('daily_alpha_adjust', 0.0), -0.00045, 0.00045))
    underlying_eff = np.asarray(underlying, dtype=float) * underlying_scale

    leveraged_before_te = np.array([
        compute_letf_return_correct(underlying_eff[t], leverage, 0, expense_ratio, daily_borrow[t]) + daily_alpha
        for t in range(len(underlying_eff))
    ], dtype=float)

    te_scale = te_params.get('base_scale', config['tracking_error_base'])
    te_scale *= float(te_params.get('te_scale_adjust', 1.0))
    te_scale *= te_multiplier          # scenario TE scaling applied before liquidity stress
    te_downside = te_params.get('downside_mult', 1.30)

    n_obs = len(underlying_eff)
    if leverage > 1.0:
        financing_spread_ann = np.clip(
            (daily_borrow * 252.0 / max(leverage - 1.0, 1e-6)) - _rf_arr,
            0.0,
            0.25
        )
    else:
        financing_spread_ann = np.zeros(n_obs, dtype=float)

    liquidity = None if stress_state is None else stress_state.get('liquidity', None)
    credit = None if stress_state is None else stress_state.get('credit', None)
    crash_active = None if stress_state is None else stress_state.get('crash_active', None)
    liq_proxy = np.asarray(liquidity, dtype=float) if liquidity is not None else np.clip((np.asarray(vix, dtype=float) - 20.0) / 15.0, 0.0, 3.0)
    cred_proxy = np.asarray(credit, dtype=float) if credit is not None else np.clip((np.asarray(vix, dtype=float) - 25.0) / 12.0, 0.0, 3.0)
    crash_proxy = np.asarray(crash_active, dtype=float) if crash_active is not None else np.zeros(n_obs, dtype=float)
    if len(liq_proxy) != n_obs:
        liq_proxy = np.resize(liq_proxy, n_obs)
    if len(cred_proxy) != n_obs:
        cred_proxy = np.resize(cred_proxy, n_obs)
    if len(crash_proxy) != n_obs:
        crash_proxy = np.resize(crash_proxy, n_obs)

    swap_spread_ann = np.clip(
        0.30 * financing_spread_ann
        + 0.0012 * np.clip(liq_proxy, 0.0, 3.0)
        + 0.0018 * np.clip(cred_proxy, 0.0, 3.0),
        0.0,
        0.20
    )
    counterparty_spread_ann = np.clip(
        0.45 * swap_spread_ann
        + 0.0008 * np.clip(cred_proxy, 0.0, 3.0)
        + 0.0006 * np.clip(crash_proxy, 0.0, 3.0),
        0.0,
        0.20
    )

    if liquidity is not None:
        _liq_mean = float(np.nanmean(liquidity))
        te_scale *= min(1 + 0.10 * _liq_mean, 1.5)   # cap at 1.5× to prevent TE blow-up
        te_downside *= (1 + 0.15 * _liq_mean)

    # ── v1.3: reconstruction mode uses actual historical residuals ────────────────
    if is_reconstruction and recon_residuals is not None and asset in recon_residuals:
        _pre = np.asarray(recon_residuals[asset], dtype=float)
        if len(_pre) >= n_obs:
            tracking_errors = _pre[-n_obs:].copy()
        else:
            # Resize via block repetition if stored residuals are shorter than sim window
            tracking_errors = np.resize(_pre, n_obs).astype(float)
    else:
        tracking_errors = generate_tracking_error_ar1(
            len(underlying_eff),
            regime_path,
            vix,
            underlying_eff,
            te_scale,
            te_params.get('df', config['tracking_error_df']),
            rng=np.random.default_rng(_stable_asset_seed(sim_id, asset)),
            rho=te_params.get('rho', 0.3),
            downside_asymmetry=te_downside,
            liquidity_series=liq_proxy,
            financing_spread_series=financing_spread_ann,
            swap_spread_series=swap_spread_ann,
            counterparty_spread_series=counterparty_spread_ann,
            credit_series=cred_proxy,
            crash_active_series=crash_proxy,
            clip_limit=te_params.get('clip_limit', None)
        )

    etf_ret = (1 + leveraged_before_te) * (1 + tracking_errors) - 1
    etf_ret_base = np.asarray(leveraged_before_te, dtype=float).copy()

    if is_reconstruction:
        # Real historical returns already embed all tail events, crashes, and
        # dislocations — applying a synthetic overlay would double-count them.
        # Circuit breakers are also irrelevant: historical NAV paths are ground truth.
        closure_day = None
        cb_diag: Dict[str, Any] = {}
        tail_events: Dict[str, Any] = {
            'event_counts': {},
            'overlay': np.zeros(n_obs, dtype=float),
            'halt_mask': np.zeros(n_obs, dtype=np.int8),
        }
    else:
        tail_rng = np.random.default_rng(_stable_asset_seed(sim_id + 314159, asset))
        tail_events = simulate_letf_tail_event_overlay(
            asset=asset,
            leverage=float(leverage),
            underlying_returns=underlying_eff,
            regime_path=np.asarray(regime_path, dtype=int),
            vix_series=np.asarray(vix, dtype=float),
            stress_state=stress_state,
            rng=tail_rng
        )
        etf_ret = etf_ret + np.asarray(tail_events.get('overlay', np.zeros(len(etf_ret))), dtype=float)

        closure_day = tail_events.get('closure_day', None)
        if closure_day is not None and np.isfinite(float(closure_day)):
            cd = int(closure_day)
            if cd + 1 < len(etf_ret):
                # ETF closure: NAV is frozen post-event (delisting/liquidation process).
                etf_ret[cd + 1:] = 0.0

        etf_ret, cb_diag = apply_state_dependent_circuit_breakers(
            returns=etf_ret,
            regime_path=np.asarray(regime_path, dtype=int),
            vix_series=np.asarray(vix, dtype=float),
            leverage=float(leverage),
            rng=tail_rng,
            stress_state=stress_state,
            halt_mask=np.asarray(tail_events.get('halt_mask', np.zeros(len(etf_ret), dtype=np.int8)), dtype=np.int8),
            asset_class='bond' if asset == 'TMF' else 'equity'
        )
        if closure_day is not None and np.isfinite(float(closure_day)):
            cd = int(closure_day)
            if cd + 1 < len(etf_ret):
                etf_ret[cd + 1:] = 0.0

    etf_ret = _soft_extreme_guard(etf_ret, lower=ECONOMIC_RETURN_FLOOR + 1e-5, upper=12.0)
    decomposition = _build_asset_decomposition_summary(
        leverage=float(leverage),
        underlying_eff=np.asarray(underlying_eff, dtype=float),
        daily_borrow=np.asarray(daily_borrow, dtype=float),
        expense_ratio=float(expense_ratio),
        base_returns=etf_ret_base,
        final_returns=np.asarray(etf_ret, dtype=float)
    )

    meta = {
        'tail_events': tail_events.get('event_counts', {}),
        'closure_day': int(closure_day) if closure_day is not None else None,
        'circuit_breakers': cb_diag,
        'decomposition': decomposition
    }
    return etf_ret, meta


def simulate_single_path_fixed(args):
    """Single Monte Carlo path with institutional layer separation and semi-Markov states."""
    sim_id, sim_years, regime_model, correlation_matrices, strategies = args
    rng = np.random.default_rng(sim_id + 50000)

    sim_days = int(sim_years * 252)
    regime_params = regime_model['regime_params']
    transition_matrix = regime_model['transition_matrix']
    duration_samples = regime_model.get('duration_samples', None)
    vix_dynamics = regime_model.get('vix_dynamics', None)
    joint_return_model = regime_model.get('joint_return_model', None)
    funding_model = regime_model.get('funding_model', None)
    tracking_residual_model = regime_model.get('tracking_residual_model', None)
    stress_state_model = regime_model.get('stress_state_model', None)
    structural_econ_model = regime_model.get('structural_econ_model', None)

    # --- Scenario tilts (Phase 3 + extended framework) -----------------------
    # Read once per path for clean separation: engine / overlays / scenarios.
    _sc = get_scenario()
    _crisis_scale      = float(_sc.get('crisis_prob_scale', 1.0))
    _crisis_dwell_scale= float(_sc.get('crisis_dwell_scale', 1.0))
    _drift_tilt        = float(_sc.get('drift_tilt', 0.0))
    _div_yield         = float(_sc.get('div_yield',  0.0))
    # Extended scenario parameters (vol, spreads, TE, tails, correlations).
    _vol_scale_calm  = float(_sc.get('vol_scale_calm',  1.0))
    _vol_scale_crisis= float(_sc.get('vol_scale_crisis', 1.0))
    _te_multiplier   = float(_sc.get('tracking_error_multiplier', 1.0))
    _fat_tail        = float(_sc.get('fat_tail_factor', 1.0))
    _qqq_jump_amp    = float(_sc.get('qqq_jump_amp', 1.35))
    _borrow_override = _sc.get('borrow_spread_override', None)
    _tlt_corr_calm   = _sc.get('normal_spy_tlt_corr', None)   # None = keep calibrated
    _crisis_corr_spk = _sc.get('crisis_corr_spike',   None)   # None = keep calibrated
    _corr_scope      = _normalize_correlation_override_scope(
        _sc.get('correlation_override_scope', 'portfolio_only')
    )
    if _tlt_corr_calm is not None:
        try:
            _tlt_corr_calm = float(_tlt_corr_calm)
            if not np.isfinite(_tlt_corr_calm):
                _tlt_corr_calm = None
        except Exception:
            _tlt_corr_calm = None
    if _crisis_corr_spk is not None:
        try:
            _crisis_corr_spk = float(_crisis_corr_spk)
            if not np.isfinite(_crisis_corr_spk):
                _crisis_corr_spk = None
        except Exception:
            _crisis_corr_spk = None
    _corr_diag_generator: Dict[str, Any] = {'scope': _corr_scope, 'applied': False}
    _corr_diag_portfolio: Dict[str, Any] = {'scope': _corr_scope, 'applied': False}
    # crisis_prob_scale controls crisis frequency via the calm-state Weibull λ.
    # In a 2-state semi-Markov model the off-diagonal of tm is irrelevant
    # (next state is always the other state after a spell ends), so scaling
    # tm[0,1] has no effect.  The correct knob is the calm-state dwell time:
    #   λ_scaled = λ_calm / crisis_prob_scale
    # crisis_prob_scale > 1  → shorter calm spells  → more crises
    # crisis_prob_scale < 1  → longer  calm spells  → fewer  crises
    # Passed as calm_scale_factor to simulate_regime_path_semi_markov below.

    start_conditions = apply_random_start_conditions(
        sim_id,
        sim_days,
        regime_model,
        regime_model.get('historical_df_for_anchors', None)
    )
    start_regime = start_conditions['start_regime']
    initial_vix = start_conditions['initial_vix']
    buffer_days = start_conditions['buffer_days']
    start_offset = start_conditions['start_offset']
    total_days = sim_days + buffer_days

    # Path-level occupancy control: in neutral baseline runs, keep stress share
    # close to calibrated topology to avoid occupancy drift in short samples.
    _target_share = None
    _target_tolerance = 0.08
    _target_share_override = regime_model.get('target_crisis_share_override', None)
    if _target_share_override is not None and np.isfinite(float(_target_share_override)):
        _target_share = float(np.clip(float(_target_share_override), 0.0, 1.0))
        _target_tolerance = float(np.clip(
            float(regime_model.get('target_crisis_share_tolerance', 0.05)),
            0.01,
            0.15
        ))
    elif abs(_crisis_scale - 1.0) < 1e-12 and abs(_crisis_dwell_scale - 1.0) < 1e-12:
        _target_share = _regime_frequency_from_params(
            regime_params=regime_params,
            regime_ids=tuple(STRESS_REGIME_IDS),
            use_topology=True
        )
        if not np.isfinite(_target_share):
            _target_share = None

    regime_path_full, _reg_target_diag = draw_regime_path_targeted(
        total_days=total_days,
        start_regime=start_regime,
        transition_matrix=transition_matrix,
        duration_samples=duration_samples,
        base_seed=int(sim_id + 50000),
        calm_scale_factor=_crisis_scale,
        crisis_scale_factor=_crisis_dwell_scale,
        target_crisis_share=_target_share,
        target_tolerance=_target_tolerance,
        max_attempts=10
    )
    start_conditions['regime_targeting'] = _reg_target_diag
    assert start_offset + sim_days <= total_days, (
        f"Regime-path offset out of bounds: start_offset={start_offset} + "
        f"sim_days={sim_days} = {start_offset + sim_days} > total_days={total_days}. "
        "This is a bug in select_random_start_offset — buffer_days must be >= start_offset."
    )
    regime_path = regime_path_full[start_offset:start_offset + sim_days]

    # Regime spell-length diagnostics — printed once (sim_id 0) to validate dwell scaling.
    # Uses full path (including buffer) for more spell observations.
    if sim_id == 0:
        _calm_avg = _avg_spell_length(regime_path_full, REGIME_LOW)
        _shock_avg = _avg_spell_length(regime_path_full, REGIME_HIGH_VOL)
        _bear_avg = _avg_spell_length(regime_path_full, REGIME_BEAR) if N_REGIMES > REGIME_BEAR else float('nan')
        _stress_pct = _stress_share(regime_path_full) * 100.0
        _bear_pct = float(np.mean(np.asarray(regime_path_full, dtype=int) == REGIME_BEAR)) * 100.0 if N_REGIMES > REGIME_BEAR else 0.0
        print(f"    Regime stats (path 0): calm_avg={_calm_avg:.0f}d  "
              f"shock_avg={_shock_avg:.0f}d  bear_avg={_bear_avg:.0f}d  "
              f"stress%={_stress_pct:.1f}%  bear%={_bear_pct:.1f}%  "
              f"[dwell_scale={_crisis_dwell_scale:.1f}]")
        if np.isfinite(_reg_target_diag.get('target_crisis_share', np.nan)):
            _t = _reg_target_diag['target_crisis_share'] * 100.0
            _a = _reg_target_diag.get('actual_crisis_share', np.nan) * 100.0
            _ab = _reg_target_diag.get('actual_bear_share', np.nan) * 100.0
            _ok = "yes" if _reg_target_diag.get('within_tolerance', False) else "no"
            print(f"    Regime target (path 0): target={_t:.1f}%  actual={_a:.1f}%  "
                  f"bear={_ab:.1f}%  attempts={int(_reg_target_diag.get('attempts_used', 0))}  within_tol={_ok}")

    # Correlation override layer: can affect return generation, optimizer matrices, or both.
    if (_tlt_corr_calm is not None or _crisis_corr_spk is not None):
        if _corr_scope in ('generator_only', 'both'):
            joint_return_model, _corr_diag_generator = _apply_scenario_corr_overrides_to_joint_return_model(
                joint_return_model=joint_return_model,
                calm_corr_override=_tlt_corr_calm,
                crisis_corr_spike=_crisis_corr_spk
            )
            _corr_diag_generator['scope'] = _corr_scope
        else:
            _corr_diag_generator = {'scope': _corr_scope, 'applied': False, 'reason': 'scope_excludes_generator'}

    bootstrap_sampler = regime_model.get('bootstrap_sampler', None)

    # --- Historical 1926 scenarios: bypass GARCH entirely -------------------------
    # Detect before calling generate_fat_tailed_returns so we skip that computation
    # completely.  For backtest mode, start_offset is forced to 0 — real data needs
    # no GARCH warm-up buffer.  Markov regime_path is kept for financing/TE layers.
    # Arrays come from regime_model['hist1926_data'] (pre-loaded in parallel_monte_carlo_fixed
    # before spawning workers) or fall back to module globals (main-process only).
    _hist1926_mode = _sc.get('_hist1926_mode', None)
    _hist1926_data = regime_model.get('hist1926_data', None)
    _is_hist1926 = (_hist1926_mode is not None) and (
        (_hist1926_data is not None and int(_hist1926_data.get('N', 0)) > 0)
        or _HIST1926_N > 0
    )
    # For historical_backtest, hist1926_data contains the window slice.
    # The '_is_reconstruction' marker lets us emit a more specific log message
    # and enforce the driver immutability invariant for this path only.
    _is_reconstruction = bool(_sc.get('_is_reconstruction', False))
    # v1.3: deterministic reconstruction state — set inside _is_hist1926 block when applicable.
    _recon_regime_path: Optional[np.ndarray] = None
    _recon_residuals_dict: Optional[Dict[str, np.ndarray]] = None
    _h1926_ret: Optional[Dict[str, np.ndarray]] = None

    # Guard: warn loudly if operator selected a historical pipeline but data did not load.
    # Without this, the code silently falls through to GARCH — a critical model integrity failure.
    if (not _is_hist1926
            and MARKET_SCENARIO in ('historical_backtest', 'historical_bootstrap')
            and sim_id == 0):
        print(f"\n  !!! CRITICAL WARNING [worker sim_id=0]: MARKET_SCENARIO='{MARKET_SCENARIO}' "
              f"but historical data is unavailable (_HIST1926_N={_HIST1926_N}, "
              f"hist1926_data={'present' if _hist1926_data else 'missing'}). "
              f"Falling back to GARCH synthetic generation — results are NOT a historical {MARKET_SCENARIO.split('_')[1]}. "
              f"Call _load_historical_1926_data() before running this scenario. !!!")
    if _is_hist1926:
        # Force start_offset = 0: real return series needs no GARCH warm-up buffer.
        start_offset = 0
        _h1926_block   = int(_sc.get('_hist1926_block_size', 63))
        _h1926_bootstrap_seed = (
            int(_sc.get('bootstrap_seed'))
            if (str(_hist1926_mode) == 'bootstrap' and _sc.get('bootstrap_seed') is not None)
            else None
        )
        _h1926_bootstrap_method = str(_sc.get('bootstrap_method', 'fixed')).strip().lower()
        _h1926_stationary_p = (
            float(_sc.get('stationary_p'))
            if (_h1926_bootstrap_method == 'stationary' and _sc.get('stationary_p') is not None)
            else None
        )
        _h1926_n_paths = int(regime_model.get('n_simulations_hint', max(sim_id + 1, 50)))
        _h1926_ret = _get_historical_path_returns(
            path_idx=sim_id,
            n_paths=_h1926_n_paths,
            n_days=sim_days,
            mode=str(_hist1926_mode),
            block_size=_h1926_block,
            rng=rng,
            hist_data=_hist1926_data,
            bootstrap_seed=_h1926_bootstrap_seed,
            bootstrap_method=_h1926_bootstrap_method,
            stationary_p=_h1926_stationary_p,
        )
        # Approximate VIX from 20-day rolling realised vol of historical SPY returns.
        # Consistent with the pre-1990 VIX proxy used in calibration.
        _vix_hist = (
            pd.Series(_h1926_ret['SPY_Ret'])
            .rolling(20, min_periods=1).std()
            .fillna(0.01)
            .mul(np.sqrt(252) * 100.0)
            .clip(5.0, 80.0)
            .to_numpy(dtype=np.float64)
        )
        # Build a minimal 'generated' dict so downstream code can read the same keys
        # as in the GARCH path without branching throughout the function.
        # ── DRIVER IMMUTABILITY ASSERTION (reconstruction mode only) ─────────
        # Verify that the sliced arrays in hist1926_data are byte-for-byte identical
        # to what was prepared in parallel_monte_carlo_fixed before any worker touched them.
        # In reconstruction mode, the original is stored in '_reconstruction_window_data_original'.
        if _is_reconstruction and sim_id == 0:
            _orig_data = regime_model.get('_reconstruction_window_data_original', None)
            if _orig_data is not None:
                try:
                    _imm = _driver_immutability_test(
                        _orig_data.get('SPY_Ret'),
                        _hist1926_data.get('SPY_Ret') if _hist1926_data else None,
                    )
                    print(f"  [historical_backtest] Driver immutability: {_imm['details']}")
                except RuntimeError as _imm_err:
                    # Do not silently continue — this is a hard constraint violation.
                    raise RuntimeError(str(_imm_err)) from _imm_err

        # ── v1.3: deterministic regime path from rolling vol (reconstruction only) ──
        # Replaces the Markov-simulated regime_path for downstream use in
        # simulate_etf_returns_from_layers.  The rolling-vol regime reflects the
        # ACTUAL market stress levels in the historical window rather than a
        # stochastic draw from the calibrated transition matrix.
        if _is_reconstruction:
            _full_spy_for_regime = np.asarray(_h1926_ret['SPY_Ret'], dtype=float)
            _recon_regime_path = _compute_recon_regime_from_vol(
                _full_spy_for_regime, vol_window=63
            )
            # Prepare per-asset residuals from model dict (travels via IPC to workers).
            if tracking_residual_model is not None:
                _recon_residuals_dict = {}
                for _ra in LETF_CONFIGS:
                    _rr = _replay_emulator_residuals(
                        fund=_ra,
                        n_days=sim_days,
                        model=tracking_residual_model,
                        seed=int(sim_id),
                    )
                    _recon_residuals_dict[_ra] = _rr

        generated = {
            'SPY_Ret': _h1926_ret['SPY_Ret'],
            'QQQ_Ret': _h1926_ret['QQQ_Ret'],
            'TLT_Ret': _h1926_ret['TLT_Ret'],
            'IRX':     _h1926_ret['IRX'],
            'VIX':     _vix_hist,
            'Joint_Return_Diagnostics': {
                'engine': 'historical_backtest' if _is_reconstruction
                          else 'historical_1926_direct',
                'mode':   str(_hist1926_mode),
                'bootstrap_method': _h1926_bootstrap_method if str(_hist1926_mode) == 'bootstrap' else None,
                'is_reconstruction': _is_reconstruction,
                'recon_regime_source': 'rolling_vol' if _is_reconstruction else 'markov',
                'recon_residuals_loaded': (
                    {k: len(v) for k, v in _recon_residuals_dict.items()}
                    if _recon_residuals_dict else {}
                ),
            },
        }
        _joint_engine_diag = generated['Joint_Return_Diagnostics']
        stress_state = None   # no synthetic stress or jumps in historical mode
    else:
        generated = generate_fat_tailed_returns(
            total_days,
            regime_path_full,
            regime_params,
            bootstrap_sampler,
            vix_dynamics=vix_dynamics,
            joint_return_model=joint_return_model,
            sim_engine_mode=SIM_ENGINE_MODE,
            seed=sim_id + 50000,
            historical_returns_df=regime_model.get('historical_df_for_returns', None)
        )
        _joint_engine_diag = generated.get('Joint_Return_Diagnostics', {})

        _reg_override = generated.get('Regime_Path_Override', None)
        if _reg_override is not None:
            _reg_override_arr = np.asarray(_reg_override, dtype=int)
            if len(_reg_override_arr) == total_days:
                regime_path_full = _reg_override_arr
                regime_path = regime_path_full[start_offset:start_offset + sim_days]

        stress_state = None  # set below after VIX is derived

    spy_returns     = generated['SPY_Ret'][start_offset:start_offset + sim_days]
    qqq_returns_raw = generated['QQQ_Ret'][start_offset:start_offset + sim_days]
    tlt_returns_raw = generated['TLT_Ret'][start_offset:start_offset + sim_days]

    # --- Scenario vol scaling (applied to GARCH component before jumps/drift) --
    # Scales the generated return series by regime without disturbing GARCH
    # dynamics or the stress/jump overlay.  Daily drift (mu ≈ 0.03% vs vol ≈ 0.95%)
    # is negligible, so multiplying the full return is equivalent to scaling vol.
    # vol_scale_calm=0.77 → calm SPY vol 15% → ~11.5% (optimistic low-vol regime).
    # vol_scale_crisis=1.25 → crisis SPY vol 40% → ~50% (pessimistic deep bear).
    if (not _is_hist1926) and (_vol_scale_calm != 1.0 or _vol_scale_crisis != 1.0):
        _vol_arr = np.full(len(regime_path), _vol_scale_crisis, dtype=float)
        _vol_arr[np.asarray(regime_path, dtype=int) == REGIME_LOW] = _vol_scale_calm
        if N_REGIMES > REGIME_BEAR:
            _bear_blend = 0.25 * _vol_scale_calm + 0.75 * _vol_scale_crisis
            _vol_arr[np.asarray(regime_path, dtype=int) == REGIME_BEAR] = _bear_blend
        spy_returns     = spy_returns     * _vol_arr
        qqq_returns_raw = qqq_returns_raw * _vol_arr
        tlt_returns_raw = tlt_returns_raw * _vol_arr

    generated_vix = generated.get('VIX', None)
    if generated_vix is not None:
        vix = generated_vix[start_offset:start_offset + sim_days]
    else:
        vix = np.full(sim_days, initial_vix)

    # stress_state was already set to None inside the if/else above;
    # only run the synthetic stress simulator for non-historical scenarios.
    if not _is_hist1926 and SIM_ENGINE_MODE == 'institutional_v1' and stress_state_model is not None:
        stress_state = simulate_latent_stress_state(sim_days, regime_path, stress_state_model, vix_series=vix, rng=rng)
        jump = stress_state.get('jump', np.zeros(sim_days))
        # --- Scenario fat-tail scaling (scales jump BEFORE applying to returns) --
        # fat_tail_factor > 1 → heavier jump magnitude (1970s oil-shock clustering).
        # fat_tail_factor < 1 → milder jumps (abundant liquidity dampens extremes).
        # Mutate stress_state copy so later layers (TE, financing) see scaled jumps.
        if _fat_tail != 1.0:
            jump = jump * _fat_tail
            stress_state = {**stress_state, 'jump': jump}
        # Fix 1: add (not subtract) — jump is already signed, so positive = gap-down,
        # negative = gap-up.  The previous subtraction of abs() was a one-sided drag.
        spy_returns = spy_returns + jump
        qqq_returns_raw = qqq_returns_raw + _qqq_jump_amp * jump

    # --- Scenario equity overlay (Phase 2 + 3) -------------------------------
    # drift_tilt: annual ARITHMETIC return increment (decimal, e.g. +0.02 = +2%/yr).
    # Scaling: Δr_daily = Δr_annual / 252 (correct for arithmetic daily returns).
    # Applied to ARITHMETIC (simple) daily returns — not log returns.
    # Expected CAGR impact ≈ drift_tilt to first order (negligible vol correction).
    # No double-counting: calibrated mu reflects historical mean; drift_tilt is an
    # intentional overlay (scenario pessimism / optimism) on top of calibration.
    #
    # div_yield: annual dividend yield (e.g., 0.015 = 1.5%); same daily scaling.
    # Acts as a constant daily credit: price return → total return approximation.
    # Expected contribution: +div_yield to annual CAGR (before compounding effects).
    #
    # Neither overlay modifies GARCH variance dynamics (vol is scenario-neutral).
    _daily_equity_add = _drift_tilt / 252.0 + _div_yield / 252.0
    if (not _is_hist1926) and _daily_equity_add != 0.0:
        spy_returns = spy_returns + _daily_equity_add
        qqq_returns_raw = qqq_returns_raw + _daily_equity_add
    # Note: TLT is not dividend-adjusted here (bond coupon already in price return for TLT).
    # Note: historical_backtest preset correctly sets drift_tilt=0 and div_yield=0, so the
    # guard above is defence-in-depth against future preset edits accidentally re-enabling this overlay.

    # IRX: generated['IRX'] carries real FF risk-free rates for hist1926 scenarios
    # (loaded into 'generated' above), and GARCH-simulated rates otherwise.
    # Both branches use the same key so no branching is needed here.
    irx_boot = generated.get('IRX', None)
    if _is_hist1926 and irx_boot is None:
        raise RuntimeError(
            "Historical scenario requires sampled IRX path, but generated['IRX'] is missing."
        )
    if irx_boot is not None:
        risk_free_annual = np.clip(irx_boot[start_offset:start_offset + sim_days], 0.0, 20.0) / 100.0
    else:
        risk_free_annual = np.where(regime_path == 0, 0.045, 0.015)
    if _is_hist1926 and _h1926_ret is not None:
        _rf_sampled = np.clip(
            np.asarray(_h1926_ret['IRX'][start_offset:start_offset + sim_days], dtype=float),
            0.0,
            20.0
        ) / 100.0
        assert np.allclose(risk_free_annual, _rf_sampled), (
            "Historical RF mismatch: financing path is not using sampled IRX values."
        )
        _ret_idx = np.asarray(_h1926_ret.get('_sampled_return_indices', []), dtype=np.int64)
        _rf_idx = np.asarray(_h1926_ret.get('_sampled_rf_indices', []), dtype=np.int64)
        assert np.array_equal(_ret_idx, _rf_idx), (
            "Historical RF index mismatch: sampled_RF_index != sampled_return_index"
        )

    # Structural macro overlay: valuation mean reversion (CAPE) + rate regime tilt.
    # Skipped for historical scenarios — CAPE mean-reversion is already embedded in the
    # real return stream; adding it again would double-count valuation dynamics.
    if not _is_hist1926:
        term_spread_sim_pct = np.where(regime_path == REGIME_LOW, 1.25, 0.20).astype(float)
        if stress_state is not None and 'credit' in stress_state:
            _cred = np.clip(np.asarray(stress_state['credit'], dtype=float), 0.0, 3.0)
            term_spread_sim_pct = 1.30 - 1.10 * _cred
        rate_regime = _classify_rate_regime_series(
            irx_pct=risk_free_annual * 100.0,
            term_spread_pct=term_spread_sim_pct,
            structural_model=structural_econ_model
        )
        cape_anchor = start_conditions.get('cape', None)
        cape_path = _simulate_cape_path(
            n_days=sim_days,
            regime_path=np.asarray(regime_path, dtype=int),
            rate_regime=rate_regime,
            structural_model=structural_econ_model,
            rng=np.random.default_rng(sim_id + 123457),
            anchor_cape=float(cape_anchor) if cape_anchor is not None and np.isfinite(float(cape_anchor)) else None
        )
        structural_ann_adj = _compute_structural_drift_adjustment_annual(
            cape_path=cape_path,
            irx_pct=risk_free_annual * 100.0,
            term_spread_pct=term_spread_sim_pct,
            structural_model=structural_econ_model
        )
        if len(structural_ann_adj) == sim_days:
            spy_returns = spy_returns + structural_ann_adj / 252.0
            _qqq_val_mult = float((structural_econ_model or {}).get('qqq_valuation_mult', STRUCTURAL_QQQ_VALUATION_MULT))
            qqq_returns_raw = qqq_returns_raw + (structural_ann_adj / 252.0) * _qqq_val_mult

    # State-dependent circuit-breakers with overflow carry (replaces blunt clipping).
    # Historical pipelines bypass this entirely: real historical returns are bounded
    # by what the market actually produced and must not be clipped or redistributed
    # using a synthetic Markov regime path that does not match the true historical
    # regime sequence.  Applying breakers here was the primary source of distribution
    # mismatch in historical_backtest validation outputs.
    if not _is_hist1926:
        spy_returns, _spy_cb_diag = apply_state_dependent_circuit_breakers(
            returns=spy_returns,
            regime_path=np.asarray(regime_path, dtype=int),
            vix_series=np.asarray(vix, dtype=float),
            leverage=1.0,
            rng=np.random.default_rng(sim_id + 60017),
            stress_state=stress_state,
            asset_class='equity'
        )
        qqq_returns_raw, _qqq_cb_diag = apply_state_dependent_circuit_breakers(
            returns=qqq_returns_raw,
            regime_path=np.asarray(regime_path, dtype=int),
            vix_series=np.asarray(vix, dtype=float),
            leverage=1.15,
            rng=np.random.default_rng(sim_id + 60029),
            stress_state=stress_state,
            asset_class='equity'
        )
        tlt_returns_raw, _tlt_cb_diag = apply_state_dependent_circuit_breakers(
            returns=tlt_returns_raw,
            regime_path=np.asarray(regime_path, dtype=int),
            vix_series=np.asarray(vix, dtype=float),
            leverage=1.0,
            rng=np.random.default_rng(sim_id + 60043),
            stress_state=stress_state,
            asset_class='bond'
        )
