                    )
            prev_alloc = exec_alloc
        
        # Calculate return
            ret = (exec_alloc * df[f'{asset}_Ret'].iloc[i]) + ((1-exec_alloc) * df['Cash_Ret'].iloc[i])
        
        # Apply transaction costs
            if apply_costs:
                ret -= spread_cost
        
            equity_curve.iloc[i] = equity_curve.iloc[i-1] * (1 + ret)
    
