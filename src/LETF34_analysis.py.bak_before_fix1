def _apply_te_stress_param_snapshot(snapshot: Dict[str, Any]) -> None:
    global TE_STRESS_COEFFICIENTS
    if isinstance(snapshot, dict) and len(snapshot) > 0:
        TE_STRESS_COEFFICIENTS = dict(snapshot)


def _scale_te_stress_snapshot(base_snapshot: Dict[str, Any], scale: float) -> Dict[str, Any]:
    s = float(np.clip(scale, 0.40, 2.20))
    out = copy.deepcopy(base_snapshot) if isinstance(base_snapshot, dict) else {}
    if not out:
        out = {
            'liquidity_mult': 0.20,
            'financing_mult': 0.35,
            'swap_mult': 0.30,
            'counterparty_mult': 0.25,
            'credit_mult': 0.08,
            'crash_mult': 0.25,
            'crash_drag_level': 0.0002,
            'crash_drag_return_mult': 6.0,
        }
    for k in ['liquidity_mult', 'financing_mult', 'swap_mult', 'counterparty_mult', 'credit_mult', 'crash_mult']:
        if k in out and np.isfinite(float(out[k])):
            out[k] = float(np.clip(float(out[k]) * s, 0.0, 3.0))
    if 'crash_drag_level' in out and np.isfinite(float(out['crash_drag_level'])):
        out['crash_drag_level'] = float(np.clip(float(out['crash_drag_level']) * s, 0.0, 0.0050))
    if 'crash_drag_return_mult' in out and np.isfinite(float(out['crash_drag_return_mult'])):
        out['crash_drag_return_mult'] = float(np.clip(float(out['crash_drag_return_mult']) * (1.0 + 0.30 * (s - 1.0)), 0.5, 25.0))
    out['scale'] = float(s)
    return out


