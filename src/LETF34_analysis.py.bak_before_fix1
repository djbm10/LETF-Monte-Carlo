def _run_monte_carlo_paths_sequential(strategy_ids: List[str],
                                      time_horizon: int,
                                      regime_model: Dict[str, Any],
                                      correlation_matrices: Dict[int, np.ndarray],
                                      n_sims: int,
                                      historical_df: Optional[pd.DataFrame] = None,
                                      seed_offset: int = 0,
                                      bootstrap_sampler: Optional[Dict[str, Any]] = None) -> Dict[str, List[Dict[str, Any]]]:
    """
    Sequential Monte Carlo fallback used by constrained tuners when process pools
    are unavailable or too expensive for fast inner-loop calibration sweeps.
    """
    sim_cfg = get_simulation_config()
    rm = regime_model.copy()
    if bootstrap_sampler is not None:
        rm['bootstrap_sampler'] = bootstrap_sampler
    elif historical_df is not None and sim_cfg.use_block_bootstrap:
        rm['bootstrap_sampler'] = create_bootstrap_sampler(historical_df)

    if USE_RANDOM_START and RANDOM_START_METHOD == 'historical_anchor':
        anchor_df = historical_df
        if anchor_df is not None and len(anchor_df) > 0:
            rm['historical_df_for_anchors'] = anchor_df

    all_results: Dict[str, List[Dict[str, Any]]] = {sid: [] for sid in strategy_ids}
    error_count = 0
    for sim_id in range(int(max(1, n_sims))):
        args = (sim_id + int(seed_offset) * 1000000, int(time_horizon), rm, correlation_matrices, strategy_ids)
        try:
            path_results = simulate_single_path_fixed(args)
        except Exception as e:
            error_count += 1
            path_results = {
                sid: {
                    'status': 'error',
                    'Final_Wealth': None,
                    'error': str(e),
                    'error_type': type(e).__name__
                } for sid in strategy_ids
            }
        for sid in strategy_ids:
            all_results[sid].append(path_results.get(sid, {'status': 'error', 'Final_Wealth': None}))
    if error_count > 0:
        print(f"  [sequential MC] technical path errors: {error_count}/{int(max(1, n_sims))}")
    return all_results


def _compute_real_leveraged_vol_percentiles(df: pd.DataFrame,
                                            assets: Optional[List[str]] = None) -> Dict[str, Any]:
    assets_eval = list(assets) if isinstance(assets, list) and len(assets) > 0 else list(STAGE_B_TAIL_VOL_ASSETS)
    out: Dict[str, Any] = {'assets': {}, 'assets_evaluated': 0}
    for asset in assets_eval:
        ret_col = f'{asset}_Real_Ret'
        if ret_col not in df.columns:
            continue

        mask = np.isfinite(df[ret_col].to_numpy(dtype=float))
        syn_col = f'{asset}_IsSynthetic'
        if syn_col in df.columns:
            mask &= (~df[syn_col].fillna(False).to_numpy(dtype=bool))
        series = pd.Series(df[ret_col].to_numpy(dtype=float), index=df.index)
        series = series[mask]
        if len(series) < 300:
            continue

        roll = (series.rolling(252, min_periods=200).std() * np.sqrt(252)).dropna().to_numpy(dtype=float)
        if len(roll) > 0:
            roll = roll[::21]
        if len(roll) < 20:
            continue

        out['assets'][asset] = {
            'n_windows': int(len(roll)),
            'percentiles': {
                'p25': float(np.percentile(roll, 25)),
                'p50': float(np.percentile(roll, 50)),
                'p75': float(np.percentile(roll, 75)),
                'p95': float(np.percentile(roll, 95)),
            }
        }
    out['assets_evaluated'] = int(len(out['assets']))
    return out


def _extract_simulated_leveraged_vol_percentiles(mc_results: Dict[str, List[Dict[str, Any]]],
                                                 asset_sid_map: Optional[Dict[str, str]] = None) -> Dict[str, Any]:
    mapping = dict(asset_sid_map) if isinstance(asset_sid_map, dict) and len(asset_sid_map) > 0 else {
        'TQQQ': 'S1',
        'UPRO': 'S21',
        'SSO': 'S3',
        'QLD': 'S20',
    }
    out: Dict[str, Any] = {'assets': {}, 'assets_evaluated': 0}
    for asset, sid in mapping.items():
        rows = mc_results.get(sid, [])
        vols: List[float] = []
        k = f'{asset.lower()}_ann_vol'
        for r in rows:
            if r.get('status', 'success') == 'error':
                continue
            meta = r.get('Metadata', {}) if isinstance(r, dict) else {}
            pf = meta.get('path_features', {}) if isinstance(meta, dict) else {}
            v = float(pf.get(k, np.nan)) if isinstance(pf, dict) else float('nan')
            if np.isfinite(v):
                vols.append(v)
        if len(vols) < 20:
            continue
        arr = np.asarray(vols, dtype=float)
        out['assets'][asset] = {
            'n_paths': int(len(arr)),
            'percentiles': {
                'p25': float(np.percentile(arr, 25)),
                'p50': float(np.percentile(arr, 50)),
                'p75': float(np.percentile(arr, 75)),
                'p95': float(np.percentile(arr, 95)),
            }
        }
    out['assets_evaluated'] = int(len(out['assets']))
    return out


def _compute_leveraged_vol_percentile_error(real_ref: Dict[str, Any],
                                            sim_ref: Dict[str, Any],
                                            percentile_weights: Optional[Dict[str, float]] = None) -> Dict[str, Any]:
    out: Dict[str, Any] = {
        'assets': {},
        'assets_compared': 0,
        'error_sum': float('inf'),
        'error_mean': float('inf'),
        'weighted_error_sum': float('inf'),
        'weighted_error_mean': float('inf'),
        'focus_p50_p75_sum': float('inf'),
        'focus_p50_p75_mean': float('inf'),
        'p50_error_sum': float('inf'),
        'p75_error_sum': float('inf'),
        'weights': {}
    }
    real_assets = (real_ref or {}).get('assets', {}) if isinstance(real_ref, dict) else {}
    sim_assets = (sim_ref or {}).get('assets', {}) if isinstance(sim_ref, dict) else {}
    keys = sorted(set(real_assets.keys()) & set(sim_assets.keys()))
    if len(keys) == 0:
        return out

    errs = []
    weighted_errs = []
    focus_errs = []
    p50_errs = []
    p75_errs = []
    default_w = {'p25': 1.0, 'p50': 1.0, 'p75': 1.0, 'p95': 1.0}
    raw_w = percentile_weights if isinstance(percentile_weights, dict) else STAGE_B_TAIL_VOL_OBJECTIVE_WEIGHTS
    if not isinstance(raw_w, dict):
        raw_w = default_w
    weights = {k: float(max(0.0, raw_w.get(k, default_w[k]))) for k in ['p25', 'p50', 'p75', 'p95']}
    if sum(weights.values()) <= 0:
        weights = dict(default_w)
    out['weights'] = dict(weights)

    for asset in keys:
        rp = real_assets[asset].get('percentiles', {})
        sp = sim_assets[asset].get('percentiles', {})
        e = {
            'p25': float(abs(float(sp.get('p25', np.nan)) - float(rp.get('p25', np.nan)))),
            'p50': float(abs(float(sp.get('p50', np.nan)) - float(rp.get('p50', np.nan)))),
            'p75': float(abs(float(sp.get('p75', np.nan)) - float(rp.get('p75', np.nan)))),
            'p95': float(abs(float(sp.get('p95', np.nan)) - float(rp.get('p95', np.nan)))),
        }
        e_sum = float(np.nansum([e['p25'], e['p50'], e['p75'], e['p95']]))
        e_focus = float(np.nansum([e['p50'], e['p75']]))
        e_weighted = float(np.nansum([
            weights['p25'] * e['p25'],
            weights['p50'] * e['p50'],
            weights['p75'] * e['p75'],
            weights['p95'] * e['p95'],
        ]))
        errs.append(e_sum)
        weighted_errs.append(e_weighted)
        focus_errs.append(e_focus)
        p50_errs.append(float(e['p50']))
        p75_errs.append(float(e['p75']))
        out['assets'][asset] = {
            'abs_errors': e,
            'error_sum': e_sum,
            'weighted_error_sum': e_weighted,
            'focus_p50_p75_sum': e_focus
        }

    out['assets_compared'] = int(len(keys))
    out['error_sum'] = float(np.nansum(errs)) if len(errs) > 0 else float('inf')
    out['error_mean'] = float(np.nanmean(errs)) if len(errs) > 0 else float('inf')
    out['weighted_error_sum'] = float(np.nansum(weighted_errs)) if len(weighted_errs) > 0 else float('inf')
    out['weighted_error_mean'] = float(np.nanmean(weighted_errs)) if len(weighted_errs) > 0 else float('inf')
    out['focus_p50_p75_sum'] = float(np.nansum(focus_errs)) if len(focus_errs) > 0 else float('inf')
    out['focus_p50_p75_mean'] = float(np.nanmean(focus_errs)) if len(focus_errs) > 0 else float('inf')
    out['p50_error_sum'] = float(np.nansum(p50_errs)) if len(p50_errs) > 0 else float('inf')
    out['p75_error_sum'] = float(np.nansum(p75_errs)) if len(p75_errs) > 0 else float('inf')
    return out


def tune_letf_tail_overlay_constrained(df: pd.DataFrame,
                                       regime_model: Dict[str, Any],
                                       correlation_matrices: Dict[int, np.ndarray],
                                       scales: Optional[List[float]] = None,
                                       n_sims: int = STAGE_B_TAIL_MC_SIMS,
                                       horizon_years: int = STAGE_B_TAIL_HORIZON_YEARS,
                                       require_drawdown_pass: bool = STAGE_B_TAIL_REQUIRE_DD_PASS,
                                       dd_n_sims: int = STAGE_B_TAIL_DD_SIMS) -> Dict[str, Any]:
    """
    Stage B:
      Tune LETF tail-event intensity scale for leveraged volatility percentile fit,
      constrained to preserve SPY drawdown realism from Stage A.
    """
    out: Dict[str, Any] = {
        'enabled': True,
        'applied': False,
        'selected_scale': 1.0,
        'baseline_scale': 1.0,
        'feasible_selected': False,
        'candidates': []
    }
    if not isinstance(correlation_matrices, dict) or len(correlation_matrices) == 0:
        out['enabled'] = False
        out['reason'] = 'missing_correlation_matrices'
        return out

    real_ref = _compute_real_leveraged_vol_percentiles(df=df, assets=list(STAGE_B_TAIL_VOL_ASSETS))
    if int(real_ref.get('assets_evaluated', 0)) < 2:
        out['enabled'] = False
        out['reason'] = 'insufficient_real_leveraged_vol_windows'
        out['real_reference'] = real_ref
        return out

    grid = list(scales) if isinstance(scales, list) and len(scales) > 0 else list(STAGE_B_TAIL_SCALE_GRID)
    grid = sorted({float(np.clip(x, 0.30, 3.00)) for x in grid} | {1.0})

    # Drawdown constraint is SPY-core driven (Stage A); LETF tail overlay does not
    # alter SPY return generation path, so this check is invariant across scales.
    try:
        dd_diag = _compute_spy_drawdown_episode_metrics(df=df, regime_model=regime_model, n_sims=dd_n_sims)
        dd_pass = bool(dd_diag.get('all_passed', False))
    except Exception as e:
        dd_diag = {'all_passed': False, 'error': str(e), 'error_type': type(e).__name__}
        dd_pass = False
        if require_drawdown_pass:
            out['enabled'] = False
            out['reason'] = 'drawdown_constraint_evaluation_failed'
            out['drawdown_constraint'] = dd_diag
            return out

    strategy_ids = ['S1', 'S3', 'S20', 'S21']
    sim_cfg = get_simulation_config()
    bootstrap_sampler = None
    if sim_cfg.use_block_bootstrap and df is not None and len(df) > 0:
        bootstrap_sampler = create_bootstrap_sampler(df)

    base_snapshot = _snapshot_letf_tail_params()
    candidate_rows: List[Dict[str, Any]] = []
    candidate_snapshots: Dict[float, Dict[str, Any]] = {}

    for sc in grid:
        snap = _scale_letf_tail_snapshot(base_snapshot, sc)
        candidate_snapshots[float(sc)] = copy.deepcopy(snap)
        with _temporary_letf_tail_snapshot(snap):
            mc_res = _run_monte_carlo_paths_sequential(
                strategy_ids=strategy_ids,
                time_horizon=int(max(1, horizon_years)),
                regime_model=regime_model,
                correlation_matrices=correlation_matrices,
                n_sims=int(max(20, n_sims)),
                historical_df=df,
                seed_offset=73,
                bootstrap_sampler=bootstrap_sampler
            )
        sim_ref = _extract_simulated_leveraged_vol_percentiles(mc_results=mc_res)
        err = _compute_leveraged_vol_percentile_error(
            real_ref=real_ref,
            sim_ref=sim_ref,
            percentile_weights=STAGE_B_TAIL_VOL_OBJECTIVE_WEIGHTS
        )
        enough_assets = int(err.get('assets_compared', 0)) >= 2
        feasible = bool(enough_assets and ((not require_drawdown_pass) or dd_pass))
        weighted_error_sum = float(err.get('weighted_error_sum', float('inf')))
        focus_p50_p75_sum = float(err.get('focus_p50_p75_sum', float('inf')))
        p50_error_sum = float(err.get('p50_error_sum', float('inf')))
        p75_error_sum = float(err.get('p75_error_sum', float('inf')))
        center = float(np.clip(STAGE_B_TAIL_TARGET_CENTER, 0.30, 3.00))
        row = {
            'scale': float(sc),
            'drawdown_constraint_passed': bool(dd_pass),
            'assets_compared': int(err.get('assets_compared', 0)),
            'feasible': bool(feasible),
            'error_sum': float(err.get('error_sum', float('inf'))),
            'weighted_error_sum': weighted_error_sum,
            'focus_p50_p75_sum': focus_p50_p75_sum,
            'p50_error_sum': p50_error_sum,
            'p75_error_sum': p75_error_sum,
            'error_mean': float(err.get('error_mean', float('inf'))),
            'weighted_error_mean': float(err.get('weighted_error_mean', float('inf'))),
            'error_detail': err.get('assets', {}),
            'objective_weights': dict(err.get('weights', {})),
        }
        row['score_key'] = (
            0 if row['feasible'] else 1,
            0 if np.isfinite(row['weighted_error_sum']) else 1,
            float(row['weighted_error_sum']),
            float(row['focus_p50_p75_sum']),
            float(row['error_sum']),
            abs(float(row['scale']) - center)
        )
        candidate_rows.append(row)
        print(f"  Stage B candidate scale={float(sc):.3f}: feasible={row['feasible']}  "
              f"assets={row['assets_compared']}  p50+p75={row['focus_p50_p75_sum']:.6f}  "
              f"weighted={row['weighted_error_sum']:.6f}  total={row['error_sum']:.6f}")

    base_row = min([r for r in candidate_rows if abs(float(r['scale']) - 1.0) < 1e-10], key=lambda x: tuple(x['score_key']))
    feasible_rows = [r for r in candidate_rows if bool(r.get('feasible', False))]
    best_row = min(feasible_rows, key=lambda x: tuple(x['score_key'])) if len(feasible_rows) > 0 else base_row
    apply_tuned = bool(best_row.get('feasible', False) and tuple(best_row['score_key']) < tuple(base_row['score_key']))
    selected_row = best_row if apply_tuned else base_row
    selected_scale = float(selected_row['scale'])

    _apply_letf_tail_param_snapshot(candidate_snapshots[selected_scale])

    out['applied'] = bool(apply_tuned)
    out['selected_scale'] = float(selected_scale)
    out['baseline_scale'] = 1.0
    out['feasible_selected'] = bool(selected_row.get('feasible', False))
    out['drawdown_constraint_passed'] = bool(dd_pass)
    out['drawdown_constraint'] = dd_diag
    out['real_reference'] = real_ref
    out['baseline_score_key'] = tuple(base_row['score_key'])
    out['selected_score_key'] = tuple(selected_row['score_key'])
    out['selected_error_sum'] = float(selected_row.get('error_sum', float('inf')))
    out['selected_weighted_error_sum'] = float(selected_row.get('weighted_error_sum', float('inf')))
    out['selected_focus_p50_p75_sum'] = float(selected_row.get('focus_p50_p75_sum', float('inf')))
    out['objective_weights'] = dict(selected_row.get('objective_weights', STAGE_B_TAIL_VOL_OBJECTIVE_WEIGHTS))
    out['objective_target_center'] = float(np.clip(STAGE_B_TAIL_TARGET_CENTER, 0.30, 3.00))
    out['candidates'] = [
        {
            'scale': float(r['scale']),
            'feasible': bool(r['feasible']),
            'assets_compared': int(r['assets_compared']),
            'drawdown_constraint_passed': bool(r['drawdown_constraint_passed']),
            'error_sum': float(r['error_sum']),
            'weighted_error_sum': float(r['weighted_error_sum']),
            'focus_p50_p75_sum': float(r['focus_p50_p75_sum']),
            'p50_error_sum': float(r['p50_error_sum']),
            'p75_error_sum': float(r['p75_error_sum']),
            'error_mean': float(r['error_mean']),
            'score_key': tuple(r['score_key']),
        }
        for r in sorted(candidate_rows, key=lambda x: tuple(x['score_key']))
    ]
    print("  Stage B (LETF tail-overlay constrained tuning):")
    print(f"    baseline score={out['baseline_score_key']}  selected score={out['selected_score_key']}")
    print(f"    selected scale={out['selected_scale']:.3f}  applied={out['applied']}  "
          f"drawdown constraint pass={out['drawdown_constraint_passed']}")
    print(f"    selected p50+p75={out['selected_focus_p50_p75_sum']:.6f}  "
          f"selected weighted={out['selected_weighted_error_sum']:.6f}")
    return out


def _rolling_vol_percentiles_from_returns(returns: np.ndarray,
                                          window_days: int = 252,
                                          min_periods: int = 200,
                                          step_days: int = 21) -> Optional[Dict[str, Any]]:
    arr = np.asarray(returns, dtype=float)
    arr = arr[np.isfinite(arr)]
    if len(arr) < max(window_days, min_periods) + 5:
        return None
    roll = pd.Series(arr).rolling(window_days, min_periods=min_periods).std() * np.sqrt(252)
    x = roll.dropna().to_numpy(dtype=float)
    if len(x) > 0:
        x = x[::max(int(step_days), 1)]
    if len(x) < 20:
        return None
    return {
        'p25': float(np.percentile(x, 25)),
        'p50': float(np.percentile(x, 50)),
        'p75': float(np.percentile(x, 75)),
        'p95': float(np.percentile(x, 95)),
        'count': int(len(x)),
        'values': x
    }


def _strategy_assets_from_config(strategy_id: str) -> List[str]:
    cfg = STRATEGIES.get(strategy_id, {})
    if not isinstance(cfg, dict):
        return []
    assets: Set[str] = set()
    if isinstance(cfg.get('assets', None), dict):
        for a in cfg.get('assets', {}).keys():
            if isinstance(a, str):
                assets.add(a)
    for k in ['asset', 'defensive_asset']:
        a = cfg.get(k, None)
        if isinstance(a, str):
            assets.add(a)
    return sorted(list(assets))


def _prepare_strategy_real_dataset(df: pd.DataFrame, strategy_id: str) -> Optional[pd.DataFrame]:
    if df is None or len(df) < 300:
        return None
    assets_needed = _strategy_assets_from_config(strategy_id)
    if len(assets_needed) == 0:
        return None

    mask = np.ones(len(df), dtype=bool)
    for asset in assets_needed:
        syn_col = f'{asset}_IsSynthetic'
        if syn_col in df.columns:
            mask &= (~df[syn_col].fillna(False).to_numpy(dtype=bool))
        real_col = f'{asset}_Real_Ret'
        if real_col in df.columns:
            mask &= np.isfinite(df[real_col].to_numpy(dtype=float))
        elif f'{asset}_Ret' in df.columns:
            mask &= np.isfinite(df[f'{asset}_Ret'].to_numpy(dtype=float))

    sub = df.loc[mask].copy()
    if len(sub) < 300:
        return None

    # Force real return stream where available for strategy-assets.
    for asset in assets_needed:
        real_col = f'{asset}_Real_Ret'
        ret_col = f'{asset}_Ret'
        px_col = f'{asset}_Price'
        if real_col in sub.columns and ret_col in sub.columns:
            sub[ret_col] = sub[real_col].astype(float).fillna(0.0)
            sub[px_col] = (1.0 + sub[ret_col].fillna(0.0)).cumprod() * 100.0

    # Preserve strategy prerequisites.
    if 'SPY_Price' not in sub.columns and 'SPY_Ret' in sub.columns:
        sub['SPY_Price'] = (1.0 + sub['SPY_Ret'].fillna(0.0)).cumprod() * 100.0
    if 'Cash_Ret' not in sub.columns:
        sub['Cash_Ret'] = np.zeros(len(sub), dtype=float)
    if 'VIX' not in sub.columns:
        sub['VIX'] = np.full(len(sub), 20.0, dtype=float)

    return sub


def _compute_real_strategy_post_cost_vol_percentiles(df: pd.DataFrame,
                                                     strategy_ids: List[str],
                                                     apply_costs: bool = True) -> Dict[str, Any]:
    out: Dict[str, Any] = {'strategies': {}, 'strategies_evaluated': 0}
    for sid in strategy_ids:
        sub = _prepare_strategy_real_dataset(df, sid)
        if sub is None:
            continue
        try:
            eq, _ = run_strategy_fixed(
                sub,
                sid,
                regime_path=None,
                correlation_matrices={},
                apply_costs=bool(apply_costs),
                trade_journal=None
            )
        except Exception:
            continue
        if len(eq) < 260:
            continue
        rets = eq.pct_change().fillna(0.0).to_numpy(dtype=float)
        vol_pct = _rolling_vol_percentiles_from_returns(rets)
        if vol_pct is None:
            continue
        out['strategies'][sid] = {
            'n_windows': int(vol_pct['count']),
            'percentiles': {
                'p25': float(vol_pct['p25']),
                'p50': float(vol_pct['p50']),
                'p75': float(vol_pct['p75']),
                'p95': float(vol_pct['p95']),
            }
        }
    out['strategies_evaluated'] = int(len(out['strategies']))
    return out


