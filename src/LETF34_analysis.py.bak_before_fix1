                if isinstance(component_totals, dict) and len(component_totals) > 0:
                    fed_tax_total = float(component_totals.get('federal_total', 0.0))
                    state_tax_total = float(component_totals.get('state_tax', 0.0))
                    niit_tax_total = float(component_totals.get('niit_tax', 0.0))
                    amt_tax_total = float(component_totals.get('amt_tax', 0.0))
                else:
                    yearly = tax_result.get('yearly_taxes', [])
                    fed_tax_total = float(np.nansum([float(y.get('federal_total', 0.0)) for y in yearly])) if yearly else 0.0
                    state_tax_total = float(np.nansum([float(y.get('state_tax', 0.0)) for y in yearly])) if yearly else 0.0
                    niit_tax_total = float(np.nansum([float(y.get('niit_tax', 0.0)) for y in yearly])) if yearly else 0.0
                    amt_tax_total = float(np.nansum([float(y.get('amt_tax', 0.0)) for y in yearly])) if yearly else 0.0
            else:
                total_tax = 0
            
            post_wealth = pre_wealth - total_tax
            post_tax_wealths.append(post_wealth)

            pre_log_ann = float(np.log(max(float(pre_wealth), 1e-12) / float(INITIAL_CAPITAL)) / float(time_horizon)) if pre_wealth > 0 else float('nan')
            post_log_ann = float(np.log(max(float(post_wealth), 1e-12) / float(INITIAL_CAPITAL)) / float(time_horizon)) if post_wealth > 0 else float('nan')
            tax_drag_log_ann = float(pre_log_ann - post_log_ann) if np.isfinite(pre_log_ann) and np.isfinite(post_log_ann) else float('nan')

            strat_decomp = _extract_strategy_decomposition_from_metadata(
                sim_result=sim_result,
                strategy_id=sid,
                years=time_horizon
            )
            if strat_decomp is None:
                decomp_samples.append({
                    'underlying_log_ann': float('nan'),
                    'vol_drag_log_ann': float('nan'),
                    'financing_log_ann': float('nan'),
                    'fees_log_ann': float('nan'),
                    'tracking_log_ann': float('nan'),
                    'taxes_log_ann': float(-tax_drag_log_ann) if np.isfinite(tax_drag_log_ann) else float('nan'),
                    'post_tax_log_ann': post_log_ann
                })
            else:
                decomp_samples.append({
                    'underlying_log_ann': float(strat_decomp.get('underlying_log_ann', np.nan)),
