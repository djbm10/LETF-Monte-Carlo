                'total_tax': float(total_tax)
            })
        
        # Convert to numpy array
        post_tax_wealths = np.array(post_tax_wealths)
        
        # Step 2: Now take percentiles from BOTH distributions.
        # IMPORTANT: tax_paid must use element-wise (paired) differences, not
        # independent percentile subtraction.  pre_P50 - post_P50 comes from two
        # different ranked paths; high-return paths have disproportionately high
        # taxes, so independent subtraction systematically understates tax drag.
        # Correct: percentile of (wealth[i] - post_tax[i]) across all paths.
        paired_taxes = wealth - post_tax_wealths  # element-wise, same sim path

        pcts = {}

        for pname, pval in [('p10',10), ('p25',25), ('p40',40), ('median',50), ('p60',60), ('p75',75), ('p90',90)]:
            pre_wealth = np.percentile(wealth, pval)
