        'frequency_topology',
        regime_params.get(REGIME_BEAR, {}).get('frequency', 0.08)
    ))
    if not np.isfinite(p_bear):
        p_bear = min(0.08, p_stress * 0.5)
    p_bear = float(np.clip(p_bear, 0.0, p_stress))

    vix_anchor_arr = None
