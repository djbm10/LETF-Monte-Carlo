def _scale_execution_realism_snapshot(base_snapshot: Dict[str, Any], scale: float) -> Dict[str, Any]:
    s = float(np.clip(scale, 0.40, 2.20))
    out = copy.deepcopy(base_snapshot) if isinstance(base_snapshot, dict) else {}
    if not out:
        return out

    # Higher s -> more frictions and lower executable depth.
    out['enabled'] = bool(base_snapshot.get('enabled', True))
    out['delay_prob'] = {
        int(k): float(np.clip(float(v) * (0.75 + 0.60 * s), 0.0, 0.95))
        for k, v in dict(base_snapshot.get('delay_prob', {})).items()
    }
    out['fill_mean'] = {
        int(k): float(np.clip(float(v) - 0.18 * (s - 1.0), 0.35, 0.999))
        for k, v in dict(base_snapshot.get('fill_mean', {})).items()
    }
    out['fill_std'] = {
        int(k): float(np.clip(float(v) * (0.80 + 0.55 * s), 0.001, 0.30))
        for k, v in dict(base_snapshot.get('fill_std', {})).items()
    }
    out['liquidity_cap'] = {
        int(k): float(np.clip(float(v) / (0.80 + 0.45 * s), 0.02, 1.50))
        for k, v in dict(base_snapshot.get('liquidity_cap', {})).items()
    }
    out['delay_bps'] = {
        int(k): float(np.clip(float(v) * s, 0.0, 50.0))
        for k, v in dict(base_snapshot.get('delay_bps', {})).items()
    }
    out['fill_uncertainty_bps'] = {
        int(k): float(np.clip(float(v) * s, 0.0, 80.0))
        for k, v in dict(base_snapshot.get('fill_uncertainty_bps', {})).items()
    }
    out['unfilled_opportunity_bps'] = float(np.clip(float(base_snapshot.get('unfilled_opportunity_bps', EXECUTION_UNFILLED_OPPORTUNITY_BPS)) * s, 0.0, 80.0))
    out['vix_unfilled_bps'] = float(np.clip(float(base_snapshot.get('vix_unfilled_bps', EXECUTION_VIX_UNFILLED_BPS)) * s, 0.0, 80.0))
    out['scale'] = float(s)
    return out


