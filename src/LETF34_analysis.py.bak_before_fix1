    out['applied'] = bool(apply_tuned)
    out['selected_te_scale'] = float(selected_te)
    out['selected_exec_scale'] = float(selected_exec)
    out['feasible_selected'] = bool(selected_row.get('feasible', False))
    out['drawdown_constraint_passed'] = bool(dd_pass)
    out['drawdown_constraint'] = dd_diag
    out['baseline_score_key'] = tuple(base_row['score_key'])
    out['selected_score_key'] = tuple(selected_row['score_key'])
    out['selection_reason'] = str(selected_reason)
    out['institutional_strict'] = strict_diag
    out['baseline_tracking_error_mean'] = float(base_row.get('tracking_error_mean', float('inf')))
    out['baseline_vol_weighted_error_sum'] = float(base_row.get('vol_weighted_error_sum', float('inf')))
    out['baseline_slippage_error_rel'] = float(base_row.get('slippage_error_rel', float('inf')))
    out['selected_tracking_error_mean'] = float(selected_row.get('tracking_error_mean', float('inf')))
    out['selected_vol_weighted_error_sum'] = float(selected_row.get('vol_weighted_error_sum', float('inf')))
    out['selected_slippage_error_rel'] = float(selected_row.get('slippage_error_rel', float('inf')))
    out['slippage_target'] = slippage_target
    out['tracking_targets'] = te_targets
    out['strategy_vol_reference'] = real_vol_ref
    out['candidates'] = [
        {
            'te_scale': float(r['te_scale']),
            'exec_scale': float(r['exec_scale']),
            'feasible': bool(r['feasible']),
            'strategies_compared': int(r['strategies_compared']),
