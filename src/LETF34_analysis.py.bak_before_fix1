                min_turnover=1e-4
            )
            if traded:
                num_trades += 1
                if trade_journal:
                    asset_price = df[f'{asset}_Price'].iloc[i]
                    portfolio_val = equity_curve.iloc[i-1]
                    trade_journal.log_allocation_change(
