        error_counts = Counter(r.get('error_type', 'Unknown') for r in errors)
        valid = total - len(errors)
        print(f"\n  Strategy: {sid}")
        print(f"    Total Sims:       {total}")
        print(f"    Valid Sims:       {valid}")
        print(f"    Genuine Ruins:    {len(ruins)}")
        print(f"    Technical Errors: {len(errors)}")
        print(f"    Error Breakdown:")
        for etype, count in error_counts.items():
            print(f"      {etype}: {count}")
        if len(errors) / total > _WARN_THRESHOLD:
            print(f"    ⚠️  WARNING: error rate {len(errors)/total:.1%} exceeds 5% threshold")
    if not any_errors:
        print(f"  ✓ No technical errors across all strategies")
    # ─────────────────────────────────────────────────────────────────────────

    return all_results


