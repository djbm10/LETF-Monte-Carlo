def _max_drawdown_from_returns(returns: np.ndarray) -> float:
    """Max drawdown from daily return series (negative decimal, e.g. -0.35)."""
    arr = np.asarray(returns, dtype=float)
    arr = arr[np.isfinite(arr)]
    if len(arr) == 0:
        return float('nan')
    wealth = np.cumprod(1.0 + arr)
    peak = np.maximum.accumulate(wealth)
    dd = (wealth / np.maximum(peak, 1e-12)) - 1.0
    return float(np.nanmin(dd))


def _drawdown_profile_from_returns(returns: np.ndarray) -> Dict[str, Any]:
    """
    Drawdown depth/duration/recovery profile for one return path.
    """
    arr = np.asarray(returns, dtype=float)
    arr = arr[np.isfinite(arr)]
    if len(arr) == 0:
        return {
            'max_dd': float('nan'),
            'drawdown_duration_days': float('nan'),
            'recovery_days': float('nan'),
            'recovered': False
        }

    wealth = np.cumprod(1.0 + arr)
    peak = np.maximum.accumulate(np.maximum(wealth, 1e-12))
    dd = wealth / peak - 1.0

    trough_idx = int(np.nanargmin(dd))
    max_dd = float(dd[trough_idx])
    peak_idx = int(np.argmax(wealth[:trough_idx + 1]))
    peak_level = float(peak[trough_idx])

    recovery_idx = None
    for i in range(trough_idx + 1, len(wealth)):
        if wealth[i] >= peak_level:
            recovery_idx = i
            break

    if recovery_idx is None:
        duration_days = len(wealth) - 1 - peak_idx
        recovery_days = len(wealth) - 1 - trough_idx
        recovered = False
    else:
        duration_days = recovery_idx - peak_idx
        recovery_days = recovery_idx - trough_idx
        recovered = True

    return {
        'max_dd': max_dd,
        'drawdown_duration_days': int(max(0, duration_days)),
        'recovery_days': int(max(0, recovery_days)),
        'recovered': bool(recovered)
    }


