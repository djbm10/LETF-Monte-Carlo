def compute_transaction_costs(daily_ret, regime, leverage, trade_size_pct=0.0,
                              vix_level: Optional[float] = None,
                              liquidity_stress: Optional[float] = None,
                              credit_stress: Optional[float] = None):
    """
    Enhanced transaction costs with regime-dependent slippage.
    
    Args:
        daily_ret: Daily return
        regime: Market regime (0=normal, 1=shock, 2=bear)
        leverage: Leverage ratio
        trade_size_pct: Trade size as % of portfolio (0-1)
    
    Returns:
        Total cost as decimal (e.g., 0.001 = 10 bps)
    """
    # Base bid-ask spread
    spread_bps = BASE_SPREAD_BPS.get(int(regime), BASE_SPREAD_BPS.get(REGIME_BEAR, 10))
    vix_level = float(vix_level) if (vix_level is not None and np.isfinite(vix_level)) else 20.0
    liq = float(liquidity_stress) if (liquidity_stress is not None and np.isfinite(liquidity_stress)) else np.clip((vix_level - 20.0) / 15.0, 0.0, 3.0)
    cred = float(credit_stress) if (credit_stress is not None and np.isfinite(credit_stress)) else np.clip((vix_level - 25.0) / 12.0, 0.0, 3.0)

    spread_bps *= (1.0 + 0.12 * np.clip(liq, 0.0, 3.0) + 0.08 * np.clip(cred, 0.0, 3.0))
    spread_cost = spread_bps / 10000
    
    # Rebalancing cost (internal fund rebalancing)
    rebalance_cost = REBALANCE_COST_PER_DOLLAR * leverage * abs(daily_ret)
    rebalance_cost *= (1.0 + 0.10 * np.clip(liq, 0.0, 3.0))
    
    # ========================================================================
    # MARKET IMPACT / SLIPPAGE (Regime-Dependent)
    # ========================================================================
    # Large trades in illiquid regimes have significant market impact
    # Uses square-root model with regime multipliers
    
    if trade_size_pct > 0.01:  # Only apply to trades >1% of portfolio
        # Regime multipliers for slippage (calm / shock / bear)
        regime_multiplier = {
            0: 1.0,   # Calm market - standard liquidity
            1: 2.0,   # Shock - widest spreads
            2: 1.6,   # Bear - persistently stressed liquidity
        }.get(int(regime), 1.3)
        
        # Square-root scaling for market impact
        # Larger trades have disproportionate impact
        size_multiplier = 1 + np.sqrt(trade_size_pct) * 2
        
        # Additional slippage
        stress_multiplier = 1.0 + 0.12 * np.clip(liq, 0.0, 3.0) + 0.08 * np.clip(cred, 0.0, 3.0)
        market_impact = spread_cost * (regime_multiplier - 1) * (size_multiplier - 1) * stress_multiplier
    else:
        market_impact = 0
    
    total_cost = spread_cost + rebalance_cost + market_impact
    
    return total_cost


def _execution_seed(strategy_id: str, day_index: int, asset: str) -> int:
    """Deterministic per-day seed so execution realism is reproducible."""
    sid = 0
    for i, ch in enumerate(str(strategy_id)):
        sid = (sid * 131 + (i + 1) * ord(ch)) & 0x7FFFFFFF
    aid = 0
    for i, ch in enumerate(str(asset)):
        aid = (aid * 97 + (i + 3) * ord(ch)) & 0x7FFFFFFF
    return int((sid ^ aid ^ ((int(day_index) + 1) * 2654435761)) & 0x7FFFFFFF)


def _resolve_execution_stress_inputs(df: pd.DataFrame, day_index: int) -> Tuple[float, float, float]:
    """Return (vix, liquidity_stress, credit_stress) for execution-cost modeling."""
    if day_index < 0 or day_index >= len(df):
        return 20.0, 0.0, 0.0

    vix = float(df['VIX'].iloc[day_index]) if 'VIX' in df.columns and np.isfinite(df['VIX'].iloc[day_index]) else 20.0
    liq = float(df['Stress_Liquidity'].iloc[day_index]) if 'Stress_Liquidity' in df.columns and np.isfinite(df['Stress_Liquidity'].iloc[day_index]) else np.clip((vix - 20.0) / 15.0, 0.0, 3.0)
    cred = float(df['Stress_Credit'].iloc[day_index]) if 'Stress_Credit' in df.columns and np.isfinite(df['Stress_Credit'].iloc[day_index]) else np.clip((vix - 25.0) / 12.0, 0.0, 3.0)
    return float(vix), float(np.clip(liq, 0.0, 3.0)), float(np.clip(cred, 0.0, 3.0))


def apply_execution_realism_to_target(prev_allocation: float,
                                      target_allocation: float,
                                      day_index: int,
                                      strategy_id: str,
                                      asset: str,
                                      daily_ret_proxy: float,
                                      leverage: float,
                                      regime: int,
                                      df: pd.DataFrame,
                                      min_turnover: float = 1e-4) -> Tuple[float, float, float, bool]:
    """
    Apply delay/partial-fill/liquidity-cap realism and return:
      (effective_allocation, execution_cost, executed_turnover, trade_occurred)
    """
    target = float(target_allocation)
    prev = float(prev_allocation)
    turnover = abs(target - prev)
    if turnover <= float(max(min_turnover, 0.0)):
        return prev, 0.0, 0.0, False

    if not EXECUTION_REALISM_ENABLED:
        c = compute_transaction_costs(daily_ret_proxy, regime, leverage, trade_size_pct=turnover)
        return target, float(c), float(turnover), True

    vix, liq, cred = _resolve_execution_stress_inputs(df, day_index)
    rng = np.random.default_rng(_execution_seed(strategy_id=strategy_id, day_index=day_index, asset=asset))

    base_delay_prob = float(EXECUTION_DELAY_PROB.get(int(regime), 0.04))
    delay_prob = float(np.clip(base_delay_prob + 0.025 * liq + 0.015 * cred, 0.0, 0.95))
    delayed = bool(rng.random() < delay_prob)
    delay_fill_mult = float(rng.uniform(0.55, 0.90)) if delayed else 1.0

    fill_mean = float(EXECUTION_FILL_MEAN.get(int(regime), 0.90))
    fill_std = float(EXECUTION_FILL_STD.get(int(regime), 0.05))
    fill_draw = float(np.clip(rng.normal(fill_mean, fill_std), 0.20, 1.00))
    fill_draw *= float(np.clip(1.0 - 0.07 * liq - 0.05 * cred, 0.15, 1.00))

    liq_cap = float(EXECUTION_LIQUIDITY_CAP.get(int(regime), 0.40))
    liq_cap = float(np.clip(liq_cap - 0.08 * liq - 0.05 * cred, 0.05, 1.50))

    executed_turnover = float(min(turnover * fill_draw * delay_fill_mult, liq_cap))
    direction = np.sign(target - prev)
    effective_allocation = float(prev + direction * executed_turnover)
    # Keep inside min/max requested interval to avoid overshoot from numerical noise.
    lo = min(prev, target)
    hi = max(prev, target)
    effective_allocation = float(np.clip(effective_allocation, lo, hi))

    unfilled = float(max(turnover - executed_turnover, 0.0))
    base_cost = compute_transaction_costs(
        daily_ret=daily_ret_proxy,
        regime=regime,
        leverage=leverage,
        trade_size_pct=executed_turnover,
        vix_level=vix,
        liquidity_stress=liq,
        credit_stress=cred
    )
    delay_cost = (float(EXECUTION_DELAY_BPS.get(int(regime), 1.0)) / 10000.0) * executed_turnover if delayed else 0.0
    fill_uncertainty = abs(float(rng.normal(0.0, float(EXECUTION_FILL_UNCERTAINTY_BPS.get(int(regime), 1.0)) / 10000.0)))
    uncertainty_cost = fill_uncertainty * executed_turnover
    unfilled_bps = float(EXECUTION_UNFILLED_OPPORTUNITY_BPS + EXECUTION_VIX_UNFILLED_BPS * np.clip((vix - 20.0) / 20.0, 0.0, 3.0))
    unfilled_cost = (unfilled_bps / 10000.0) * unfilled

    total_cost = float(base_cost + delay_cost + uncertainty_cost + unfilled_cost)
    return effective_allocation, total_cost, executed_turnover, True

def run_strategy_fixed(df, strategy_id, regime_path, correlation_matrices, 
                       apply_costs=True, trade_journal=None):
    """
    FIX #4: Run strategy with LEVERAGE DRIFT TRACKING for portfolios.
    FIX BUG: Handle regime_path mismatch by inferring from VIX if needed.
    """
    # ========================================================================
    # BUG FIX: Handle regime path mismatch between Sim vs Historical
    # ========================================================================
    if regime_path is None or len(regime_path) != len(df):
        if 'VIX' in df.columns:
            # Infer regime from probabilistic stress model (same logic as calibration)
            realized_vol = df['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0) * np.sqrt(252)
            term_spread = None
            if 'TNX' in df.columns and 'IRX' in df.columns:
                term_spread = (df['TNX'] - df['IRX']).values
            regime_path = infer_regime_from_vix(
                vix_series=df['VIX'].values,
                realized_vol=realized_vol.values,
                term_spread=term_spread,
                spy_returns=df['SPY_Ret'].values,
                recession_proxy=df['USREC'].values if 'USREC' in df.columns else None
            )
        else:
            # Fallback if no VIX
            regime_path = np.zeros(len(df), dtype=int)
            
    config = STRATEGIES[strategy_id]
    strategy_type = config['type']
    num_trades = 0
    
    # Benchmark strategies
    if strategy_type == 'benchmark':
        asset = config['asset']
        ret_col = f'{asset}_Ret'
        
        if ret_col not in df.columns:
            return pd.Series(INITIAL_CAPITAL, index=df.index), 0
        
        returns = df[ret_col].fillna(0)
        equity_curve = INITIAL_CAPITAL * (1 + returns).cumprod()
        
        return equity_curve, 0
    
    # SMA strategies
    if strategy_type == 'sma' or strategy_type == 'sma_band':
        asset = config['asset']
        ret_col = f'{asset}_Ret'
        
        if ret_col not in df.columns:
            return pd.Series(INITIAL_CAPITAL, index=df.index), 0
        
        sma_period = config.get('sma_period', 200)
        
        position = pd.Series(0, index=df.index, dtype=int)
        spy_price_prev = df['SPY_Price'].shift(1)
        sma_prev = df['SPY_Price'].rolling(sma_period, min_periods=1).mean().shift(1)
        
        if strategy_type == 'sma':
            buy_signal = spy_price_prev >= sma_prev
            sell_signal = spy_price_prev < sma_prev
        else:
            band = config.get('band', 0.02)
            buy_signal = spy_price_prev >= sma_prev * (1 - band)
            sell_signal = spy_price_prev < sma_prev * (1 - band)
        
        buy_signal = buy_signal.fillna(False)
        sell_signal = sell_signal.fillna(False)
        
        for i in range(1, len(df)):
            if position.iloc[i-1] == 0:
                position.iloc[i] = 1 if buy_signal.iloc[i] else 0
            else:
                position.iloc[i] = 0 if sell_signal.iloc[i] else 1
        
        position_changes = position.diff().abs()
        num_trades = int(position_changes.sum())
        
        equity_curve = pd.Series(INITIAL_CAPITAL, index=df.index, dtype=float)
        target_leverage = ASSETS[asset]['leverage']
        
        for i in range(1, len(df)):
            if position.iloc[i] == 1:
                ret = df[ret_col].iloc[i]
            else:
                ret = df['Cash_Ret'].iloc[i]
            
            if apply_costs and position_changes.iloc[i] > 0:
                # FIX: regime_path is now guaranteed to match len(df)
                regime = regime_path[i]
                cost = compute_transaction_costs(
                    df[ret_col].iloc[i],
                    regime,
                    target_leverage
                )
                ret -= cost
            
            equity_curve.iloc[i] = equity_curve.iloc[i-1] * (1 + ret)
        
        return equity_curve, num_trades
    
    # FIX #4: Portfolio strategies with LEVERAGE DRIFT TRACKING
    if strategy_type == 'portfolio':
        assets_weights = config['assets']
        rebalance_freq = config.get('rebalance_freq', 21)
        
        # Track individual LETF positions AND their embedded leverage
        positions = {asset: INITIAL_CAPITAL * weight 
                    for asset, weight in assets_weights.items()}
        
        # Track embedded leverage of each position
        # (leverage drifts as underlying moves)
        embedded_leverage = {asset: ASSETS[asset]['leverage'] 
                            for asset in assets_weights.keys()}
        
        equity_curve = pd.Series(INITIAL_CAPITAL, index=df.index, dtype=float)
        
        for i in range(1, len(df)):
            # Update each position (value changes, leverage drifts)
            total_value_before = sum(positions.values())
            
            for asset in assets_weights.keys():
                ret_col = f'{asset}_Ret'
                if ret_col in df.columns:
                    ret = df[ret_col].iloc[i]
                    
                    # Position value changes
                    old_value = positions[asset]
                    new_value = old_value * (1 + ret)
                    positions[asset] = new_value
                    
                    # Embedded leverage drifts
                    # If underlying moves r%, embedded leverage becomes L*(1+r)/(1+L*r)
                    # This is approximate - good enough for simulation
                    target_leverage = ASSETS[asset]['leverage']
                    if target_leverage > 1.0:
                        # Simplified leverage drift (exact formula is complex)
                        underlying_ret = ret / target_leverage  # Approximate
                        if abs(1 + target_leverage * underlying_ret) > 0.01:
                            embedded_leverage[asset] = target_leverage * (1 + underlying_ret) / (1 + target_leverage * underlying_ret)
                        else:
                            embedded_leverage[asset] = target_leverage
                    else:
                        embedded_leverage[asset] = 1.0
            
            total_value = sum(positions.values())
            equity_curve.iloc[i] = total_value
            
            # Rebalance
            if i % rebalance_freq == 0:
                # Current weights
                current_weights = {asset: positions[asset] / total_value 
                                 for asset in assets_weights.keys()}
                
                # Turnover (weight changes)
