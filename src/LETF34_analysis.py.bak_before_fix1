def _score_spy_realism_candidate(drawdown_diag: Dict[str, Any],
                                 vol_diag: Dict[str, Any]) -> Dict[str, Any]:
    """
    Lexicographic score for constrained SPY core tuning.
    Priority:
      1) drawdown episode feasibility
      2) volatility feasibility
      3) drawdown miss severity
      4) vol-percentile absolute error sum
    """
    events = drawdown_diag.get('events', {}) if isinstance(drawdown_diag, dict) else {}
    dd_miss_count = 0
    dd_penalty = 0.0
    for e in events.values():
        real_mdd = float(e.get('real_mdd', np.nan))
        p1 = float(e.get('sim_p1', np.nan))
        p99 = float(e.get('sim_p99', np.nan))
        if not (np.isfinite(real_mdd) and np.isfinite(p1) and np.isfinite(p99)):
            continue
        gap = 0.0
        if real_mdd < p1:
            gap = float(p1 - real_mdd)
        elif real_mdd > p99:
            gap = float(real_mdd - p99)
        if gap > 0:
            dd_miss_count += 1
            dd_penalty += gap ** 2

    vol_err = (vol_diag or {}).get('abs_errors', {}) if isinstance(vol_diag, dict) else {}
    vol_err_sum = float(np.nansum([
        float(vol_err.get('p25', np.nan)),
        float(vol_err.get('p50', np.nan)),
        float(vol_err.get('p75', np.nan)),
        float(vol_err.get('p95', np.nan))
    ]))
    if not np.isfinite(vol_err_sum):
        vol_err_sum = float('inf')

    dd_pass = bool((drawdown_diag or {}).get('all_passed', False))
    vol_pass = bool((vol_diag or {}).get('passed', False))
    feasible = bool(dd_pass and vol_pass)

    score_key = (
        0 if feasible else 1,
        int(dd_miss_count),
        0 if vol_pass else 1,
        float(dd_penalty),
        float(vol_err_sum)
    )
    return {
        'feasible': feasible,
        'drawdown_passed': dd_pass,
        'volatility_passed': vol_pass,
        'drawdown_miss_count': int(dd_miss_count),
        'drawdown_penalty': float(dd_penalty),
        'vol_error_sum': float(vol_err_sum),
        'score_key': score_key
    }


def _build_stress_model_with_crash_severity(stress_model: Dict[str, Any],
                                            severity_scale: float) -> Dict[str, Any]:
    """
    Generate a severity-scaled stress model candidate for constrained tuning.
    """
    s = float(np.clip(severity_scale, 0.60, 1.80))
    out = copy.deepcopy(stress_model) if isinstance(stress_model, dict) else {}
    crash = dict(out.get('crash_micro_state', {}))
    if not crash:
        return out

    depth_scale = float(np.clip(s, 0.70, 1.60))
    prob_scale = float(np.clip(s ** 1.35, 0.55, 2.80))
    sigma_scale = float(np.clip(1.0 + 0.70 * (s - 1.0), 0.70, 1.90))
    cap_scale = float(np.clip(s ** 1.20, 0.60, 2.50))
    dur_scale = float(np.clip(1.0 + 0.45 * (s - 1.0), 0.75, 1.45))

    for k in ['depth_min', 'depth_mid', 'depth_max']:
        if k in crash and np.isfinite(float(crash[k])):
            crash[k] = float(np.clip(float(crash[k]) * depth_scale, 0.05, 0.92))
    crash['depth_min'] = float(np.clip(crash.get('depth_min', 0.30), 0.05, 0.90))
    crash['depth_mid'] = float(np.clip(max(crash.get('depth_mid', 0.35), crash['depth_min'] + 1e-4), 0.06, 0.93))
    crash['depth_max'] = float(np.clip(max(crash.get('depth_max', 0.40), crash['depth_mid'] + 1e-4), 0.07, 0.95))

    for k in ['duration_min_days', 'duration_mode_days', 'duration_max_days']:
        if k in crash and np.isfinite(float(crash[k])):
            crash[k] = int(np.clip(round(float(crash[k]) * dur_scale), 5, 120))
    crash['duration_min_days'] = int(max(5, crash.get('duration_min_days', 20)))
    crash['duration_mode_days'] = int(max(crash['duration_min_days'], crash.get('duration_mode_days', 28)))
    crash['duration_max_days'] = int(max(crash['duration_mode_days'] + 1, crash.get('duration_max_days', 38)))

    if 'daily_sigma' in crash:
        crash['daily_sigma'] = float(np.clip(float(crash['daily_sigma']) * sigma_scale, 0.0010, 0.0200))
    for k in [
        'start_prob_base',
        'start_prob_stress_boost',
        'start_prob_vix_coef',
        'start_prob_vix_jump_coef',
        'start_prob_liq_coef',
        'start_prob_credit_coef',
        'start_prob_neg_jump_coef'
    ]:
        if k in crash and np.isfinite(float(crash[k])):
            crash[k] = float(np.clip(float(crash[k]) * prob_scale, 0.0, 0.50))
    if 'start_prob_cap' in crash:
        crash['start_prob_cap'] = float(np.clip(float(crash['start_prob_cap']) * cap_scale, 0.001, 0.10))

    if 'activation_vix_jump' in crash:
        crash['activation_vix_jump'] = float(np.clip(
            float(crash['activation_vix_jump']) * (1.0 - 0.12 * (s - 1.0)), 2.0, 20.0
        ))
    if 'activation_neg_jump' in crash:
        crash['activation_neg_jump'] = float(np.clip(
            float(crash['activation_neg_jump']) * (1.0 - 0.25 * (s - 1.0)), 0.01, 0.20
        ))
    if 'activation_vix_level' in crash:
        crash['activation_vix_level'] = float(np.clip(
            float(crash['activation_vix_level']) * (1.0 - 0.10 * (s - 1.0)), 25.0, 90.0
        ))
    if 'start_day_impact_min' in crash:
        crash['start_day_impact_min'] = float(np.clip(float(crash['start_day_impact_min']) * depth_scale, 0.0, 0.20))
    if 'start_day_impact_max' in crash:
        crash['start_day_impact_max'] = float(np.clip(float(crash['start_day_impact_max']) * depth_scale, 0.0, 0.30))
    if 'daily_return_floor' in crash:
        floor_mag = abs(float(crash['daily_return_floor'])) * (1.0 + 0.35 * (s - 1.0))
        crash['daily_return_floor'] = float(-np.clip(floor_mag, 0.01, 0.80))

    # Mildly scale stress-regime jump channels so crash-window realism is not
    # forced through crash-state probabilities alone.
    jump_prob_mult = float(np.clip(1.0 + 0.55 * (s - 1.0), 0.70, 2.20))
    jump_scale_mult = float(np.clip(1.0 + 0.40 * (s - 1.0), 0.75, 1.90))
    for reg in STRESS_REGIME_IDS:
        rp = dict(out.get('regimes', {}).get(reg, {}))
        if 'jump_base_prob' in rp:
            rp['jump_base_prob'] = float(np.clip(float(rp['jump_base_prob']) * jump_prob_mult, 0.001, 0.20))
        if 'jump_scale' in rp:
            rp['jump_scale'] = float(np.clip(float(rp['jump_scale']) * jump_scale_mult, 0.01, 0.60))
        if 'regimes' in out and isinstance(out['regimes'], dict):
            out['regimes'][reg] = rp

    crash['severity_scale'] = float(s)
    out['crash_micro_state'] = crash
    return out


def tune_spy_crash_state_constrained(df: pd.DataFrame,
                                     regime_model: Dict[str, Any],
                                     severity_grid: Optional[List[float]] = None,
                                     dd_n_sims: int = STAGE_A_CRASH_DD_SIMS,
                                     vol_n_sims: int = STAGE_A_CRASH_VOL_SIMS,
                                     refine: bool = STAGE_A_CRASH_REFINE) -> Dict[str, Any]:
    """
    Stage A:
      Tune stress-state crash micro-process under constrained SPY realism gates.
      Goal: satisfy drawdown episodes while minimizing volatility percentile error.
    """
    out: Dict[str, Any] = {
        'enabled': True,
        'applied': False,
        'selected_scale': 1.0,
        'baseline_scale': 1.0,
        'feasible_selected': False,
        'candidates': [],
        'stress_state_model': regime_model.get('stress_state_model', None)
    }
    stress_model = regime_model.get('stress_state_model', None)
    if not isinstance(stress_model, dict) or 'crash_micro_state' not in stress_model:
        out['enabled'] = False
        out['reason'] = 'missing_stress_model_or_crash_micro_state'
        return out

    grid = list(severity_grid) if isinstance(severity_grid, list) and len(severity_grid) > 0 else list(STAGE_A_CRASH_SEVERITY_GRID)
    grid = sorted({float(np.clip(x, 0.60, 1.80)) for x in grid} | {1.0})
    tested: Set[float] = set()
    rows: List[Dict[str, Any]] = []

    def _eval_scale(scale: float) -> Dict[str, Any]:
        sm = _build_stress_model_with_crash_severity(stress_model, scale)
        rm_eval = dict(regime_model)
        rm_eval['stress_state_model'] = sm
        dd_diag = _compute_spy_drawdown_episode_metrics(df=df, regime_model=rm_eval, n_sims=dd_n_sims)
        vol_diag = _compute_spy_volatility_percentile_metrics(df=df, regime_model=rm_eval, n_sims=vol_n_sims)
        score = _score_spy_realism_candidate(drawdown_diag=dd_diag, vol_diag=vol_diag)
        row = {
            'scale': float(scale),
            'score_key': tuple(score['score_key']),
            'feasible': bool(score['feasible']),
            'drawdown_passed': bool(score['drawdown_passed']),
            'volatility_passed': bool(score['volatility_passed']),
            'drawdown_miss_count': int(score['drawdown_miss_count']),
            'drawdown_penalty': float(score['drawdown_penalty']),
            'vol_error_sum': float(score['vol_error_sum']),
            'drawdown': dd_diag,
            'volatility': vol_diag,
            'stress_state_model': sm
        }
        return row

    for s in grid:
        tested.add(float(s))
        rows.append(_eval_scale(float(s)))

    best_row = min(rows, key=lambda x: (tuple(x['score_key']), abs(float(x['scale']) - 1.0)))

    if refine and np.isfinite(float(best_row.get('scale', 1.0))):
        s0 = float(best_row['scale'])
        local = sorted({
            float(np.clip(s0 - 0.10, 0.60, 1.80)),
            float(np.clip(s0 - 0.06, 0.60, 1.80)),
            float(np.clip(s0 - 0.03, 0.60, 1.80)),
            float(np.clip(s0 + 0.03, 0.60, 1.80)),
            float(np.clip(s0 + 0.06, 0.60, 1.80)),
            float(np.clip(s0 + 0.10, 0.60, 1.80)),
        })
        for s in local:
            if s in tested:
                continue
            tested.add(float(s))
            rows.append(_eval_scale(float(s)))
        best_row = min(rows, key=lambda x: (tuple(x['score_key']), abs(float(x['scale']) - 1.0)))

    base_row = min([r for r in rows if abs(float(r['scale']) - 1.0) < 1e-10], key=lambda x: tuple(x['score_key']))
    apply_tuned = bool(tuple(best_row['score_key']) < tuple(base_row['score_key']))
    selected_row = best_row if apply_tuned else base_row

    out['applied'] = bool(apply_tuned)
    out['selected_scale'] = float(selected_row['scale'])
    out['baseline_scale'] = 1.0
    out['feasible_selected'] = bool(selected_row.get('feasible', False))
    out['baseline_score_key'] = tuple(base_row['score_key'])
    out['selected_score_key'] = tuple(selected_row['score_key'])
    out['selected_drawdown'] = selected_row.get('drawdown', {})
    out['selected_volatility'] = selected_row.get('volatility', {})
    out['stress_state_model'] = selected_row.get('stress_state_model', stress_model)
    out['candidates'] = [
        {
            'scale': float(r['scale']),
            'score_key': tuple(r['score_key']),
            'feasible': bool(r['feasible']),
            'drawdown_passed': bool(r['drawdown_passed']),
            'volatility_passed': bool(r['volatility_passed']),
            'drawdown_miss_count': int(r['drawdown_miss_count']),
            'drawdown_penalty': float(r['drawdown_penalty']),
            'vol_error_sum': float(r['vol_error_sum']),
        }
        for r in sorted(rows, key=lambda x: (tuple(x['score_key']), abs(float(x['scale']) - 1.0)))
    ]

    sel_dd = out['selected_drawdown']
    sel_vol = out['selected_volatility']
    sel_err = float(np.nansum([float((sel_vol.get('abs_errors', {}) or {}).get(k, np.nan)) for k in ['p25', 'p50', 'p75', 'p95']]))
    print("  Stage A (SPY crash-state constrained tuning):")
    print(f"    baseline score={out['baseline_score_key']}  selected score={out['selected_score_key']}")
    print(f"    selected severity scale={out['selected_scale']:.3f}  applied={out['applied']}")
    print(f"    selected drawdown pass={bool(sel_dd.get('all_passed', False))}  "
          f"selected vol pass={bool(sel_vol.get('passed', False))}  vol_err_sum={sel_err:.6f}")
    return out


