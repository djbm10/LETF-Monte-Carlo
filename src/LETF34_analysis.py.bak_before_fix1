    mdds = []
    vols = []
    stress_shares = []
    spy_paths: List[np.ndarray] = []

    # Validation-horizon tail alignment: match jump/crash intensity to the
    # target stress occupancy of the evaluated OOS window.
    stress_model_eval = stress_state_model
    target_share_global = float(np.clip(float(target_stress_share), 0.0, 1.0)) if target_stress_share is not None and np.isfinite(float(target_stress_share)) else None
    if isinstance(stress_state_model, dict) and target_share_global is not None:
        # Dampen tails in low/moderate-stress windows; do not exceed baseline tails.
        tail_mult = float(np.clip(0.20 + 2.00 * target_share_global, 0.30, 1.00))
        if abs(tail_mult - 1.0) > 0.03:
            stress_model_eval = copy.deepcopy(stress_state_model)
            for rid, rp in stress_model_eval.get('regimes', {}).items():
                if not isinstance(rp, dict):
                    continue
                jb = float(rp.get('jump_base_prob', 0.0))
                js = float(rp.get('jump_scale', 0.0))
                rp['jump_base_prob'] = float(np.clip(jb * tail_mult, 0.0005, 0.12))
                rp['jump_scale'] = float(np.clip(js * (0.72 + 0.48 * tail_mult), 0.010, 0.25))
            crash_cfg = stress_model_eval.get('crash_micro_state', None)
            if isinstance(crash_cfg, dict):
                prob_mult = float(np.clip(tail_mult ** 1.35, 0.35, 1.65))
                depth_mult = float(np.clip(0.78 + 0.32 * tail_mult, 0.70, 1.20))
                for k in ['start_prob_base', 'start_prob_stress_boost', 'start_prob_vix_coef',
                          'start_prob_vix_jump_coef', 'start_prob_liq_coef', 'start_prob_credit_coef',
                          'start_prob_neg_jump_coef', 'start_prob_cap']:
                    if k in crash_cfg:
                        crash_cfg[k] = float(max(0.0, float(crash_cfg[k]) * prob_mult))
                for k in ['depth_min', 'depth_mid', 'depth_max', 'start_day_impact_min', 'start_day_impact_max']:
                    if k in crash_cfg:
                        crash_cfg[k] = float(max(0.0, float(crash_cfg[k]) * depth_mult))

    for i in range(int(n_sims)):
        rng_path = np.random.default_rng(seed + i * 37 + 11)
        if start_regime_override is not None:
            start_regime = int(np.clip(int(start_regime_override), 0, N_REGIMES - 1))
        else:
            _u = rng_path.random()
            if _u < p_bear:
                start_regime = REGIME_BEAR
            elif _u < p_stress:
                start_regime = REGIME_HIGH_VOL
            else:
                start_regime = REGIME_LOW
        target_share = None
        if target_stress_share is not None and np.isfinite(float(target_stress_share)):
            target_share = float(np.clip(float(target_stress_share), 0.0, 1.0))
        if target_share is not None:
            # Extreme stress windows (e.g., crisis slices) require stress-state starts;
            # otherwise transition odds from calm can under-shoot observed occupancy.
            if target_share >= 0.65:
                start_regime = REGIME_BEAR
            elif target_share >= 0.45 and start_regime == REGIME_LOW:
                start_regime = REGIME_HIGH_VOL
        if target_share is not None:
            tol_eff = float(np.clip(target_tolerance, 0.02, 0.20))
            if target_share < 0.35:
                tol_eff = float(min(tol_eff, 0.03))
            reg_path, _ = draw_regime_path_targeted(
                total_days=n_days,
                start_regime=start_regime,
                transition_matrix=transition_matrix,
                duration_samples=duration_samples,
                base_seed=int(seed + i * 37 + 11),
                calm_scale_factor=base_calm_scale,
                crisis_scale_factor=base_crisis_scale,
                target_crisis_share=target_share,
                target_tolerance=tol_eff,
                max_attempts=36
            )
        else:
            reg_path = simulate_regime_path_semi_markov(
                total_days=n_days,
                start_regime=start_regime,
                transition_matrix=transition_matrix,
                duration_samples=duration_samples,
                rng=rng_path,
                calm_scale_factor=base_calm_scale,
                crisis_scale_factor=base_crisis_scale
            )
        stress_shares.append(float(_stress_share(np.asarray(reg_path, dtype=int))))

        base = generate_fat_tailed_returns(
            n_days=n_days,
            regime_path=reg_path,
            regime_params=regime_params,
            bootstrap_sampler=None,
            vix_dynamics=vix_dynamics,
            joint_return_model=joint_return_model,
            sim_engine_mode='institutional_v1',
            seed=seed + i * 53 + 19
        )
        spy = np.asarray(base.get('SPY_Ret', np.zeros(n_days)), dtype=float)
        vix = np.asarray(base.get('VIX', np.full(n_days, 20.0)), dtype=float)

        # Moderate-stress windows often require narrower vol dispersion:
        # boost calm-state variance slightly and temper stress-state variance.
        if target_share_global is not None and 0.12 <= target_share_global <= 0.32:
            blend = float(np.clip((0.32 - target_share_global) / 0.20, 0.0, 1.0))
            if blend > 1e-6:
                reg_arr = np.asarray(reg_path, dtype=int)
                stress_mask = np.isin(reg_arr, np.asarray(STRESS_REGIME_IDS, dtype=int))
                calm_scale = float(1.0 + 0.45 * blend)
                stress_scale = float(max(0.45, 1.0 - 0.65 * blend))
                spy = np.where(stress_mask, spy * stress_scale, spy * calm_scale)

        if stress_model_eval is not None:
            ss_rng = np.random.default_rng(seed + i * 71 + 23)
            vix_for_jump = vix_anchor_arr if vix_anchor_arr is not None else vix
            stress_state = simulate_latent_stress_state(
                n_days=n_days,
                regime_path=reg_path,
                stress_model=stress_model_eval,
                vix_series=vix_for_jump,
                rng=ss_rng
            )
            spy = spy + stress_state.get('jump', np.zeros(n_days))
            cb_lev = 1.0
            if target_share_global is not None and target_share_global < 0.35:
                cb_lev = float(np.clip(0.55 + 0.90 * target_share_global, 0.55, 1.0))
            spy, _ = apply_state_dependent_circuit_breakers(
                returns=spy,
                regime_path=np.asarray(reg_path, dtype=int),
                vix_series=np.asarray(vix_for_jump, dtype=float),
                leverage=cb_lev,
                rng=np.random.default_rng(seed + i * 73 + 29),
                stress_state=stress_state,
                asset_class='equity'
            )

        mdd = _max_drawdown_from_returns(spy)
        vol = float(np.nanstd(spy) * np.sqrt(252))
        if np.isfinite(mdd) and np.isfinite(vol):
            mdds.append(mdd)
            vols.append(vol)
            if return_spy_paths:
                spy_paths.append(np.asarray(spy, dtype=float).copy())

    out = {
        'mdd': np.asarray(mdds, dtype=float),
        'vol': np.asarray(vols, dtype=float),
        'stress_share': np.asarray(stress_shares, dtype=float)
    }
    if return_spy_paths:
        out['spy_paths'] = np.asarray(spy_paths, dtype=float) if len(spy_paths) > 0 else np.zeros((0, int(n_days)), dtype=float)
    return out


def validate_simulated_max_drawdowns_vs_real(df: pd.DataFrame,
                                             regime_model: Dict) -> Dict[str, Any]:
    """
    Compare simulated max drawdowns to key real episodes (2008, 2020, 2022).
    """
    print(f"\n{'='*80}")
    print("VALIDATION: SIMULATED MAX DRAWDOWNS vs REAL EPISODES")
    print(f"{'='*80}\n")

    episodes = [
        ('GFC 2008-09', pd.Timestamp('2007-10-09'), pd.Timestamp('2009-03-09')),
        ('COVID 2020', pd.Timestamp('2020-02-19'), pd.Timestamp('2020-03-23')),
        ('Bear 2022', pd.Timestamp('2022-01-03'), pd.Timestamp('2022-10-12')),
    ]

    out = {'events': {}, 'all_passed': False, 'events_evaluated': 0}
    passes = []

    for label, start_dt, end_dt in episodes:
        if start_dt < df.index.min() or end_dt > df.index.max():
            print(f"  {label}: skipped (outside selected date range)")
            continue
        seg = df.loc[start_dt:end_dt, 'SPY_Ret'].dropna()
        if len(seg) < 20:
            print(f"  {label}: skipped (insufficient data)")
            continue

        seg_vix = np.full(len(seg), 20.0, dtype=float)
        if 'VIX' in df.columns:
            seg_vix = (
                df.loc[start_dt:end_dt, 'VIX']
                .reindex(seg.index)
                .ffill()
                .bfill()
                .fillna(20.0)
                .to_numpy(dtype=float)
            )

        seg_rv = (
            df['SPY_Ret']
            .rolling(20, min_periods=5)
            .std()
            .bfill()
            .fillna(0.0)
            .loc[start_dt:end_dt]
            .reindex(seg.index)
            .ffill()
            .bfill()
            .fillna(0.0)
            .to_numpy(dtype=float)
            * np.sqrt(252)
        )
        seg_ts = None
        if 'TNX' in df.columns and 'IRX' in df.columns:
            seg_ts = (
                (df['TNX'] - df['IRX'])
                .loc[start_dt:end_dt]
                .reindex(seg.index)
                .ffill()
                .bfill()
                .fillna(0.0)
                .to_numpy(dtype=float)
            )
        seg_rec = None
        if 'USREC' in df.columns:
            seg_rec = (
                df['USREC']
                .loc[start_dt:end_dt]
                .reindex(seg.index)
                .ffill()
                .bfill()
                .fillna(0.0)
                .to_numpy(dtype=float)
            )

        start_regime_hint = None
        try:
            seg_reg_path = infer_regime_from_vix(
                vix_series=seg_vix,
                realized_vol=seg_rv,
                term_spread=seg_ts,
                logit_shift=0.0,
                logit_params=STRESS_LOGIT_PARAMS,
                spy_returns=seg.values,
                recession_proxy=seg_rec
            )
            if len(seg_reg_path) > 0:
                head = np.asarray(seg_reg_path[:min(5, len(seg_reg_path))], dtype=int)
                stress_head = head[np.isin(head, np.asarray(STRESS_REGIME_IDS, dtype=int))]
                if len(stress_head) > 0:
                    start_regime_hint = int(stress_head[0])
                else:
                    start_regime_hint = int(seg_reg_path[0])
        except Exception:
            start_regime_hint = None

        real_mdd = _max_drawdown_from_returns(seg.values)
        sim = _simulate_spy_mdd_vol_distribution(
            regime_model=regime_model,
            n_days=len(seg),
            n_sims=700,
            seed=4401 + len(seg),
            vix_anchor=seg_vix,
            start_regime_override=start_regime_hint
        )
        sim_mdd = sim.get('mdd', np.array([]))
        if len(sim_mdd) < 50:
            print(f"  {label}: skipped (insufficient simulated paths)")
            continue

        p1, p5, p50, p95, p99 = np.percentile(sim_mdd, [1, 5, 50, 95, 99])
        pct_rank = float(np.mean(sim_mdd <= real_mdd) * 100.0)
        pass_event = bool(p1 <= real_mdd <= p99)
        passes.append(pass_event)

        out['events'][label] = {
            'start': str(start_dt.date()),
            'end': str(end_dt.date()),
            'days': int(len(seg)),
            'real_mdd': float(real_mdd),
            'start_regime_hint': int(start_regime_hint) if start_regime_hint is not None else None,
            'sim_p1': float(p1),
            'sim_p5': float(p5),
            'sim_p50': float(p50),
            'sim_p95': float(p95),
            'sim_p99': float(p99),
            'real_percentile_in_sim': pct_rank,
            'passed': pass_event
        }
        print(f"  {label}:")
        print(f"    Real max DD: {real_mdd*100:.1f}% | Sim P1/P50/P99: {p1*100:.1f}% / {p50*100:.1f}% / {p99*100:.1f}%")
        print(f"    Real percentile in sim DD dist: P{pct_rank:.1f}  -> {'PASS' if pass_event else 'FAIL'}")

    out['events_evaluated'] = len(passes)
    out['all_passed'] = bool(len(passes) > 0 and all(passes))
    print(f"\n  {'✓' if out['all_passed'] else '✗'} Drawdown episode validation "
          f"({'passed' if out['all_passed'] else 'failed'}) across {out['events_evaluated']} episode(s)")
    print(f"\n{'='*80}\n")
    return out


def validate_simulated_volatility_vs_real(df: pd.DataFrame,
                                          regime_model: Dict) -> Dict[str, Any]:
    """Compare simulated annualized SPY volatility distribution to real rolling vol."""
    print(f"\n{'='*80}")
    print("VALIDATION: SIMULATED VOLATILITY vs REAL ROLLING VOL")
    print(f"{'='*80}\n")

    real_vol = (df['SPY_Ret'].rolling(252, min_periods=200).std() * np.sqrt(252)).dropna().to_numpy(dtype=float)
    if len(real_vol) > 0:
        real_vol = real_vol[::21]  # monthly stride to reduce overlap weight
    if len(real_vol) < 30:
        print("  Skipped: insufficient real rolling volatility windows")
        print(f"\n{'='*80}\n")
        return {'passed': False, 'reason': 'insufficient_real_windows'}

    sim = _simulate_spy_mdd_vol_distribution(
        regime_model=regime_model,
        n_days=252,
        n_sims=900,
        seed=5201
    )
    sim_vol = sim.get('vol', np.array([]))
    if len(sim_vol) < 100:
        print("  Skipped: insufficient simulated volatility samples")
        print(f"\n{'='*80}\n")
        return {'passed': False, 'reason': 'insufficient_sim_samples'}

    pct_keys = [25, 50, 75, 95]
    real_pct = {f"p{k}": float(np.percentile(real_vol, k)) for k in pct_keys}
    sim_pct = {f"p{k}": float(np.percentile(sim_vol, k)) for k in pct_keys}
    err = {k: float(abs(sim_pct[k] - real_pct[k])) for k in real_pct}

    pass_test = bool(
        err['p50'] <= 0.03 and
        err['p25'] <= 0.04 and
        err['p75'] <= 0.04 and
        err['p95'] <= 0.06
    )

    print(f"  Real vol percentiles:  P25={real_pct['p25']*100:.1f}%  P50={real_pct['p50']*100:.1f}%  "
          f"P75={real_pct['p75']*100:.1f}%  P95={real_pct['p95']*100:.1f}%")
    print(f"  Sim vol percentiles:   P25={sim_pct['p25']*100:.1f}%  P50={sim_pct['p50']*100:.1f}%  "
          f"P75={sim_pct['p75']*100:.1f}%  P95={sim_pct['p95']*100:.1f}%")
    print(f"  Abs errors (vol pts):  P25={err['p25']*100:.2f}  P50={err['p50']*100:.2f}  "
          f"P75={err['p75']*100:.2f}  P95={err['p95']*100:.2f}")
    print(f"\n  {'✓' if pass_test else '✗'} Volatility distribution validation "
          f"{'passed' if pass_test else 'failed'}")
    print(f"\n{'='*80}\n")

    return {
        'passed': pass_test,
        'real_percentiles': real_pct,
        'sim_percentiles': sim_pct,
        'abs_errors': err,
        'n_real_windows': int(len(real_vol)),
        'n_sim_paths': int(len(sim_vol))
    }


