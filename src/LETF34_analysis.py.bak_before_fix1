            'slippage_model_bps': float(r['slippage_model_bps']) if np.isfinite(float(r['slippage_model_bps'])) else float('nan'),
            'score_key': tuple(r['score_key']),
        }
        for r in sorted(candidate_rows, key=lambda x: tuple(x['score_key']))
    ]
    print("  Stage C (TE + execution constrained tuning):")
    print(f"    baseline score={out['baseline_score_key']}  selected score={out['selected_score_key']}")
    print(f"    selected te_scale={out['selected_te_scale']:.3f}  selected exec_scale={out['selected_exec_scale']:.3f}  "
          f"applied={out['applied']}  drawdown constraint pass={out['drawdown_constraint_passed']}  "
          f"reason={out['selection_reason']}")
    print(f"    selected vol_weighted={out['selected_vol_weighted_error_sum']:.6f}  "
          f"selected te_error={out['selected_tracking_error_mean']:.6f}  "
          f"selected slippage_rel={out['selected_slippage_error_rel']:.6f}")
    return out


def _save_leveraged_fit_plots(asset: str,
                              dates: pd.DatetimeIndex,
                              real_returns: np.ndarray,
                              modeled_returns: np.ndarray,
                              rolling_vol_window: int = 63) -> List[str]:
    """Save fit diagnostics plots and return file paths."""
    out_paths: List[str] = []
    if len(real_returns) == 0 or len(modeled_returns) == 0:
        return out_paths

    plot_dir = Path(VALIDATION_PLOT_DIR)
    plot_dir.mkdir(parents=True, exist_ok=True)

    real_wealth = np.cumprod(1.0 + np.asarray(real_returns, dtype=float))
    modeled_wealth = np.cumprod(1.0 + np.asarray(modeled_returns, dtype=float))

    # Cumulative wealth fit.
    fig, ax = plt.subplots(figsize=(10, 5))
    ax.plot(dates, real_wealth, label='Real', linewidth=1.6)
    ax.plot(dates, modeled_wealth, label='Modeled', linewidth=1.6, alpha=0.9)
    ax.set_title(f'{asset}: Real vs Modeled Cumulative Return')
    ax.set_ylabel('Growth of $1')
    ax.grid(alpha=0.25)
    ax.legend(loc='best')
    p1 = plot_dir / f'{asset.lower()}_fit_cumulative.png'
    fig.tight_layout()
    fig.savefig(p1, dpi=140)
    plt.close(fig)
    out_paths.append(str(p1))

    # Daily return scatter.
    fig, ax = plt.subplots(figsize=(6, 6))
    ax.scatter(real_returns, modeled_returns, s=8, alpha=0.35)
    lim = np.nanpercentile(np.abs(np.concatenate([real_returns, modeled_returns])), 99)
    lim = float(max(lim, 0.02))
    ax.plot([-lim, lim], [-lim, lim], color='black', linewidth=1.0, linestyle='--')
    ax.set_xlim(-lim, lim)
    ax.set_ylim(-lim, lim)
    ax.set_xlabel('Real Daily Return')
    ax.set_ylabel('Modeled Daily Return')
    ax.set_title(f'{asset}: Daily Return Fit')
    ax.grid(alpha=0.25)
    p2 = plot_dir / f'{asset.lower()}_fit_scatter.png'
    fig.tight_layout()
    fig.savefig(p2, dpi=140)
    plt.close(fig)
    out_paths.append(str(p2))

    # Rolling annualized volatility fit.
    if len(real_returns) >= rolling_vol_window + 5:
        real_roll_vol = pd.Series(real_returns, index=dates).rolling(rolling_vol_window).std() * np.sqrt(252)
        mod_roll_vol = pd.Series(modeled_returns, index=dates).rolling(rolling_vol_window).std() * np.sqrt(252)
        fig, ax = plt.subplots(figsize=(10, 5))
        ax.plot(real_roll_vol.index, real_roll_vol.values, label='Real 63d ann vol', linewidth=1.4)
        ax.plot(mod_roll_vol.index, mod_roll_vol.values, label='Modeled 63d ann vol', linewidth=1.4, alpha=0.9)
        ax.set_title(f'{asset}: Rolling Annualized Volatility Fit')
        ax.set_ylabel('Annualized Volatility')
        ax.grid(alpha=0.25)
        ax.legend(loc='best')
        p3 = plot_dir / f'{asset.lower()}_fit_rolling_vol.png'
        fig.tight_layout()
        fig.savefig(p3, dpi=140)
        plt.close(fig)
        out_paths.append(str(p3))

    return out_paths


def validate_leveraged_real_fit_metrics(df: pd.DataFrame,
                                        regime_model: Dict,
                                        years: int = 10,
                                        save_plots: bool = True) -> Dict[str, Any]:
    """
    Real-only leveraged fit diagnostics:
    - Daily R²/correlation
    - Tracking error (annualized)
    - Volatility and max drawdown alignment
    - Fit plots (cumulative, scatter, rolling vol)
    """
    print(f"\n{'='*80}")
    print("VALIDATION: REAL-ONLY LEVERAGED FIT DIAGNOSTICS")
    print(f"{'='*80}\n")

    funding_model = regime_model.get('funding_model', {}) if isinstance(regime_model, dict) else {}
    tracking_model = regime_model.get('tracking_residual_model', {}) if isinstance(regime_model, dict) else {}
    assets = [a for a in ['TQQQ', 'UPRO', 'SSO', 'QLD'] if f'{a}_Real_Ret' in df.columns]

    out: Dict[str, Any] = {
        'assets': {},
        'assets_evaluated': 0,
        'passed_assets': 0,
        'passed': False,
        'plot_dir': str(VALIDATION_PLOT_DIR)
    }
    pass_flags: List[bool] = []

    for asset in assets:
        modeled = _model_real_leveraged_returns(
            df=df,
            asset=asset,
            funding_model=funding_model,
            tracking_model=tracking_model,
            spread_scale=1.0,
            te_scale=1.0,
            underlying_scale=1.0,
            alpha_daily=0.0,
            min_days=max(252, int(years * 252)),
            seed=11311 + sum(ord(c) for c in asset)
        )
        if modeled is None:
            print(f"  {asset}: skipped (insufficient real-only data)")
            continue

        real_r = np.asarray(modeled['real_returns'], dtype=float)
        sim_r = np.asarray(modeled['modeled_returns'], dtype=float)
        dates = pd.DatetimeIndex(modeled['index'])
        if len(real_r) < 120:
            print(f"  {asset}: skipped (too few daily observations)")
            continue

        resid = sim_r - real_r
        sse = float(np.sum(resid ** 2))
        sst = float(np.sum((real_r - np.mean(real_r)) ** 2))
        r2 = float(1.0 - sse / sst) if sst > 1e-12 else 0.0
        corr = float(np.corrcoef(real_r, sim_r)[0, 1]) if (np.std(real_r) > 1e-12 and np.std(sim_r) > 1e-12) else 0.0
        corr = float(corr) if np.isfinite(corr) else 0.0
        rmse = float(np.sqrt(np.mean(resid ** 2)))
        mae = float(np.mean(np.abs(resid)))
        tracking_error_ann = float(np.std(real_r - sim_r, ddof=1) * np.sqrt(252)) if len(real_r) > 2 else float('nan')
        real_ann_vol = float(np.std(real_r, ddof=1) * np.sqrt(252))
        sim_ann_vol = float(np.std(sim_r, ddof=1) * np.sqrt(252))
        vol_abs_error = float(abs(sim_ann_vol - real_ann_vol))
        real_mdd = _max_drawdown_from_returns(real_r)
        sim_mdd = _max_drawdown_from_returns(sim_r)
        mdd_abs_error = float(abs(sim_mdd - real_mdd)) if np.isfinite(real_mdd) and np.isfinite(sim_mdd) else float('nan')

        # Rolling volatility alignment.
        rv = pd.Series(real_r, index=dates).rolling(63).std() * np.sqrt(252)
        sv = pd.Series(sim_r, index=dates).rolling(63).std() * np.sqrt(252)
        both = pd.concat([rv, sv], axis=1).dropna()
        if len(both) > 20:
            roll_vol_corr = float(np.corrcoef(both.iloc[:, 0].values, both.iloc[:, 1].values)[0, 1])
            roll_vol_rmse = float(np.sqrt(np.mean((both.iloc[:, 1].values - both.iloc[:, 0].values) ** 2)))
        else:
            roll_vol_corr = float('nan')
            roll_vol_rmse = float('nan')

        # Practical pass thresholds: path-level realism, not exact replication.
        asset_pass = bool(
            r2 >= -0.20 and
            corr >= 0.60 and
            np.isfinite(tracking_error_ann) and tracking_error_ann <= 0.60 and
            vol_abs_error <= 0.08 and
            (not np.isfinite(mdd_abs_error) or mdd_abs_error <= 0.25)
        )
        pass_flags.append(asset_pass)

        plot_paths: List[str] = []
        if save_plots:
            plot_paths = _save_leveraged_fit_plots(
                asset=asset,
                dates=dates,
                real_returns=real_r,
                modeled_returns=sim_r
            )

        out['assets'][asset] = {
            'n_days': int(len(real_r)),
            'r2': r2,
            'corr': corr,
            'tracking_error_ann': tracking_error_ann,
            'rmse_daily': rmse,
            'mae_daily': mae,
            'real_ann_vol': real_ann_vol,
            'sim_ann_vol': sim_ann_vol,
            'vol_abs_error': vol_abs_error,
            'real_max_drawdown': real_mdd,
            'sim_max_drawdown': sim_mdd,
            'max_drawdown_abs_error': mdd_abs_error,
            'rolling_vol_corr_63d': roll_vol_corr if np.isfinite(roll_vol_corr) else None,
            'rolling_vol_rmse_63d': roll_vol_rmse if np.isfinite(roll_vol_rmse) else None,
            'plots': plot_paths,
            'passed': asset_pass
        }

        print(f"  {asset}: R2={r2:.3f}  corr={corr:.3f}  TE={tracking_error_ann*100:.2f}%  "
              f"vol_err={vol_abs_error*100:.2f}%  mdd_err={mdd_abs_error*100:.1f}%  "
              f"{'PASS' if asset_pass else 'FAIL'}")

    out['assets_evaluated'] = int(len(out['assets']))
    out['passed_assets'] = int(sum(1 for v in out['assets'].values() if v.get('passed', False)))
    required = min(2, out['assets_evaluated']) if out['assets_evaluated'] > 0 else 0
    out['passed'] = bool(out['assets_evaluated'] > 0 and out['passed_assets'] >= required)

    print(f"\n  {'✓' if out['passed'] else '✗'} Leveraged real-fit diagnostics "
          f"{'passed' if out['passed'] else 'failed'} "
          f"({out['passed_assets']}/{out['assets_evaluated']} assets)")
    if save_plots:
        print(f"  Fit plots saved to: {VALIDATION_PLOT_DIR}")
    print(f"\n{'='*80}\n")
    return out


def validate_leverage_level_stress_test(n_sims: int = 3000,
                                        n_days: int = 252,
                                        annual_mu: float = 0.08,
                                        annual_vol: float = 0.18) -> Dict[str, Any]:
    """
    Stress-test leverage mechanics across long/inverse 1x/2x/3x.
    Includes:
    - Vol scaling check (annualized vol should scale ~|L|)
    - Flat-market (0% underlying) decay formula check
    """
    print(f"\n{'='*80}")
    print("VALIDATION: LEVERAGE LEVEL STRESS TEST (±1x/±2x/±3x)")
    print(f"{'='*80}\n")

    levels = [1.0, 2.0, 3.0, -1.0, -2.0, -3.0]
    rng = np.random.default_rng(20260221)
    mu_d = annual_mu / 252.0
    vol_d = annual_vol / np.sqrt(252.0)
    under = rng.normal(mu_d, vol_d, size=(int(n_sims), int(n_days)))
    base_vol = np.std(under, axis=1, ddof=1) * np.sqrt(252.0)

    out: Dict[str, Any] = {
        'levels': {},
        'vol_scaling_passed': True,
        'flat_formula_passed': True,
        'passed': False
    }

    for lev in levels:
        lev_ret = lev * under
        lev_vol = np.std(lev_ret, axis=1, ddof=1) * np.sqrt(252.0)
        vol_ratio = float(np.nanmedian(lev_vol / np.clip(base_vol, 1e-8, None)))
        vol_ratio_err = float(abs(vol_ratio - abs(lev)))
        one_year_total = np.prod(1.0 + lev_ret, axis=1) - 1.0
        median_return = float(np.median(one_year_total))
        p10 = float(np.percentile(one_year_total, 10))
        p90 = float(np.percentile(one_year_total, 90))
        vol_pass = bool(vol_ratio_err <= 0.18)
        if not vol_pass:
            out['vol_scaling_passed'] = False

        # Flat-market formula check with financing+expense costs.
        expense = 0.0095
        rf = 0.04
        spread = 0.005
        borrow_daily = max(abs(lev) - 1.0, 0.0) * (rf + spread) / 252.0
        daily = compute_letf_return_correct(0.0, lev, 0.0, expense, borrow_daily)
        flat_path = (1.0 + daily) ** 252 - 1.0
        flat_expected = (1.0 - expense / 252.0 - borrow_daily) ** 252 - 1.0
        flat_err = float(abs(flat_path - flat_expected))
        flat_pass = bool(flat_err <= 1e-12)
        if not flat_pass:
            out['flat_formula_passed'] = False

        out['levels'][f'{lev:+.0f}x'] = {
            'median_1y_return': median_return,
            'p10_1y_return': p10,
            'p90_1y_return': p90,
            'vol_ratio_median': vol_ratio,
            'vol_ratio_error': vol_ratio_err,
            'vol_scaling_passed': vol_pass,
            'flat_formula_error': flat_err,
            'flat_formula_passed': flat_pass
        }

        print(f"  {lev:+.0f}x: vol_ratio={vol_ratio:.2f} (target {abs(lev):.2f})  "
              f"median_1y={median_return*100:+.2f}%  "
              f"flat_formula_err={flat_err:.2e}  "
              f"{'PASS' if (vol_pass and flat_pass) else 'FAIL'}")

    out['passed'] = bool(out['vol_scaling_passed'] and out['flat_formula_passed'])
    print(f"\n  {'✓' if out['passed'] else '✗'} Leverage stress suite "
          f"{'passed' if out['passed'] else 'failed'}")
    print(f"\n{'='*80}\n")
    return out


def run_institutional_sanity_checks(regime_model: Dict, funding_model: Dict,
                                    tracking_residual_model: Dict) -> Dict:
    """Deterministic structural checks for transition rows, seed uniqueness, GJR stationarity, and funding feature activation."""
    checks = {
        'transition_matrix_finite': False,
        'transition_matrix_row_stochastic': False,
        'transition_matrix_nonnegative': False,
        'te_seed_collision_free': False,
        'tracking_model_params_valid': False,
        'gjr_stationarity_valid': False,
        'crisis_frequency_in_bounds': False,
        'crisis_duration_in_bounds': False,
        'funding_vix_activates': False,
        'funding_inv_curve_activates': False,
        'funding_liquidity_activates': False,
        'funding_credit_activates': False,
        'all_passed': False
    }

    tm = np.asarray(regime_model.get('transition_matrix', np.array([])), dtype=float)
    if tm.size > 0:
        row_sums = tm.sum(axis=1)
        checks['transition_matrix_finite'] = bool(np.isfinite(tm).all())
        checks['transition_matrix_row_stochastic'] = bool(np.allclose(row_sums, 1.0, atol=1e-6))
        checks['transition_matrix_nonnegative'] = bool((tm >= -1e-12).all())

    assets = sorted(list(ASSETS.keys()))
    seeds = [_stable_asset_seed(12345, a) for a in assets]
    checks['te_seed_collision_free'] = len(seeds) == len(set(seeds))

    # Validate calibrated tracking residual params are finite and in sane bounds
    te_ok = True
    for a, p in (tracking_residual_model or {}).items():
        rho = float(p.get('rho', np.nan))
        scale = float(p.get('base_scale', np.nan))
        dfv = float(p.get('df', np.nan))
        if (not np.isfinite(rho)) or (rho < 0.0) or (rho > 0.9):
            te_ok = False
            break
        if (not np.isfinite(scale)) or (scale <= 0.0):
            te_ok = False
            break
        if (not np.isfinite(dfv)) or (dfv <= 2.0):
            te_ok = False
            break
    checks['tracking_model_params_valid'] = te_ok

    # GJR stationarity: (α + γ/2)×ν/(ν-2) + β < 1 for every regime.
    # Enforced during calibration but can be violated in hand-edited or stale caches.
    # Reading from joint_return_model stored inside regime_model.
    jrm = regime_model.get('joint_return_model', {})
    gjr_ok = True
    if jrm and 'regimes' in jrm:
        for _rid, _rp in jrm['regimes'].items():
            _alpha = float(_rp.get('garch_alpha', 0.0))
            _beta  = float(_rp.get('garch_beta',  0.0))
            _gamma = float(_rp.get('garch_gamma', 0.0))
            _nu    = float(_rp.get('nu', 6.0))
            _eff   = (_alpha + 0.5 * _gamma) * _nu / (_nu - 2.0) + _beta if _nu > 2.0 else float('inf')
            if _eff >= 1.0:
                gjr_ok = False
                break
    else:
        gjr_ok = False   # model absent — cannot verify
    checks['gjr_stationarity_valid'] = gjr_ok

    # Stress realism bounds: fail if shock/bear labeling drifts into implausible frequency/duration.
    rp = regime_model.get('regime_params', {})
    shock_p = rp.get(REGIME_HIGH_VOL, {})
    bear_p = rp.get(REGIME_BEAR, {})
    stress_freq = _regime_frequency_from_params(rp, tuple(STRESS_REGIME_IDS), use_topology=True)
    shock_med_days = float(shock_p.get('duration_median_days', np.nan))
    bear_med_days = float(bear_p.get('duration_median_days', np.nan))
    bear_p90_days = float(bear_p.get('duration_p90_days', np.nan))

    checks['crisis_frequency_in_bounds'] = bool(np.isfinite(stress_freq) and 0.03 <= stress_freq <= 0.40)
    checks['crisis_duration_in_bounds'] = bool(
        np.isfinite(shock_med_days) and np.isfinite(bear_med_days) and np.isfinite(bear_p90_days) and
        3.0 <= shock_med_days <= 90.0 and
        30.0 <= bear_med_days <= 520.0 and
        60.0 <= bear_p90_days <= 1260.0
    )
    checks['crisis_regime_diagnostics'] = {
        'stress_frequency_topology_pct': round(stress_freq * 100.0, 2) if np.isfinite(stress_freq) else None,
        'shock_frequency_pct': round(float(shock_p.get('frequency_topology', shock_p.get('frequency', np.nan))) * 100.0, 2)
        if np.isfinite(float(shock_p.get('frequency_topology', shock_p.get('frequency', np.nan)))) else None,
        'bear_frequency_pct': round(float(bear_p.get('frequency_topology', bear_p.get('frequency', np.nan))) * 100.0, 2)
        if np.isfinite(float(bear_p.get('frequency_topology', bear_p.get('frequency', np.nan)))) else None,
        'shock_median_days': round(shock_med_days, 1) if np.isfinite(shock_med_days) else None,
        'bear_median_days': round(bear_med_days, 1) if np.isfinite(bear_med_days) else None,
        'bear_p90_days': round(bear_p90_days, 1) if np.isfinite(bear_p90_days) else None
    }

    base_df = pd.DataFrame({'VIX': [20.0] * 10, 'IRX': [4.0] * 10, 'TNX': [5.2] * 10})
    low_state = {'liquidity': np.zeros(10), 'credit': np.zeros(10)}
    base_spread = float(np.nanmean(predict_borrow_spread_series(base_df, funding_model, stress_state=low_state)))

    # Magnitude-based checks: require the spread increase to be economically meaningful,
    # not just directionally positive.  Thresholds are set well below the economic floors
    # enforced in calibrate_funding_spread_model() so any reasonable calibration passes,
    # but a model with near-zero betas fails.
    #
    # Scenario          VIX stress     inv_curve stress   liq stress     cred stress
    # Δ at floor        ≥37.5 bps      ≥6 bps             ≥3 bps est.    ≥12.5 bps
    # Required Δ        ≥10 bps        ≥3 bps             ≥3 bps         ≥5 bps
    # (All deltas in decimal, e.g. 0.001 = 10 bps)

    hi_vix_df = base_df.copy()
    hi_vix_df['VIX'] = 45.0   # +25 VIX points above baseline (20 → 45)
    hi_vix_spread = float(np.nanmean(predict_borrow_spread_series(hi_vix_df, funding_model, stress_state=low_state)))
    _vix_delta = hi_vix_spread - base_spread
    checks['funding_vix_activates'] = _vix_delta >= 0.001   # ≥ 10 bps for 25-pt VIX spike

    inv_df = base_df.copy()
    inv_df['TNX'] = 2.8   # TNX 5.2 → 2.8: term_spread IRX-TNX inverts by 1.4%
    inv_spread = float(np.nanmean(predict_borrow_spread_series(inv_df, funding_model, stress_state=low_state)))
    _inv_delta = inv_spread - base_spread
    checks['funding_inv_curve_activates'] = _inv_delta >= 0.0003   # ≥ 3 bps for 1.4% inversion

    hi_liq_state = {'liquidity': np.ones(10) * 2.5, 'credit': np.zeros(10)}
    liq_spread = float(np.nanmean(predict_borrow_spread_series(base_df, funding_model, stress_state=hi_liq_state)))
    _liq_delta = liq_spread - base_spread
    checks['funding_liquidity_activates'] = _liq_delta >= 0.0003   # ≥ 3 bps for 2.5-unit stress

    hi_cred_state = {'liquidity': np.zeros(10), 'credit': np.ones(10) * 2.5}
    cred_spread = float(np.nanmean(predict_borrow_spread_series(base_df, funding_model, stress_state=hi_cred_state)))
    _cred_delta = cred_spread - base_spread
    checks['funding_credit_activates'] = _cred_delta >= 0.0005   # ≥ 5 bps for 2.5-unit stress

    # Store deltas (bps) as informational diagnostics — not booleans, excluded from all_passed.
    checks['funding_deltas_bps'] = {
        'vix_25pt':       round(_vix_delta  * 10000, 1),
        'inv_curve_14pct': round(_inv_delta  * 10000, 1),
        'liquidity_25':   round(_liq_delta  * 10000, 1),
        'credit_25':      round(_cred_delta * 10000, 1),
    }

    checks['all_passed'] = all(v for k, v in checks.items()
                               if k != 'all_passed' and isinstance(v, bool))
    return checks


def run_rolling_oos_calibration_backtest(df: pd.DataFrame, n_splits: int = 3,
                                         train_years: int = 8, test_years: int = 2) -> Dict:
    """Rolling out-of-sample harness for funding/tracking calibration drift diagnostics."""
    window_train = int(train_years * 252)
    window_test = int(test_years * 252)
    total_needed = window_train + window_test

    out = {
        'splits_run': 0,
        'splits_requested': n_splits,
        'funding_mae_mean': float('nan'),
        'tracking_residual_std_mean': float('nan'),
        'funding_beta_vix_drift': float('nan'),
        'sufficient_data': False
    }

    if len(df) < total_needed + 252:
        return out

    starts = np.linspace(0, len(df) - total_needed, n_splits, dtype=int)
    funding_maes = []
    residual_stds = []
    beta_vix_vals = []

    for start in starts:
        train_df = df.iloc[start:start + window_train].copy()
        test_df = df.iloc[start + window_train:start + window_train + window_test].copy()
        if len(train_df) < window_train or len(test_df) < window_test:
            continue

        funding = calibrate_funding_spread_model(train_df, bypass_cache=True)
        _tracking = calibrate_tracking_residual_model(train_df, funding_model=funding, bypass_cache=True)
        beta_vix_vals.append(float(funding.get('beta_vix', np.nan)))

        spread_input = pd.DataFrame({'VIX': test_df['VIX'].values, 'IRX': test_df.get('IRX', pd.Series(4.5, index=test_df.index)).values}, index=test_df.index)
        if 'TNX' in test_df.columns:
            spread_input['TNX'] = test_df['TNX'].values
        test_spread = predict_borrow_spread_series(spread_input, funding)
        naive_spread = np.full(len(test_df), funding['base'])
        funding_maes.append(float(np.nanmean(np.abs(test_spread - naive_spread))))

        rstds = []
        for asset in ['TQQQ', 'UPRO', 'SSO', 'QLD']:
            ret_col = f'{asset}_Real_Ret'
            if ret_col not in test_df.columns:
                continue
            idx = test_df['QQQ_Ret'] if (asset in ['TQQQ', 'QLD'] and 'QQQ_Ret' in test_df.columns) else test_df['SPY_Ret']
            leverage = ASSETS[asset]['leverage']
            rf = test_df.get('IRX', pd.Series(4.5, index=test_df.index)).fillna(4.5).values / 100.0
            finance = (leverage - 1.0) * (rf + test_spread) / 252.0
            expected = leverage * idx.values - finance - ASSETS[asset]['expense_ratio'] / 252.0
            resid = test_df[ret_col].values - expected
            resid = resid[np.isfinite(resid)]
            if len(resid) > 20:
                rstds.append(float(np.nanstd(resid)))
        if rstds:
            residual_stds.append(float(np.nanmean(rstds)))

    if funding_maes:
        out['splits_run'] = len(funding_maes)
        out['funding_mae_mean'] = float(np.nanmean(funding_maes))
        out['tracking_residual_std_mean'] = float(np.nanmean(residual_stds)) if residual_stds else float('nan')
        if len(beta_vix_vals) >= 2:
            out['funding_beta_vix_drift'] = float(np.nanmax(beta_vix_vals) - np.nanmin(beta_vix_vals))
        out['sufficient_data'] = True

    return out


def _rolling_vol_samples_from_paths(spy_paths: np.ndarray,
                                    window: int = 252,
                                    min_periods: int = 200,
                                    stride: int = 21) -> np.ndarray:
    """Collect rolling annualized-vol samples from simulated SPY paths."""
    arr = np.asarray(spy_paths, dtype=float)
    if arr.ndim != 2 or arr.shape[0] == 0:
        return np.array([], dtype=float)
    vols: List[float] = []
    for p in arr:
        if len(p) < max(20, min_periods):
            continue
        rv = (pd.Series(p).rolling(int(window), min_periods=int(min_periods)).std() * np.sqrt(252)).dropna().to_numpy(dtype=float)
        if len(rv) == 0:
            continue
        vols.extend(rv[::max(1, int(stride))].tolist())
    return np.asarray(vols, dtype=float)


def _sample_size_matched_percentiles(sim_samples: np.ndarray,
                                     sample_size: int,
                                     percentiles: Tuple[int, ...] = (25, 50, 75, 95),
                                     n_boot: int = 240,
                                     seed: int = 123) -> Dict[str, float]:
    """
    Estimate simulated percentiles using bootstrap samples matched to the real-sample count.

    This avoids systematic inflation of high quantiles when simulation windows
    outnumber real windows by an order of magnitude.
    """
    arr = np.asarray(sim_samples, dtype=float)
    arr = arr[np.isfinite(arr)]
    if len(arr) == 0:
        return {f'p{p}': float('nan') for p in percentiles}

    n = int(max(8, sample_size))
    if len(arr) <= n:
        return {f'p{p}': float(np.percentile(arr, p)) for p in percentiles}

    rng = np.random.default_rng(int(seed + len(arr) + n * 37))
    b = int(max(40, n_boot))
    pct_vals = np.zeros((b, len(percentiles)), dtype=float)
    for i in range(b):
        draw = rng.choice(arr, size=n, replace=True)
        pct_vals[i, :] = np.percentile(draw, percentiles)
    return {f'p{p}': float(np.median(pct_vals[:, j])) for j, p in enumerate(percentiles)}


def _apply_window_joint_vol_alignment(window_df: pd.DataFrame,
                                      rm: Dict[str, Any]) -> Dict[str, Any]:
    """
    Train-window-only volatility alignment.

    Purpose: reduce walk-forward split volatility percentile drift by nudging the
    joint-return covariance scale toward the observed train-window SPY vol level.
    """
    out = {
        'applied': False,
        'target_vol': None,
        'model_vol_pre': None,
        'scale_raw': None,
        'scale_applied': None
    }
    if (not isinstance(rm, dict)
            or 'joint_return_model' not in rm
            or not isinstance(rm.get('joint_return_model'), dict)
            or 'SPY_Ret' not in window_df.columns):
        return out

    jm = rm.get('joint_return_model', {})
    if 'regimes' not in jm or not isinstance(jm['regimes'], dict):
        return out

    rv = (window_df['SPY_Ret'].rolling(252, min_periods=160).std() * np.sqrt(252)).dropna().to_numpy(dtype=float)
    if len(rv) > 0:
        rv = rv[::21]
    target_vol = float(np.percentile(rv, 50)) if len(rv) > 0 else float(np.nanstd(window_df['SPY_Ret'].to_numpy(dtype=float)) * np.sqrt(252))
    if (not np.isfinite(target_vol)) or target_vol <= 1e-8:
        return out

    reg_hist = np.asarray(rm.get('regimes_historical', np.array([])), dtype=int)
    model_var = 0.0
    for rid, rp in jm['regimes'].items():
        cov = np.asarray(rp.get('cov', np.eye(3)), dtype=float)
        if cov.shape[0] < 1 or cov.shape[1] < 1:
            continue
        if len(reg_hist) > 0:
            freq = float(np.mean(reg_hist == int(rid)))
        else:
            freq = float(rm.get('regime_params', {}).get(int(rid), {}).get('frequency_topology', 0.0))
        model_var += max(freq, 0.0) * float(max(cov[0, 0], 1e-12))
    model_vol_pre = float(np.sqrt(max(model_var * 252.0, 1e-12)))
    if (not np.isfinite(model_vol_pre)) or model_vol_pre <= 1e-8:
        return out

    scale_raw = float(np.clip(target_vol / model_vol_pre, 0.72, 1.40))
    # Walk-forward train windows are long enough to rely mostly on local fit.
    sample_w = float(np.clip((len(window_df) - 600) / 2500.0, 0.75, 1.00))
    scale = float(np.clip(1.0 + sample_w * (scale_raw - 1.0), 0.80, 1.35))

    if abs(scale - 1.0) < 0.02:
        out.update({
            'target_vol': float(target_vol),
            'model_vol_pre': float(model_vol_pre),
            'scale_raw': float(scale_raw),
            'scale_applied': 1.0
        })
        return out

    for rid, rp in jm['regimes'].items():
        cov = np.asarray(rp.get('cov', np.eye(3)), dtype=float)
        if cov.shape[0] < 3 or cov.shape[1] < 3:
            continue
        M = np.diag([scale, scale, 1.0])
        cov_new = M @ cov @ M
        sig = np.sqrt(np.clip(np.diag(cov_new), 1e-12, None))
        corr = cov_new / np.outer(sig, sig)
        corr = nearest_psd_matrix(corr)
        rp['cov'] = corr * np.outer(sig, sig)

    out.update({
        'applied': True,
        'target_vol': float(target_vol),
        'model_vol_pre': float(model_vol_pre),
        'scale_raw': float(scale_raw),
        'scale_applied': float(scale)
    })
    return out


def _apply_window_stress_tail_alignment(rm: Dict[str, Any]) -> Dict[str, Any]:
    """
    Window-local tail alignment for walk-forward calibration.

    Keeps crisis windows heavy-tailed while preventing moderate-stress windows
    from carrying full-crash tail intensity that inflates p95 volatility error.
    """
    out = {
        'applied': False,
        'stress_share_topology': None,
        'tail_scale_applied': None
    }
    if not isinstance(rm, dict):
        return out
    ssm = rm.get('stress_state_model', None)
    if not isinstance(ssm, dict) or 'regimes' not in ssm:
        return out

    stress_share = _regime_frequency_from_params(
        regime_params=rm.get('regime_params', {}),
        regime_ids=tuple(STRESS_REGIME_IDS),
        use_topology=True
    )
    if not np.isfinite(stress_share):
        return out

    # Low/moderate stress windows get damped tails; severe windows stay near full.
    tail_scale = float(np.clip(0.55 + 1.60 * float(stress_share), 0.55, 1.10))
    if abs(tail_scale - 1.0) < 0.03:
        out.update({
            'stress_share_topology': float(stress_share),
            'tail_scale_applied': float(tail_scale)
        })
        return out

    for rid, rp in ssm.get('regimes', {}).items():
        if not isinstance(rp, dict):
            continue
        jb = float(rp.get('jump_base_prob', 0.0))
        js = float(rp.get('jump_scale', 0.0))
        if int(rid) in STRESS_REGIME_IDS:
            reg_scale = float(np.clip(0.85 + 0.30 * tail_scale, 0.65, 1.20))
        else:
            reg_scale = float(np.clip(0.75 + 0.35 * tail_scale, 0.55, 1.05))
        rp['jump_base_prob'] = float(np.clip(jb * tail_scale * reg_scale, 0.0005, 0.12))
        rp['jump_scale'] = float(np.clip(js * (0.70 + 0.45 * tail_scale) * reg_scale, 0.010, 0.20))

    crash = ssm.get('crash_micro_state', None)
    if isinstance(crash, dict):
        crash_prob_scale = float(np.clip(0.65 + 0.55 * tail_scale, 0.50, 1.25))
        crash_depth_scale = float(np.clip(0.82 + 0.30 * tail_scale, 0.72, 1.18))
        for k in ['start_prob_base', 'start_prob_stress_boost', 'start_prob_vix_coef',
                  'start_prob_vix_jump_coef', 'start_prob_liq_coef', 'start_prob_credit_coef',
                  'start_prob_neg_jump_coef', 'start_prob_cap']:
            if k in crash:
                crash[k] = float(max(0.0, float(crash[k]) * crash_prob_scale))
        for k in ['depth_min', 'depth_mid', 'depth_max', 'start_day_impact_min', 'start_day_impact_max']:
            if k in crash:
                crash[k] = float(max(0.0, float(crash[k]) * crash_depth_scale))

    out.update({
        'applied': True,
        'stress_share_topology': float(stress_share),
        'tail_scale_applied': float(tail_scale)
    })
    return out


def _calibrate_full_regime_bundle_for_window(window_df: pd.DataFrame,
                                             tag: str) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:
    """
    Calibrate full regime/joint/stress bundle on one train window using only past data.
    """
    global REGIME_MODEL_CACHE, JOINT_RETURN_MODEL_CACHE, STRESS_STATE_CACHE
    global HIGH_VOL_LOGIT_SHIFT, STRESS_LOGIT_PARAMS

    old_regime_cache = REGIME_MODEL_CACHE
    old_joint_cache = JOINT_RETURN_MODEL_CACHE
    old_stress_cache = STRESS_STATE_CACHE
    old_shift = HIGH_VOL_LOGIT_SHIFT
    old_logit = dict(STRESS_LOGIT_PARAMS)

    tmp_tag = str(tag).replace(" ", "_")
    REGIME_MODEL_CACHE = Path(f"/tmp/{tmp_tag}_regime.pkl")
    JOINT_RETURN_MODEL_CACHE = Path(f"/tmp/{tmp_tag}_joint.pkl")
    STRESS_STATE_CACHE = Path(f"/tmp/{tmp_tag}_stress.pkl")
    for _p in [REGIME_MODEL_CACHE, JOINT_RETURN_MODEL_CACHE, STRESS_STATE_CACHE]:
        try:
            if _p.exists():
                _p.unlink()
        except Exception:
            pass

    try:
        # Keep walk-forward calibration quiet; diagnostics are collected separately.
        with contextlib.redirect_stdout(io.StringIO()):
            rm = calibrate_regime_model_volatility(window_df)
            rm['joint_return_model'] = calibrate_joint_return_model(window_df, rm['regimes_historical'])
            rm['stress_state_model'] = calibrate_stress_state_model(window_df, rm['regimes_historical'])

        # Window-specific alignments reduce split-level vol/tail drift.
        rm['window_stress_tail_alignment'] = _apply_window_stress_tail_alignment(rm=rm)
        rm['window_vol_alignment'] = _apply_window_joint_vol_alignment(window_df=window_df, rm=rm)
        refresh_scenario_calibration(df=window_df, regime_model=rm, verbose=False)
        return rm, None
    except Exception as e:
        return None, str(e)
    finally:
        REGIME_MODEL_CACHE = old_regime_cache
        JOINT_RETURN_MODEL_CACHE = old_joint_cache
        STRESS_STATE_CACHE = old_stress_cache
        HIGH_VOL_LOGIT_SHIFT = old_shift
        STRESS_LOGIT_PARAMS = dict(old_logit)


def _infer_start_regime_from_window(df_window: pd.DataFrame,
                                    rm: Dict[str, Any]) -> Optional[int]:
    """Infer start regime from recent observed window using calibrated stress classifier."""
    if df_window is None or len(df_window) == 0 or 'VIX' not in df_window.columns or 'SPY_Ret' not in df_window.columns:
        return None
    tail = df_window.iloc[max(0, len(df_window) - 63):].copy()
    if len(tail) < 5:
        return None
    rv_tail = (tail['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0.0).to_numpy(dtype=float) * np.sqrt(252))
    ts_tail = (tail['TNX'] - tail['IRX']).to_numpy(dtype=float) if 'TNX' in tail.columns and 'IRX' in tail.columns else None
    rec_tail = tail['USREC'].to_numpy(dtype=float) if 'USREC' in tail.columns else None
    regs_tail = infer_regime_from_vix(
        vix_series=tail['VIX'].to_numpy(dtype=float),
        realized_vol=rv_tail,
        term_spread=ts_tail,
        logit_shift=0.0,
        logit_params=rm.get('stress_logit_params', STRESS_LOGIT_PARAMS),
        spy_returns=tail['SPY_Ret'].to_numpy(dtype=float),
        recession_proxy=rec_tail
    )
    if len(regs_tail) == 0:
        return None
    return int(regs_tail[-1])


def run_walk_forward_full_model_validation(df: pd.DataFrame,
                                           n_splits: int = 3,
                                           train_years: int = 15,
                                           test_years: int = 5,
                                           n_sims: int = 280) -> Dict[str, Any]:
    """
    Walk-forward validation with strict past-only calibration:
    - split-level OOS test (train frozen, test forward)
    - rolling recalibration inside each split (expanding train -> next 1Y segment)
    """
    global _SCENARIO_CALIBRATED_PRESETS, _SCENARIO_CALIBRATION_META

    out: Dict[str, Any] = {
        'sufficient_data': False,
        'splits_requested': int(n_splits),
        'splits_run': 0,
        'split_pass_rate': float('nan'),
        'all_splits_passed': False,
        'mean_vol_abs_error_p50': float('nan'),
        'mean_vol_abs_error_p95': float('nan'),
        'mean_stress_share_abs_error_pp': float('nan'),
        'drawdown_pass_rate': float('nan'),
        'vol_pass_rate': float('nan'),
        'stress_share_pass_rate': float('nan'),
        'rolling_recalibration_pass_rate': float('nan'),
        'splits': []
    }

    train_days = int(train_years * 252)
    test_days = int(test_years * 252)
    total_needed = train_days + test_days
    if len(df) < total_needed + 252:
        return out

    starts = np.linspace(0, len(df) - total_needed, int(max(2, n_splits)), dtype=int)
    rows = []

    _old_sc = copy.deepcopy(_SCENARIO_CALIBRATED_PRESETS)
    _old_sc_meta = copy.deepcopy(_SCENARIO_CALIBRATION_META)
    try:
        for i, start in enumerate(starts):
            train_df = df.iloc[start:start + train_days].copy()
            test_df = df.iloc[start + train_days:start + train_days + test_days].copy()
            if len(train_df) < train_days or len(test_df) < test_days:
                continue

            split_row: Dict[str, Any] = {
                'split': int(i + 1),
                'train_start': str(train_df.index[0].date()),
                'train_end': str(train_df.index[-1].date()),
                'test_start': str(test_df.index[0].date()),
                'test_end': str(test_df.index[-1].date()),
                'train_years': float(len(train_df) / 252.0),
                'test_years': float(len(test_df) / 252.0)
            }

            rm, calib_err = _calibrate_full_regime_bundle_for_window(
                window_df=train_df,
                tag=f"wf_split_{i}_{int(train_df.index[0].strftime('%Y%m%d'))}_{int(test_df.index[-1].strftime('%Y%m%d'))}"
            )
            if calib_err is not None or rm is None:
                split_row.update({
                    'calibration_error': str(calib_err),
                    'split_passed': False
                })
                rows.append(split_row)
                continue

            start_regime_hint = _infer_start_regime_from_window(train_df, rm)
            test_ret_ser = test_df['SPY_Ret'].dropna()
            test_view = test_df.loc[test_ret_ser.index].copy()
            test_ret = test_ret_ser.to_numpy(dtype=float)
            if len(test_ret) < 40:
                split_row.update({'split_passed': False, 'reason': 'insufficient_test_returns'})
                rows.append(split_row)
                continue
            test_vix = test_view['VIX'].ffill().bfill().fillna(20.0).to_numpy(dtype=float) if 'VIX' in test_view.columns else np.full(len(test_ret), 20.0)
            rv_test = test_view['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0).to_numpy(dtype=float) * np.sqrt(252)
            ts_test = (test_view['TNX'] - test_view['IRX']).to_numpy(dtype=float) if 'TNX' in test_view.columns and 'IRX' in test_view.columns else None
            rec_test = test_view['USREC'].to_numpy(dtype=float) if 'USREC' in test_view.columns else None
            regs_test = infer_regime_from_vix(
                vix_series=test_vix,
                realized_vol=rv_test,
                term_spread=ts_test,
                logit_shift=0.0,
                logit_params=rm.get('stress_logit_params', STRESS_LOGIT_PARAMS),
                spy_returns=test_view['SPY_Ret'].to_numpy(dtype=float),
                recession_proxy=rec_test
            )
            actual_stress_share = _stress_share(np.asarray(regs_test, dtype=int)) if len(regs_test) > 0 else float('nan')

            sim_td = _simulate_spy_mdd_vol_distribution(
                regime_model=rm,
                n_days=len(test_ret),
                n_sims=int(max(70, n_sims)),
                seed=9300 + i * 29,
                vix_anchor=test_vix,
                start_regime_override=start_regime_hint,
                return_spy_paths=True,
                target_stress_share=actual_stress_share if np.isfinite(actual_stress_share) else None,
                target_tolerance=0.06
            )
            sim_mdd = sim_td.get('mdd', np.array([]))
            sim_stress_shares = sim_td.get('stress_share', np.array([]))
            sim_paths = sim_td.get('spy_paths', np.zeros((0, len(test_ret)), dtype=float))

            # Volatility distribution on OOS test horizon via rolling-vol samples.
            test_real_vol = (test_view['SPY_Ret'].rolling(252, min_periods=200).std() * np.sqrt(252)).dropna().to_numpy(dtype=float)
            if len(test_real_vol) > 0:
                test_real_vol = test_real_vol[::21]
            sim_vol_roll = _rolling_vol_samples_from_paths(
                spy_paths=np.asarray(sim_paths, dtype=float),
                window=252,
                min_periods=200,
                stride=21
            )
            vol_pass = False
            vol_err = {'p25': float('nan'), 'p50': float('nan'), 'p75': float('nan'), 'p95': float('nan')}
            if len(test_real_vol) >= 20 and len(sim_vol_roll) >= 100:
                real_pct = {f'p{k}': float(np.percentile(test_real_vol, k)) for k in [25, 50, 75, 95]}
                sim_pct = _sample_size_matched_percentiles(
                    sim_samples=sim_vol_roll,
                    sample_size=len(test_real_vol),
                    percentiles=(25, 50, 75, 95),
                    n_boot=240,
                    seed=1307 + i * 37
                )
                vol_err = {k: float(abs(sim_pct[k] - real_pct[k])) for k in real_pct}
                vol_pass = bool(
                    vol_err['p50'] <= 0.03 and
                    vol_err['p25'] <= 0.04 and
                    vol_err['p75'] <= 0.04 and
                    vol_err['p95'] <= 0.06
                )

            # Drawdown envelope check.
            real_mdd = _max_drawdown_from_returns(test_ret)
            mdd_p1 = float(np.percentile(sim_mdd, 1)) if len(sim_mdd) >= 60 else float('nan')
            mdd_p99 = float(np.percentile(sim_mdd, 99)) if len(sim_mdd) >= 60 else float('nan')
            drawdown_pass = bool(np.isfinite(real_mdd) and np.isfinite(mdd_p1) and np.isfinite(mdd_p99) and (mdd_p1 <= real_mdd <= mdd_p99))

            # Stress-share alignment against simulated occupancy (not only topology).
            modeled_stress_share = float(np.nanmedian(sim_stress_shares)) if len(sim_stress_shares) > 0 else _regime_frequency_from_params(
                rm.get('regime_params', {}), tuple(STRESS_REGIME_IDS), use_topology=True
            )
            stress_abs_err_pp = float(abs(actual_stress_share - modeled_stress_share) * 100.0) if (np.isfinite(actual_stress_share) and np.isfinite(modeled_stress_share)) else float('nan')
            stress_share_pass = bool(np.isfinite(stress_abs_err_pp) and stress_abs_err_pp <= 12.0)

            # Rolling recalibration inside each split (expanding window, no look-ahead).
            seg_rows: List[Dict[str, Any]] = []
            seg_step = 252
            for seg_idx, seg_start in enumerate(range(0, len(test_df), seg_step)):
                seg_end = min(seg_start + seg_step, len(test_df))
                seg_df = test_df.iloc[seg_start:seg_end].copy()
                if len(seg_df) < 126:
                    continue
                expanding_train = df.iloc[start:start + train_days + seg_start].copy()
                rm_seg, seg_err = _calibrate_full_regime_bundle_for_window(
                    window_df=expanding_train,
                    tag=f"wf_split_{i}_seg_{seg_idx}_{int(expanding_train.index[0].strftime('%Y%m%d'))}_{int(expanding_train.index[-1].strftime('%Y%m%d'))}"
                )
                if seg_err is not None or rm_seg is None:
                    seg_rows.append({
                        'segment': int(seg_idx + 1),
                        'start': str(seg_df.index[0].date()),
                        'end': str(seg_df.index[-1].date()),
                        'calibration_error': str(seg_err),
                        'passed': False
                    })
                    continue
                seg_ret_ser = seg_df['SPY_Ret'].dropna()
                seg_view = seg_df.loc[seg_ret_ser.index].copy()
                seg_ret = seg_ret_ser.to_numpy(dtype=float)
                if len(seg_ret) < 40:
                    continue
                seg_vix = seg_view['VIX'].ffill().bfill().fillna(20.0).to_numpy(dtype=float) if 'VIX' in seg_view.columns else np.full(len(seg_ret), 20.0)
                rv_seg = seg_view['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0).to_numpy(dtype=float) * np.sqrt(252)
                ts_seg = (seg_view['TNX'] - seg_view['IRX']).to_numpy(dtype=float) if 'TNX' in seg_view.columns and 'IRX' in seg_view.columns else None
                rec_seg = seg_view['USREC'].to_numpy(dtype=float) if 'USREC' in seg_view.columns else None
                regs_seg = infer_regime_from_vix(
                    vix_series=seg_vix,
                    realized_vol=rv_seg,
                    term_spread=ts_seg,
                    logit_shift=0.0,
                    logit_params=rm_seg.get('stress_logit_params', STRESS_LOGIT_PARAMS),
                    spy_returns=seg_view['SPY_Ret'].to_numpy(dtype=float),
                    recession_proxy=rec_seg
                )
                seg_actual_stress = _stress_share(np.asarray(regs_seg, dtype=int)) if len(regs_seg) > 0 else float('nan')
                seg_start_reg = _infer_start_regime_from_window(expanding_train, rm_seg)
                seg_sim = _simulate_spy_mdd_vol_distribution(
                    regime_model=rm_seg,
                    n_days=len(seg_ret),
                    n_sims=int(max(40, n_sims * 0.45)),
                    seed=9600 + i * 41 + seg_idx * 7,
                    vix_anchor=seg_vix,
                    start_regime_override=seg_start_reg,
                    target_stress_share=seg_actual_stress if np.isfinite(seg_actual_stress) else None,
                    target_tolerance=0.08
                )
                seg_vol_dist = np.asarray(seg_sim.get('vol', np.array([])), dtype=float)
                seg_mdd_dist = np.asarray(seg_sim.get('mdd', np.array([])), dtype=float)
                seg_stress_dist = np.asarray(seg_sim.get('stress_share', np.array([])), dtype=float)
                seg_real_vol = float(np.nanstd(seg_ret) * np.sqrt(252))
                seg_real_mdd = _max_drawdown_from_returns(seg_ret)
                seg_v5 = float(np.percentile(seg_vol_dist, 5)) if len(seg_vol_dist) >= 30 else float('nan')
                seg_v95 = float(np.percentile(seg_vol_dist, 95)) if len(seg_vol_dist) >= 30 else float('nan')
                seg_m1 = float(np.percentile(seg_mdd_dist, 1)) if len(seg_mdd_dist) >= 40 else float('nan')
                seg_m99 = float(np.percentile(seg_mdd_dist, 99)) if len(seg_mdd_dist) >= 40 else float('nan')
                seg_vol_pass = bool(np.isfinite(seg_real_vol) and np.isfinite(seg_v5) and np.isfinite(seg_v95) and (seg_v5 <= seg_real_vol <= seg_v95))
                seg_dd_pass = bool(np.isfinite(seg_real_mdd) and np.isfinite(seg_m1) and np.isfinite(seg_m99) and (seg_m1 <= seg_real_mdd <= seg_m99))
                seg_modeled_stress = float(np.nanmedian(seg_stress_dist)) if len(seg_stress_dist) > 0 else _regime_frequency_from_params(
                    rm_seg.get('regime_params', {}), tuple(STRESS_REGIME_IDS), use_topology=True
                )
                seg_stress_err = float(abs(seg_actual_stress - seg_modeled_stress) * 100.0) if (
                    np.isfinite(seg_actual_stress) and np.isfinite(seg_modeled_stress)
                ) else float('nan')
                seg_stress_pass = bool(np.isfinite(seg_stress_err) and seg_stress_err <= 15.0)
                seg_pass = bool(seg_vol_pass and seg_dd_pass and seg_stress_pass)
                seg_rows.append({
                    'segment': int(seg_idx + 1),
                    'start': str(seg_df.index[0].date()),
                    'end': str(seg_df.index[-1].date()),
                    'vol_passed': bool(seg_vol_pass),
                    'drawdown_passed': bool(seg_dd_pass),
                    'stress_share_passed': bool(seg_stress_pass),
                    'passed': bool(seg_pass),
                    'real_ann_vol': float(seg_real_vol),
                    'sim_vol_p5': float(seg_v5) if np.isfinite(seg_v5) else None,
                    'sim_vol_p95': float(seg_v95) if np.isfinite(seg_v95) else None,
                    'real_mdd': float(seg_real_mdd) if np.isfinite(seg_real_mdd) else None,
                    'sim_mdd_p1': float(seg_m1) if np.isfinite(seg_m1) else None,
                    'sim_mdd_p99': float(seg_m99) if np.isfinite(seg_m99) else None,
                    'stress_share_abs_error_pp': float(seg_stress_err) if np.isfinite(seg_stress_err) else None
                })

            seg_pass_rate = float(np.mean([1.0 if s.get('passed', False) else 0.0 for s in seg_rows])) if len(seg_rows) > 0 else float('nan')
            rolling_recal_pass = bool((len(seg_rows) == 0) or (np.isfinite(seg_pass_rate) and seg_pass_rate >= 0.50))

            split_pass = bool(vol_pass and drawdown_pass and stress_share_pass and rolling_recal_pass)
            split_row.update({
                'vol_passed': bool(vol_pass),
                'drawdown_passed': bool(drawdown_pass),
                'stress_share_passed': bool(stress_share_pass),
                'rolling_recalibration_passed': bool(rolling_recal_pass),
                'rolling_segment_pass_rate': float(seg_pass_rate) if np.isfinite(seg_pass_rate) else None,
                'rolling_segments': seg_rows,
                'split_passed': bool(split_pass),
                'vol_abs_error_p25': float(vol_err['p25']),
                'vol_abs_error_p50': float(vol_err['p50']),
                'vol_abs_error_p75': float(vol_err['p75']),
                'vol_abs_error_p95': float(vol_err['p95']),
                'real_mdd': float(real_mdd) if np.isfinite(real_mdd) else None,
                'sim_mdd_p1': float(mdd_p1) if np.isfinite(mdd_p1) else None,
                'sim_mdd_p99': float(mdd_p99) if np.isfinite(mdd_p99) else None,
                'actual_stress_share_pct': float(actual_stress_share * 100.0) if np.isfinite(actual_stress_share) else None,
                'modeled_stress_share_pct': float(modeled_stress_share * 100.0) if np.isfinite(modeled_stress_share) else None,
                'stress_share_abs_error_pp': float(stress_abs_err_pp) if np.isfinite(stress_abs_err_pp) else None
            })
            rows.append(split_row)
    finally:
        _SCENARIO_CALIBRATED_PRESETS = _old_sc
        _SCENARIO_CALIBRATION_META = _old_sc_meta

    if len(rows) == 0:
        return out

    out['splits'] = rows
    out['splits_run'] = int(len(rows))
    out['sufficient_data'] = True
    split_pass = np.asarray([1.0 if r.get('split_passed', False) else 0.0 for r in rows], dtype=float)
    vol_pass = np.asarray([1.0 if r.get('vol_passed', False) else 0.0 for r in rows], dtype=float)
    dd_pass = np.asarray([1.0 if r.get('drawdown_passed', False) else 0.0 for r in rows], dtype=float)
    stress_pass = np.asarray([1.0 if r.get('stress_share_passed', False) else 0.0 for r in rows], dtype=float)
    roll_pass = np.asarray([1.0 if r.get('rolling_recalibration_passed', False) else 0.0 for r in rows], dtype=float)
    out['split_pass_rate'] = float(np.mean(split_pass))
    out['all_splits_passed'] = bool(np.all(split_pass >= 0.5))
    out['vol_pass_rate'] = float(np.mean(vol_pass))
    out['drawdown_pass_rate'] = float(np.mean(dd_pass))
    out['stress_share_pass_rate'] = float(np.mean(stress_pass))
    out['rolling_recalibration_pass_rate'] = float(np.mean(roll_pass))

    p50_err = np.asarray([r.get('vol_abs_error_p50', np.nan) for r in rows], dtype=float)
    p95_err = np.asarray([r.get('vol_abs_error_p95', np.nan) for r in rows], dtype=float)
    stress_err = np.asarray([r.get('stress_share_abs_error_pp', np.nan) for r in rows], dtype=float)
    out['mean_vol_abs_error_p50'] = float(np.nanmean(p50_err)) if np.any(np.isfinite(p50_err)) else float('nan')
    out['mean_vol_abs_error_p95'] = float(np.nanmean(p95_err)) if np.any(np.isfinite(p95_err)) else float('nan')
    out['mean_stress_share_abs_error_pp'] = float(np.nanmean(stress_err)) if np.any(np.isfinite(stress_err)) else float('nan')
    return out


def run_rolling_regime_garch_diagnostics(df: pd.DataFrame,
                                         n_splits: int = 4,
                                         window_years: int = 8) -> Dict[str, Any]:
    """
    Diagnose structural drift in regime topology and GARCH-like volatility persistence
    over rolling windows. This does not recalibrate the production model; it verifies
    whether fixed-sample parameters are likely stable enough.
    """
    out: Dict[str, Any] = {
        'sufficient_data': False,
        'splits_requested': int(n_splits),
        'splits_run': 0,
        'calibration_mode': 'fixed_full_sample',
        'rolling_calibration_enabled': False,
        'stress_frequency_range': float('nan'),
        'bear_median_duration_range_days': float('nan'),
        'absret_acf1_range': float('nan'),
        'stability_passed': False,
        'splits': []
    }

    win = int(window_years * 252)
    if len(df) < win + 252:
        return out

    starts = np.linspace(0, len(df) - win, int(max(2, n_splits)), dtype=int)
    stress_freqs: List[float] = []
    bear_medians: List[float] = []
    acf_vals: List[float] = []

    for s in starts:
        sub = df.iloc[s:s + win].copy()
        if len(sub) < 252 * 3:
            continue
        rv = (sub['SPY_Ret'].rolling(20, min_periods=5).std().bfill().fillna(0).to_numpy(dtype=float) * np.sqrt(252))
        ts = (sub['TNX'] - sub['IRX']).to_numpy(dtype=float) if 'TNX' in sub.columns and 'IRX' in sub.columns else None
        regs = infer_regime_from_vix(
            vix_series=sub['VIX'].to_numpy(dtype=float),
            realized_vol=rv,
            term_spread=ts,
            logit_shift=0.0,
            logit_params=STRESS_LOGIT_PARAMS,
            spy_returns=sub['SPY_Ret'].to_numpy(dtype=float),
            recession_proxy=sub['USREC'].to_numpy(dtype=float) if 'USREC' in sub.columns else None
        )
        if len(regs) < 120:
            continue

        stress_share = _stress_share(regs)
        bear_eps = _extract_boolean_episodes(np.asarray(regs, dtype=int) == REGIME_BEAR)
        bear_lens = np.asarray([e - s0 + 1 for s0, e in bear_eps], dtype=float) if bear_eps else np.array([])
        bear_med = float(np.median(bear_lens)) if len(bear_lens) > 0 else 0.0

        ret = sub['SPY_Ret'].to_numpy(dtype=float)
        ret = ret[np.isfinite(ret)]
        if len(ret) > 10:
            abs_ret = np.abs(ret - np.nanmean(ret))
            acf1 = float(np.corrcoef(abs_ret[:-1], abs_ret[1:])[0, 1]) if np.nanstd(abs_ret) > 0 else 0.0
            acf1 = float(np.clip(acf1, -1.0, 1.0)) if np.isfinite(acf1) else 0.0
        else:
            acf1 = 0.0

        stress_freqs.append(stress_share)
        bear_medians.append(bear_med)
        acf_vals.append(acf1)
        out['splits'].append({
            'start': str(sub.index[0].date()),
            'end': str(sub.index[-1].date()),
            'stress_share_pct': float(stress_share * 100.0),
            'bear_median_days': float(bear_med),
            'absret_acf1': float(acf1)
        })

    if len(stress_freqs) < 2:
        return out

    out['splits_run'] = int(len(stress_freqs))
    out['sufficient_data'] = True
    out['stress_frequency_range'] = float(np.nanmax(stress_freqs) - np.nanmin(stress_freqs))
    out['bear_median_duration_range_days'] = float(np.nanmax(bear_medians) - np.nanmin(bear_medians))
    out['absret_acf1_range'] = float(np.nanmax(acf_vals) - np.nanmin(acf_vals))

    # Heuristic bounds for "stable enough" fixed-parameter usage.
    out['stability_passed'] = bool(
        out['stress_frequency_range'] <= 0.18 and
        out['bear_median_duration_range_days'] <= 220.0 and
        out['absret_acf1_range'] <= 0.25
    )
    return out


