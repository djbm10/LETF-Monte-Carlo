def process_trades_with_wired_engine(
    trades: List[Dict],
    time_horizon_years: int,
    elections: TaxpayerElections,
    initial_capital: float,
    debug: bool = False,
    strategy_id: str = "UNKNOWN",
    tax_config: Dict = None
) -> Dict:
    """
    Process LETF trades through WIRED v5.1 tax engine.
    
    ZERO COMPROMISES:
    - Real FIFO tracking
    - Actual compute_capital_gains() calls
    - Year-by-year processing
    - Elections respected
    - Full audit trail
    
    NEW: Debug logging to diagnose tax calculation issues
    
    Returns complete tax analysis.
    """
    
    # Default tax config if not provided
    if tax_config is None:
        tax_config = {'filing_status': 'single', 'state': 'CA', 'ordinary_income': 150000, 'career_stage': 'mid'}
    
    # ========================================================================
    # MONTE CARLO INCOME SIMULATION
    # ========================================================================
    base_income = tax_config.get('ordinary_income', 150000)
    career_stage = tax_config.get('career_stage', 'mid')
    
    # Simulate income trajectory using Monte Carlo
    # Use median (p50) for tax calculation - conservative yet realistic
    income_sim = simulate_income_trajectory(
        base_income=base_income,
        years=time_horizon_years,
        num_simulations=100,  # 100 paths for stable median
        career_stage=career_stage,
        aggressive=True,  # Aggressive career progression assumptions
        seed=42  # Reproducible results
    )
    
    income_trajectory = income_sim['p50']  # Use median path for tax calculations

    # Validate the trajectory is finite and strictly positive before using it
    # in tax bracket computations.  Non-finite income would cause division-by-zero
    # or NaN propagation inside WIRED marginal-rate calculations.
    if (not np.all(np.isfinite(income_trajectory))
            or not np.all(income_trajectory > 0)):
        _bad_mask = ~(np.isfinite(income_trajectory) & (income_trajectory > 0))
        _n_bad = int(_bad_mask.sum())
        print(f"  ⚠ WARNING: income_trajectory has {_n_bad} non-finite/non-positive "
              f"value(s) — falling back to constant base_income=${base_income:,.0f}. "
              f"Check simulate_income_trajectory() for base_income={base_income} / "
              f"career_stage='{career_stage}'.")
        income_trajectory = np.full(len(income_trajectory), float(base_income))

    if debug:
        print(f"\n{'='*80}")
        print(f"DEBUG: process_trades_with_wired_engine for {strategy_id}")
        print(f"{'='*80}")
        print(f"  Time horizon: {time_horizon_years} years")
        print(f"  Number of trades: {len(trades) if trades else 0}")
        print(f"  Initial capital: ${initial_capital:,}")
        print(f"  Filing status: {tax_config.get('filing_status', 'unknown')}")
        print(f"  State: {tax_config.get('state', 'unknown')}")
        print(f"\n  Monte Carlo Income Simulation:")
        print(f"    Starting income: ${base_income:,.0f}")
        print(f"    Career stage: {career_stage}")
        print(f"    Year 1 income: ${income_trajectory[1]:,.0f}")
        if time_horizon_years >= 5:
            print(f"    Year 5 income: ${income_trajectory[5]:,.0f} ({(income_trajectory[5]/base_income - 1)*100:+.2f}%)")
        if time_horizon_years >= 10:
            print(f"    Year 10 income: ${income_trajectory[10]:,.0f} ({(income_trajectory[10]/base_income - 1)*100:+.2f}%)")
        if time_horizon_years >= 20:
            print(f"    Year 20 income: ${income_trajectory[20]:,.0f} ({(income_trajectory[20]/base_income - 1)*100:+.2f}%)")
        print(f"    P10 final: ${income_sim['p10'][-1]:,.0f} (pessimistic)")
        print(f"    P90 final: ${income_sim['p90'][-1]:,.0f} (optimistic)")
    
    if debug and not trades:
        print(f"  ⚠️  NO TRADES - returning zero tax")
        return {
            'total_tax': 0,
            'yearly_taxes': [],
            'total_st_gains': 0,
            'total_lt_gains': 0,
            'final_cf': {'st': 0, 'lt': 0},
            'debug_info': 'No trades provided'
        }
    
    
# ========================================================================
    # WASH SALE PROCESSING (LOOK-BACK AND LOOK-FORWARD)
    # ========================================================================
    days_per_year = 252  # Moved up so wash_tracker can use it
    
    wash_tracker = WashSaleTracker(days_per_year=days_per_year)
    
    # Record all trades for wash sale analysis
    for trade in trades:
        wash_tracker.record_trade(
            asset=trade['asset'],
            day=trade['day_index'],
            action=trade['action'],
            shares=trade.get('shares', trade['dollar_amount'] / trade['price']),
            price=trade['price']
        )
    
    wash_tracker.process_all_wash_sales()
    
    if debug:
        ws_summary = wash_tracker.get_wash_sale_summary()
        print(f"\n  Wash Sale Analysis:")
        print(f"    Total losses disallowed: ${ws_summary['total_disallowed']:,.2f}")
        print(f"    Total losses allowed: ${ws_summary['total_allowed']:,.2f}")
        print(f"    Wash sale events: {ws_summary['events_count']}")
        
        # NEW: Show cross-year info
        cross_year = wash_tracker.get_cross_year_summary()
        if cross_year['total_cross_year_events'] > 0:
            print(f"    Cross-year wash sales: {cross_year['total_cross_year_events']}")
            print(f"    Cross-year disallowed: ${cross_year['total_cross_year_disallowed']:,.2f}")
            print(f"    Wash sale chains: {cross_year['chains_count']}")
    yearly_activity = defaultdict(lambda: {
        'st_gains': 0, 'st_losses': 0,
        'lt_gains': 0, 'lt_losses': 0,
        'wash_sale_disallowed': 0  # Track disallowed losses separately
    })
    
    # FIFO tracking for each asset with basis adjustments
    positions = defaultdict(list)
    
    for trade in trades:
        year = trade['day_index'] // days_per_year
        asset = trade['asset']
        
        if trade['action'] == 'BUY':
            # Use ACTUAL shares from trade, not reconstructed from dollars
            shares = float(trade.get('shares', trade['dollar_amount'] / trade['price']))
            price = float(trade['price'])
            if (not np.isfinite(shares)) or (not np.isfinite(price)) or shares <= 0 or price <= 0:
                continue
            base_cost = shares * price
            
            # Check if this lot has a wash sale basis adjustment
            basis_adj = float(wash_tracker.get_basis_adjustment(asset, trade['day_index']))
            if not np.isfinite(basis_adj):
                basis_adj = 0.0
            adjusted_cost = base_cost + basis_adj
            # Wash-sale basis adjustments must be non-negative (disallowed loss is
            # added to the replacement lot's cost, never subtracted).
            if (not np.isfinite(adjusted_cost)) or adjusted_cost < 0:
                adjusted_cost = max(base_cost, 0.0)

            # Check if this lot has a holding period adjustment (wash sale tacking)
            # If a wash sale occurred, we use the ORIGINAL lot's buy day for holding period
            holding_period_start = wash_tracker.get_holding_period_adjustment(asset, trade['day_index'])
            tacked_shares = wash_tracker.get_tacked_shares(asset, trade['day_index'])
            
            # Add to positions with adjusted basis AND adjusted holding period
            positions[asset].append({
                'day': trade['day_index'],
                'shares': shares,
                'price': price,
                'adjusted_price': adjusted_cost / shares if shares > 0 else price,
                'basis_adjustment': basis_adj,
                'original_day': holding_period_start,  # Use tacked holding period if wash sale occurred
                'tacked_shares': tacked_shares,  # Track how many shares have tacked period
                'has_wash_sale_adjustment': basis_adj > 0 or holding_period_start != trade['day_index']
            })
            
        elif trade['action'] == 'SELL':
            shares_to_sell = float(trade.get('shares', trade['dollar_amount'] / trade['price']))
            sale_price = float(trade['price'])
            if (not np.isfinite(shares_to_sell)) or (not np.isfinite(sale_price)) or shares_to_sell <= 0 or sale_price <= 0:
                continue
            sale_day = trade['day_index']
            
            # ================================================================
            # LOT SELECTION (SpecID Implementation)
            # ================================================================
            lot_method = elections.lot_selection_method
            
            lots_to_use = get_lots_to_sell(
                positions=positions[asset],
                shares_needed=shares_to_sell,
                method=lot_method,
                sale_day=sale_day,
                sale_price=sale_price
            )
            
            remaining_to_sell = shares_to_sell
            
            for lot_idx in lots_to_use:
                if remaining_to_sell <= 0.001:
                    break
                
                if lot_idx >= len(positions[asset]):
                    continue
                
                pos = positions[asset][lot_idx]
                
                if pos['shares'] <= 0.001:
                    continue
                
                shares_sold = min(remaining_to_sell, pos['shares'])
                
                # Calculate gain/loss using ADJUSTED basis
                holding_days = sale_day - pos['original_day']
                cost_basis = shares_sold * pos['adjusted_price']
                proceeds = shares_sold * sale_price
                gain_loss = proceeds - cost_basis
                
                # Wash-sale basis adjustment is already embedded in pos['adjusted_price']
                # via WashSaleTracker.process_all_wash_sales() / get_basis_adjustment().
                # Do NOT re-check here — a second inline check would double-penalise the
                # same wash-sale event (once via elevated basis, once via disallowing the
                # loss again).  Simply record the gain/loss at the adjusted basis.
                if holding_days > 365:
                    if gain_loss > 0:
                        yearly_activity[year]['lt_gains'] += gain_loss
                    else:
                        yearly_activity[year]['lt_losses'] += abs(gain_loss)
                else:
                    if gain_loss > 0:
                        yearly_activity[year]['st_gains'] += gain_loss
                    else:
                        yearly_activity[year]['st_losses'] += abs(gain_loss)
                
                pos['shares'] -= shares_sold
                remaining_to_sell -= shares_sold
            
            # Clean up empty lots
            positions[asset] = [p for p in positions[asset] if p['shares'] > 0.001]
    
    # Process year by year through WIRED engine
    cumulative_tax = 0
    yearly_results = []
    st_cf = 0
    lt_cf = 0
    
    # Use the career_stage-aware income_trajectory (income_sim['p50']) computed above.
    # Previously a second hard-coded simulation ran here with fixed probabilities
    # (0.03 layoff / 0.10 job-change / 0.25 promotion), ignoring career_stage entirely.
    # That simulation's result drove all tax calculations while income_trajectory was
    # used only for debug output — the roles are now swapped correctly.
    years_until_retirement = tax_config.get('years_until_retirement', None)
    retirement_income_cfg  = tax_config.get('retirement_income', None)

    income_path = list(income_trajectory)  # p50 path indexed [0 .. time_horizon_years]

    # Apply retirement income override for years after retirement (2% COLA thereafter).
    if years_until_retirement is not None:
        peak_income = max(income_path[:years_until_retirement + 1]) if years_until_retirement < len(income_path) else max(income_path)
        ret_income  = retirement_income_cfg if retirement_income_cfg is not None else peak_income * 0.50
        for _yr in range(years_until_retirement + 1, len(income_path)):
            income_path[_yr] = ret_income * (1.02 ** (_yr - years_until_retirement - 1))

    if debug:
        print(f"\n  Income Path (career_stage={career_stage}):")
        print(f"    Year 1:  ${income_path[min(1,  len(income_path)-1)]:,.0f}")
        print(f"    Year 5:  ${income_path[min(5,  len(income_path)-1)]:,.0f}")
        print(f"    Year 10: ${income_path[min(10, len(income_path)-1)]:,.0f}")
        if years_until_retirement and years_until_retirement < len(income_path) - 1:
            print(f"    Retirement yr {years_until_retirement}: ${income_path[years_until_retirement + 1]:,.0f}")
        print(f"    Final:   ${income_path[-1]:,.0f}")
    
    # ========================================================================
    # TAX BRACKET / THRESHOLD INDEXATION (DYNAMIC)
    # ========================================================================
    # Institutional update: replace fixed 2.5% with a dynamic year-by-year path.
    tax_indexation = build_dynamic_tax_indexation_path(
        time_horizon_years=time_horizon_years,
        income_path=income_path,
        tax_config=tax_config
    )
    bracket_multipliers = np.asarray(tax_indexation.get('multipliers', [1.0] * time_horizon_years), dtype=float)
    bracket_rates = np.asarray(tax_indexation.get('rates', [DEFAULT_TAX_INDEXATION_BASE] * time_horizon_years), dtype=float)
    if len(bracket_multipliers) < time_horizon_years:
        bracket_multipliers = np.pad(bracket_multipliers, (0, time_horizon_years - len(bracket_multipliers)), mode='edge')
    if len(bracket_rates) < time_horizon_years:
        bracket_rates = np.pad(bracket_rates, (0, time_horizon_years - len(bracket_rates)), mode='edge')

    niit_threshold_path = tax_config.get('niit_threshold_path', None)
    base_niit_override = tax_config.get('niit_threshold_override', None)
    include_amt = bool(tax_config.get('include_amt', True))
    brokerage_quirks_cfg = _merge_brokerage_tax_quirks(tax_config.get('brokerage_quirks', {}))
    state_nonconformity_addon_rate = float(np.clip(float(tax_config.get('state_nonconformity_addon_rate', 0.0)), 0.0, 0.50))

    # AMT credit carryforward state.
    amt_credit_cf = float(max(0.0, tax_config.get('amt_credit_cf_start', 0.0)))
    
    # ========================================================================
    # MARGIN INTEREST DEDUCTION (IRC §163(d))
    # ========================================================================
    margin_rate = float(np.clip(tax_config.get('margin_rate', 0.06), 0.0, 0.35))
    margin_path = compute_margin_interest_from_balance_path(
        trades=trades,
        time_horizon_years=time_horizon_years,
        initial_capital=initial_capital,
        margin_rate_base=margin_rate,
        days_per_year=days_per_year
    )
    yearly_margin_interest = np.asarray(margin_path.get('yearly_interest', [0.0] * time_horizon_years), dtype=float)
    if len(yearly_margin_interest) < time_horizon_years:
        yearly_margin_interest = np.pad(yearly_margin_interest, (0, time_horizon_years - len(yearly_margin_interest)), mode='constant')
    avg_borrowed_by_year = np.asarray(margin_path.get('avg_borrowed_by_year', [0.0] * time_horizon_years), dtype=float)
    avg_margin_rate_by_year = np.asarray(margin_path.get('avg_margin_rate_by_year', [margin_rate] * time_horizon_years), dtype=float)
    max_borrowed_by_year = np.asarray(margin_path.get('max_borrowed_by_year', [0.0] * time_horizon_years), dtype=float)

    if debug:
        print(f"\n  Margin interest path (explicit balance-based):")
        print(f"    Base margin rate: {margin_rate*100:.2f}%")
        print(f"    Total modeled margin interest: ${float(np.nansum(yearly_margin_interest)):,.0f}")
        if time_horizon_years > 0:
            print(f"    Year 1 avg borrowed: ${float(avg_borrowed_by_year[0]):,.0f}")
            print(f"    Year 1 avg rate: {float(avg_margin_rate_by_year[0])*100:.2f}%")
            print(f"    Year 1 max borrowed: ${float(max_borrowed_by_year[0]):,.0f}")
    
    if debug:
        print(f"\n  Processing {time_horizon_years} years of trades...")
    
    for year in range(time_horizon_years):
        year_data = yearly_activity[year]
        
        if debug:
            print(f"\n  Year {year + 1}:")
            print(f"    ST gains: ${year_data['st_gains']:,.0f}, losses: ${year_data['st_losses']:,.0f}")
            print(f"    LT gains: ${year_data['lt_gains']:,.0f}, losses: ${year_data['lt_losses']:,.0f}")
            print(f"    CF in: ST ${st_cf:,.0f}, LT ${lt_cf:,.0f}")
        
        # Call ACTUAL compute_capital_gains() - NO SHORTCUTS
        result = compute_capital_gains(
            st_gains=year_data['st_gains'],
            st_losses=year_data['st_losses'],
            lt_gains=year_data['lt_gains'],
            lt_losses=year_data['lt_losses'],
            st_loss_cf_in=st_cf,
            lt_loss_cf_in=lt_cf,
            elections=elections,
            trace=False
        )
        
        if debug:
            print(f"    After netting: ST ${result.taxable_st:,.0f}, LT ${result.taxable_lt:,.0f}")
            print(f"    Capital loss deduction: ${result.capital_loss_deduction:,.0f}")
        
        # FIXED v2: Calculate INCREMENTAL tax from capital gains
        # 
        # The problem with ordinary_income=0:
        # - Standard deduction ($14,600) eliminates first $14,600 of gains
        # - This is wrong - we want the tax ON the gains, not total tax
        #
        # Solution: Calculate tax WITH and WITHOUT the gains, take the difference
        # This gives us the incremental tax from the investment income
        
        # ========================================================================
        # MONTE CARLO INCOME FOR THIS YEAR
        # ========================================================================
        # Use income from Monte Carlo simulation (already includes all events)
        assumed_ordinary_income = income_path[year + 1]  # year+1 because income_path[0] is base
        
        # Dynamic bracket / threshold indexation for this tax year.
        bracket_multiplier = float(bracket_multipliers[year]) if year < len(bracket_multipliers) else float(bracket_multipliers[-1])
        tax_index_rate = float(bracket_rates[year]) if year < len(bracket_rates) else float(bracket_rates[-1])
        if isinstance(niit_threshold_path, (list, tuple)) and year < len(niit_threshold_path):
            niit_threshold_override = float(niit_threshold_path[year])
        elif base_niit_override is not None and np.isfinite(float(base_niit_override)):
            niit_threshold_override = float(base_niit_override) * bracket_multiplier
        else:
            niit_threshold_override = None

        # AMT credit utilization policy by election timing.
        if elections.amt_credit_timing == AMTCreditTiming.USE_IMMEDIATELY:
            amt_credit_use_rate = 1.0
        elif elections.amt_credit_timing == AMTCreditTiming.DEFER_TO_LOW_INCOME:
            income_med = float(np.nanmedian(income_path[1:])) if len(income_path) > 1 else float(assumed_ordinary_income)
            amt_credit_use_rate = 1.0 if assumed_ordinary_income <= income_med else 0.20
        else:  # DEFER_TO_HIGH_GAINS
            gains_this_year = float(max(0.0, result.taxable_st + result.taxable_lt))
            amt_credit_use_rate = 1.0 if gains_this_year >= 0.35 * max(assumed_ordinary_income, 1.0) else 0.15
        
        if debug:
            # Show income for this specific year
            print(f"    Year {year+1} ordinary income: ${assumed_ordinary_income:,.0f}")
            print(f"    Tax indexation rate: {tax_index_rate*100:.2f}%   bracket multiplier: {bracket_multiplier:.4f}")
        
        # ========================================================================
        # MARGIN INTEREST DEDUCTION (IRC §163(d))
        # ========================================================================
        # Margin interest is deductible against NET INVESTMENT INCOME.
        # Use explicit balance-path modeled interest for this specific year.
        annual_margin_interest = float(yearly_margin_interest[year]) if year < len(yearly_margin_interest) else 0.0
        
        # Margin interest reduces taxable investment income
        # Apply to ST gains first (most common), then LT if needed
        st_after_margin = max(0, result.taxable_st - annual_margin_interest)
        margin_remaining = max(0, annual_margin_interest - result.taxable_st)
        lt_after_margin = max(0, result.taxable_lt - margin_remaining)
        
        if debug and annual_margin_interest > 0:
            print(f"    Margin interest deduction: ${annual_margin_interest:,.0f}")
            if year < len(avg_borrowed_by_year):
                print(f"      Avg borrowed balance: ${float(avg_borrowed_by_year[year]):,.0f}")
            if year < len(avg_margin_rate_by_year):
                print(f"      Avg margin rate: {float(avg_margin_rate_by_year[year])*100:.2f}%")
            if year < len(max_borrowed_by_year):
                print(f"      Max borrowed balance: ${float(max_borrowed_by_year[year]):,.0f}")
            print(f"      ST before: ${result.taxable_st:,.0f}, after: ${st_after_margin:,.0f}")
            print(f"      LT before: ${result.taxable_lt:,.0f}, after: ${lt_after_margin:,.0f}")
        
        # Tax with just ordinary income (baseline)
        baseline_tax = calculate_comprehensive_tax_v6(
            taxable_st=0,
            taxable_lt=0,
            capital_loss_deduction=result.capital_loss_deduction,  # Loss deduction reduces ordinary income
            ordinary_income=assumed_ordinary_income,
            include_state=True,
            include_niit=True,
            include_amt=include_amt,
            filing_status=tax_config.get('filing_status', 'single').lower(),
            bracket_multiplier=bracket_multiplier,  # Apply inflation to brackets
            state_code=tax_config.get('state', 'CA'),
            amt_credit_cf_in=amt_credit_cf,
            amt_credit_use_rate=amt_credit_use_rate,
            niit_threshold_override=niit_threshold_override,
            brokerage_quirks=brokerage_quirks_cfg
        )
        
        # Tax with ordinary income + capital gains (AFTER margin interest deduction)
        total_tax_calc = calculate_comprehensive_tax_v6(
            taxable_st=st_after_margin,  # Reduced by margin interest
            taxable_lt=lt_after_margin,  # Reduced by margin interest
            capital_loss_deduction=result.capital_loss_deduction,
            ordinary_income=assumed_ordinary_income,
            include_state=True,
            include_niit=True,
            include_amt=include_amt,
            filing_status=tax_config.get('filing_status', 'single').lower(),
            bracket_multiplier=bracket_multiplier,  # Apply inflation to brackets
            state_code=tax_config.get('state', 'CA'),
            amt_credit_cf_in=amt_credit_cf,
            amt_credit_use_rate=amt_credit_use_rate,
            niit_threshold_override=niit_threshold_override,
            brokerage_quirks=brokerage_quirks_cfg
        )

        state_nonconformity_increment = 0.0
        # Optional state non-conformity surcharge (institutional stress realism).
        if state_nonconformity_addon_rate > 0.0:
            state_inc_noaddon = float(total_tax_calc.get('state_tax', 0.0) - baseline_tax.get('state_tax', 0.0))
            state_nonconformity_increment = float(max(0.0, state_inc_noaddon) * state_nonconformity_addon_rate)
            _b_add = float(max(0.0, baseline_tax.get('state_tax', 0.0)) * state_nonconformity_addon_rate)
            _t_add = float(max(0.0, total_tax_calc.get('state_tax', 0.0)) * state_nonconformity_addon_rate)
            baseline_tax['state_tax'] = float(baseline_tax.get('state_tax', 0.0) + _b_add)
            total_tax_calc['state_tax'] = float(total_tax_calc.get('state_tax', 0.0) + _t_add)
            baseline_tax['total_tax'] = float(baseline_tax.get('total_tax', 0.0) + _b_add)
            total_tax_calc['total_tax'] = float(total_tax_calc.get('total_tax', 0.0) + _t_add)

        # The INCREMENTAL tax from capital gains is the difference.
        # Can be negative when capital-loss deductions reduce the effective rate
        # below baseline (loss-deduction benefit); do NOT clamp — the negative
        # year offsets future positive years, correctly modelling loss carry-forward.
        year_tax = total_tax_calc['total_tax'] - baseline_tax['total_tax']
        cumulative_tax += year_tax
        amt_credit_cf = float(max(0.0, total_tax_calc.get('amt_credit_cf_out', amt_credit_cf)))
        
        if debug:
            print(f"    Tax calculation (incremental method):")
            print(f"      Baseline tax (ordinary only): ${baseline_tax['total_tax']:,.0f}")
            print(f"      Total tax (ordinary + gains): ${total_tax_calc['total_tax']:,.0f}")
            print(f"      Incremental (gains only): ${year_tax:,.0f}")
            print(f"    Breakdown of incremental:")
            fed_st_inc = total_tax_calc['federal_st'] - baseline_tax['federal_st']
            fed_lt_inc = total_tax_calc['federal_ltcg'] - baseline_tax['federal_ltcg']
            state_inc = total_tax_calc['state_tax'] - baseline_tax['state_tax']
            niit_inc = total_tax_calc['niit_tax'] - baseline_tax['niit_tax']
            amt_inc = total_tax_calc.get('amt_tax', 0.0) - baseline_tax.get('amt_tax', 0.0)
            print(f"      Federal ST: ${fed_st_inc:,.0f}")
            print(f"      Federal LT: ${fed_lt_inc:,.0f}")
            print(f"      State: ${state_inc:,.0f}")
            print(f"      NIIT: ${niit_inc:,.0f}")
            print(f"      AMT: ${amt_inc:,.0f}  | AMT CF out: ${amt_credit_cf:,.0f}")
        
        # Update carryforwards
        st_cf = result.st_loss_cf_out
        lt_cf = result.lt_loss_cf_out
        
        yearly_results.append({
            'year': year,
            'taxable_st': result.taxable_st,
            'taxable_lt': result.taxable_lt,
            'taxable_st_after_margin': st_after_margin,
            'taxable_lt_after_margin': lt_after_margin,
            'tax': year_tax,
            'margin_interest_deduction': annual_margin_interest,
            'avg_margin_borrowed': float(avg_borrowed_by_year[year]) if year < len(avg_borrowed_by_year) else 0.0,
            'avg_margin_rate': float(avg_margin_rate_by_year[year]) if year < len(avg_margin_rate_by_year) else margin_rate,
            'tax_indexation_rate': tax_index_rate,
            'bracket_multiplier': bracket_multiplier,
            'st_cf': st_cf,
            'lt_cf': lt_cf,
            'amt_credit_cf_out': float(amt_credit_cf),
            'capital_loss_deduction': result.capital_loss_deduction,
            'federal_total': total_tax_calc['federal_total'] - baseline_tax['federal_total'],
            'state_tax': total_tax_calc['state_tax'] - baseline_tax['state_tax'],
            'niit_tax': total_tax_calc['niit_tax'] - baseline_tax['niit_tax'],
            'amt_tax': total_tax_calc.get('amt_tax', 0.0) - baseline_tax.get('amt_tax', 0.0),
            'niit_threshold_used': float(total_tax_calc.get('niit_threshold', np.nan)),
            'brokerage_quirks_applied': dict(total_tax_calc.get('brokerage_quirks', {})),
            'state_nonconformity_tax': float(state_nonconformity_increment),
            'effective_rate': (year_tax / (result.taxable_st + result.taxable_lt)) if (result.taxable_st + result.taxable_lt) > 0 else 0
        })
    
    if debug:
        print(f"\n  SUMMARY for {strategy_id}:")
        print(f"    Total trades processed: {len(trades)}")
        print(f"    Total ST gains: ${sum(yr['taxable_st'] for yr in yearly_results):,.0f}")
        print(f"    Total LT gains: ${sum(yr['taxable_lt'] for yr in yearly_results):,.0f}")
        print(f"    Cumulative tax: ${cumulative_tax:,.0f}")
        _total_gains = sum(yr['taxable_st'] + yr['taxable_lt'] for yr in yearly_results)
        _eff_rate = cumulative_tax / _total_gains if _total_gains > 0 else 0.0
        print(f"    Effective rate on gains: {_eff_rate:.1%}  "
              f"(${cumulative_tax:,.0f} tax / ${_total_gains:,.0f} total gains)")
        print(f"    Final CF: ST ${st_cf:,.0f}, LT ${lt_cf:,.0f}")
        print(f"{'='*80}\n")
    
    return {
        'total_tax': cumulative_tax,
        'yearly_taxes': yearly_results,
        'total_st_gains': sum(yr['taxable_st'] for yr in yearly_results),
        'total_lt_gains': sum(yr['taxable_lt'] for yr in yearly_results),
        'tax_component_totals': {
            'federal_total': float(np.nansum([float(yr.get('federal_total', 0.0)) for yr in yearly_results])),
            'state_tax': float(np.nansum([float(yr.get('state_tax', 0.0)) for yr in yearly_results])),
            'niit_tax': float(np.nansum([float(yr.get('niit_tax', 0.0)) for yr in yearly_results])),
            'amt_tax': float(np.nansum([float(yr.get('amt_tax', 0.0)) for yr in yearly_results])),
            'state_nonconformity_tax': float(np.nansum([float(yr.get('state_nonconformity_tax', 0.0)) for yr in yearly_results]))
        },
        'final_cf': {'st': st_cf, 'lt': lt_cf},
        'engine_version': 'v6.2_marginal_rates_amt_indexed',
        'used_proper_marginal_rates': True,
        'debug_enabled': debug,
        'income_trajectory': income_path,  # OUTPUT salary progression (with retirement override applied)
        'tax_indexation': {
            'rates': bracket_rates.tolist(),
            'multipliers': bracket_multipliers.tolist(),
            'base_rate': float(tax_indexation.get('base_rate', DEFAULT_TAX_INDEXATION_BASE)),
            'floor': float(tax_indexation.get('floor', DEFAULT_TAX_INDEXATION_FLOOR)),
            'cap': float(tax_indexation.get('cap', DEFAULT_TAX_INDEXATION_CAP)),
            'income_beta': float(tax_indexation.get('income_beta', 0.0)),
            'cycle_amp': float(tax_indexation.get('cycle_amp', 0.0))
        },
        'tax_realism': {
            'include_amt': bool(include_amt),
            'state_nonconformity_addon_rate': float(state_nonconformity_addon_rate),
            'brokerage_quirks': dict(brokerage_quirks_cfg),
            'niit_threshold_path_len': len(niit_threshold_path) if isinstance(niit_threshold_path, (list, tuple)) else 0,
            'niit_threshold_override_base': float(base_niit_override) if base_niit_override is not None and np.isfinite(float(base_niit_override)) else None
        },
        'amt_credit_cf_out': float(amt_credit_cf),
        'margin_path': {
            'yearly_interest': yearly_margin_interest.tolist(),
            'avg_borrowed_by_year': avg_borrowed_by_year.tolist(),
            'avg_margin_rate_by_year': avg_margin_rate_by_year.tolist(),
            'max_borrowed_by_year': max_borrowed_by_year.tolist()
        }
    }


def process_monte_carlo_with_wired_engine(
    mc_results: Dict[str, List[Dict]],
    time_horizon_years: int,
    initial_capital: float,
    elections: TaxpayerElections = None
) -> Dict[str, Dict]:
    """
    Process Monte Carlo results through WIRED v5.1 engine.
    
    ZERO COMPROMISES:
    - Every simulation processed
    - Real engine calls
    - Actual elections
    - Full statistics
    """
    
    if elections is None:
        elections = TaxpayerElections()
    
    results = {}
    
    for strategy_id, sim_results in mc_results.items():
        print(f"  Processing {strategy_id} (Wired v5.1)...")
        
        pre_tax_wealths = []
        post_tax_wealths = []
        tax_details = []
        
        for sim_result in sim_results:
            pre_tax = sim_result['Final_Wealth']
            pre_tax_wealths.append(pre_tax)
            
            trade_list = sim_result.get('Trade_List')
            
            if trade_list and len(trade_list) > 0:
                # Process through WIRED engine
                tax_result = process_trades_with_wired_engine(
                    trades=trade_list,
                    time_horizon_years=time_horizon_years,
                    elections=elections,
                    initial_capital=initial_capital,
                    tax_config={'filing_status': 'single', 'state': 'CA'}  # Default config
                )
                
                post_tax = pre_tax - tax_result['total_tax']
                tax_details.append(tax_result)
            else:
                post_tax = pre_tax
                tax_details.append(None)
            
            post_tax_wealths.append(post_tax)
        
        # Calculate statistics
        pre_med = np.median(pre_tax_wealths)
        post_med = np.median(post_tax_wealths)
        
        pre_cagr = (pre_med / initial_capital) ** (1 / time_horizon_years) - 1
        post_cagr = (post_med / initial_capital) ** (1 / time_horizon_years) - 1
        
        tax_drag = pre_med - post_med
        tax_drag_pct = (tax_drag / pre_med * 100) if pre_med > 0 else 0
        
        # Average final carryforwards
        valid_details = [d for d in tax_details if d is not None]
        avg_final_cf = np.mean([d['final_cf']['st'] + d['final_cf']['lt'] 
                                for d in valid_details]) if valid_details else 0
        
        results[strategy_id] = {
            'pre_tax_median_wealth': pre_med,
            'post_tax_median_wealth': post_med,
            'pre_tax_median_cagr': pre_cagr,
            'post_tax_median_cagr': post_cagr,
            'median_tax_drag': tax_drag,
            'tax_drag_pct': tax_drag_pct,
            'avg_final_cf': avg_final_cf,
            'wired_engine_v5_1': True,
            'elections_used': elections.capital_loss_strategy.value
        }
    
    return results


