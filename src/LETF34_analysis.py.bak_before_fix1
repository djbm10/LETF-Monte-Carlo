def get_cache_filenames(start_date: str, end_date: str, scenario_name: Optional[str] = None):
    """
    Generate cache filenames keyed by date range, scenario, and calibration settings.
    """
    scenario = str(scenario_name or MARKET_SCENARIO)
    start_tag = start_date.replace('-', '')
    end_tag = end_date.replace('-', '')
    fp = _cache_settings_fingerprint(scenario)
    key = f"{start_tag}_{end_tag}_{scenario}_{fp}"

    return {
        'data': CACHE_DIR / f"historical_data_{key}.pkl",
        'regime': CACHE_DIR / f"regime_model_{key}.pkl",
        'correlation': CACHE_DIR / f"correlations_{key}.pkl",
        'validation': CACHE_DIR / f"validation_results_{key}.json",
        'joint_return': CACHE_DIR / f"joint_return_model_{key}.pkl",
        'funding': CACHE_DIR / f"funding_spread_model_{key}.pkl",
        'tracking': CACHE_DIR / f"tracking_residual_model_{key}.pkl",
        'stress': CACHE_DIR / f"stress_state_model_{key}.pkl",
        'bootstrap': CACHE_DIR / f"bootstrap_data_{key}.pkl",
        'cache_key': key
    }


