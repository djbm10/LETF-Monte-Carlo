        if asset in ['TQQQ', 'QLD']:
            idx_col = 'QQQ_Ret' if 'QQQ_Ret' in df.columns else 'SPY_Ret'
        else:
            idx_col = 'SPY_Ret'
        if idx_col not in df.columns or 'VIX' not in df.columns:
            continue

        real = df[real_col].to_numpy(dtype=float)
        idx = df[idx_col].to_numpy(dtype=float)
        vix = df['VIX'].ffill().bfill().fillna(20.0).to_numpy(dtype=float)
        rf = df.get('IRX', pd.Series(4.5, index=df.index)).ffill().bfill().fillna(4.5).to_numpy(dtype=float) / 100.0
        tnx = df.get('TNX', pd.Series((rf * 100.0) + 1.0, index=df.index)).ffill().bfill().to_numpy(dtype=float)

        spread_df = pd.DataFrame({'VIX': vix, 'IRX': rf * 100.0, 'TNX': tnx}, index=df.index)
        if isinstance(fmodel, dict) and 'base' in fmodel:
            spread_series = predict_borrow_spread_series(spread_df, fmodel, stress_state=None)
        else:
            spread_series = np.full(len(df), 0.0075, dtype=float)
        spread_scale_eff = float(np.clip(float(fmodel.get('global_spread_scale', 1.0)), 0.10, 2.00))
        if isinstance(fmodel.get('asset_spread_scale', None), dict):
            spread_scale_eff = float(np.clip(float(fmodel.get('asset_spread_scale', {}).get(asset, spread_scale_eff)), 0.10, 2.00))
        spread_series = np.clip(
            spread_series * spread_scale_eff,
            0.0,
            max(float(fmodel.get('max_spread', 0.08)) * 1.5, float(fmodel.get('min_spread', 0.0)) + 1e-6)
        )

        lev = float(ASSETS[asset]['leverage'])
        expense_daily = float(ASSETS[asset]['expense_ratio']) / 252.0
        expected = lev * idx - ((lev - 1.0) * (rf + spread_series) / 252.0) - expense_daily
        residual = real - expected

        mask = np.isfinite(real) & np.isfinite(expected) & np.isfinite(residual)
        syn_col = f'{asset}_IsSynthetic'
        if syn_col in df.columns:
            mask &= (~df[syn_col].fillna(False).to_numpy(dtype=bool))
        if int(mask.sum()) < 220:
            continue
        r = residual[mask]
        te_ann = float(np.nanstd(r, ddof=1) * np.sqrt(252))
        out['assets'][asset] = {
            'n_days': int(len(r)),
            'tracking_error_ann': te_ann,
            'percentiles': {
                'p5': float(np.percentile(r, 5)),
                'p25': float(np.percentile(r, 25)),
                'p50': float(np.percentile(r, 50)),
                'p75': float(np.percentile(r, 75)),
                'p95': float(np.percentile(r, 95)),
            }
        }
    out['assets_evaluated'] = int(len(out['assets']))
    return out


def _evaluate_tracking_channel_fit(df: pd.DataFrame,
                                   regime_model: Dict[str, Any],
                                   te_targets: Dict[str, Any]) -> Dict[str, Any]:
    out: Dict[str, Any] = {
        'assets': {},
        'assets_compared': 0,
        'error_sum': float('inf'),
        'error_mean': float('inf')
    }
    funding_model = regime_model.get('funding_model', {}) if isinstance(regime_model, dict) else {}
    tracking_model = regime_model.get('tracking_residual_model', {}) if isinstance(regime_model, dict) else {}
    targets = (te_targets or {}).get('assets', {}) if isinstance(te_targets, dict) else {}
    if not isinstance(targets, dict) or len(targets) == 0:
        return out

    errs = []
    for asset, target in targets.items():
        try:
            modeled = _model_real_leveraged_returns(
                df=df,
                asset=asset,
                funding_model=funding_model,
                tracking_model=tracking_model,
                spread_scale=1.0,
                te_scale=1.0,
                underlying_scale=1.0,
                alpha_daily=0.0,
                min_days=252,
                seed=17771 + sum(ord(c) for c in asset)
            )
        except Exception:
            modeled = None
        if modeled is None:
            continue
        te_series = np.asarray(modeled['modeled_returns'], dtype=float) - np.asarray(modeled['expected_returns'], dtype=float)
        if len(te_series) < 220:
            continue
        modeled_te_ann = float(np.nanstd(te_series, ddof=1) * np.sqrt(252))
        mp = {
            'p5': float(np.percentile(te_series, 5)),
            'p25': float(np.percentile(te_series, 25)),
            'p50': float(np.percentile(te_series, 50)),
            'p75': float(np.percentile(te_series, 75)),
            'p95': float(np.percentile(te_series, 95)),
        }
        tp = target.get('percentiles', {})
        te_ann_err = float(abs(modeled_te_ann - float(target.get('tracking_error_ann', np.nan))))
        pct_err = float(np.nansum([
            1.20 * abs(mp['p5'] - float(tp.get('p5', np.nan))),
            0.70 * abs(mp['p25'] - float(tp.get('p25', np.nan))),
            0.60 * abs(mp['p50'] - float(tp.get('p50', np.nan))),
            0.80 * abs(mp['p75'] - float(tp.get('p75', np.nan))),
            1.40 * abs(mp['p95'] - float(tp.get('p95', np.nan))),
        ]))
        err = float(1.75 * te_ann_err + pct_err)
        out['assets'][asset] = {
            'error': err,
            'te_ann_error': te_ann_err,
            'percentile_error_sum': pct_err,
            'target_te_ann': float(target.get('tracking_error_ann', np.nan)),
            'modeled_te_ann': modeled_te_ann
        }
        errs.append(err)
    out['assets_compared'] = int(len(errs))
    out['error_sum'] = float(np.nansum(errs)) if len(errs) > 0 else float('inf')
    out['error_mean'] = float(np.nanmean(errs)) if len(errs) > 0 else float('inf')
    return out


def _compute_realized_slippage_target_bps(df: pd.DataFrame,
                                          funding_model: Dict[str, float]) -> Dict[str, Any]:
    out: Dict[str, Any] = {'assets': {}, 'assets_evaluated': 0, 'target_bps': float('nan')}
    fmodel = funding_model if isinstance(funding_model, dict) else {}
    bps_vals = []
    for asset in ['TQQQ', 'UPRO', 'SSO', 'QLD']:
        real_col = f'{asset}_Real_Ret'
        if real_col not in df.columns:
            continue
        if asset in ['TQQQ', 'QLD']:
            idx_col = 'QQQ_Ret' if 'QQQ_Ret' in df.columns else 'SPY_Ret'
        else:
            idx_col = 'SPY_Ret'
        if idx_col not in df.columns or 'VIX' not in df.columns:
            continue

        real = df[real_col].to_numpy(dtype=float)
        idx = df[idx_col].to_numpy(dtype=float)
        vix = df['VIX'].ffill().bfill().fillna(20.0).to_numpy(dtype=float)
        rf = df.get('IRX', pd.Series(4.5, index=df.index)).ffill().bfill().fillna(4.5).to_numpy(dtype=float) / 100.0
        tnx = df.get('TNX', pd.Series((rf * 100.0) + 1.0, index=df.index)).ffill().bfill().to_numpy(dtype=float)
        spread_df = pd.DataFrame({'VIX': vix, 'IRX': rf * 100.0, 'TNX': tnx}, index=df.index)
        if isinstance(fmodel, dict) and 'base' in fmodel:
            spread_series = predict_borrow_spread_series(spread_df, fmodel, stress_state=None)
        else:
            spread_series = np.full(len(df), 0.0075, dtype=float)

        spread_scale_eff = float(np.clip(float(fmodel.get('global_spread_scale', 1.0)), 0.10, 2.00))
        if isinstance(fmodel.get('asset_spread_scale', None), dict):
            spread_scale_eff = float(np.clip(float(fmodel.get('asset_spread_scale', {}).get(asset, spread_scale_eff)), 0.10, 2.00))
        spread_series = np.clip(
            spread_series * spread_scale_eff,
            0.0,
            max(float(fmodel.get('max_spread', 0.08)) * 1.5, float(fmodel.get('min_spread', 0.0)) + 1e-6)
        )

        lev = float(ASSETS[asset]['leverage'])
        expense_daily = float(ASSETS[asset]['expense_ratio']) / 252.0
        expected = lev * idx - ((lev - 1.0) * (rf + spread_series) / 252.0) - expense_daily
        shortfall = np.maximum(expected - real, 0.0)
        turnover_proxy = max(lev - 1.0, 0.0) * np.abs(idx)

        mask = np.isfinite(shortfall) & np.isfinite(turnover_proxy) & (turnover_proxy > 1e-8)
        syn_col = f'{asset}_IsSynthetic'
        if syn_col in df.columns:
            mask &= (~df[syn_col].fillna(False).to_numpy(dtype=bool))
        if int(mask.sum()) < 220:
            continue
        bps = float(np.nanmean(shortfall[mask]) / max(np.nanmean(turnover_proxy[mask]), 1e-9) * 10000.0)
        bps = float(np.clip(bps, 0.1, 200.0))
        out['assets'][asset] = {'slippage_bps_per_turnover': bps, 'n_days': int(mask.sum())}
        bps_vals.append(bps)

    out['assets_evaluated'] = int(len(out['assets']))
    if len(bps_vals) > 0:
        out['target_bps'] = float(np.nanmedian(np.asarray(bps_vals, dtype=float)))
    return out


def _compute_model_slippage_bps(df: pd.DataFrame,
                                strategy_ids: List[str]) -> Dict[str, Any]:
    out: Dict[str, Any] = {'strategies': {}, 'strategies_evaluated': 0, 'median_bps': float('nan')}
    vals = []
    for sid in strategy_ids:
        sub = _prepare_strategy_real_dataset(df, sid)
        if sub is None:
            continue
        try:
            eq_no_cost, _ = run_strategy_fixed(
                sub,
                sid,
                regime_path=None,
                correlation_matrices={},
                apply_costs=False,
                trade_journal=None
            )
            journal = TradeJournal()
            eq_cost, _ = run_strategy_fixed(
                sub,
                sid,
                regime_path=None,
                correlation_matrices={},
                apply_costs=True,
                trade_journal=journal
            )
        except Exception:
            continue
        if len(eq_no_cost) < 260 or len(eq_cost) != len(eq_no_cost):
            continue
        r0 = eq_no_cost.pct_change().fillna(0.0).to_numpy(dtype=float)
        r1 = eq_cost.pct_change().fillna(0.0).to_numpy(dtype=float)
        drag = np.maximum(r0 - r1, 0.0)
        avg_drag = float(np.nanmean(drag))
        avg_equity = float(np.nanmean(eq_no_cost.to_numpy(dtype=float)))
        trades = journal.get_full_trades()
        total_dollar = float(np.nansum([float(t.get('dollar_amount', 0.0)) for t in trades]))
        turnover_daily = total_dollar / max(avg_equity, 1e-9) / max(len(r0), 1)
        if (not np.isfinite(turnover_daily)) or turnover_daily <= 1e-8:
            continue
        bps = float(avg_drag / turnover_daily * 10000.0)
        if not np.isfinite(bps):
            continue
        bps = float(np.clip(bps, 0.1, 300.0))
        vals.append(bps)
        out['strategies'][sid] = {
            'slippage_bps_per_turnover': bps,
            'avg_daily_drag': avg_drag,
            'turnover_daily': float(turnover_daily),
            'n_days': int(len(r0))
        }
    out['strategies_evaluated'] = int(len(out['strategies']))
    if len(vals) > 0:
        out['median_bps'] = float(np.nanmedian(np.asarray(vals, dtype=float)))
    return out


def tune_execution_te_coefficients_constrained(df: pd.DataFrame,
                                               regime_model: Dict[str, Any],
                                               correlation_matrices: Dict[int, np.ndarray],
                                               te_scales: Optional[List[float]] = None,
                                               exec_scales: Optional[List[float]] = None,
                                               n_sims: int = STAGE_C_EXEC_MC_SIMS,
                                               horizon_years: int = STAGE_C_EXEC_HORIZON_YEARS,
                                               strategy_ids: Optional[List[str]] = None,
                                               require_drawdown_pass: bool = STAGE_C_EXEC_REQUIRE_DD_PASS,
                                               dd_n_sims: int = STAGE_C_EXEC_DD_SIMS) -> Dict[str, Any]:
    """
    Stage C:
      Tune TE stress-channel and execution-friction coefficients under constraints:
      - real realized tracking-error fit
      - turnover slippage anchor
      - post-cost strategy volatility percentile realism
      - preserve SPY drawdown gate from Stage A
    """
    out: Dict[str, Any] = {
        'enabled': True,
        'applied': False,
        'selected_te_scale': 1.0,
        'selected_exec_scale': 1.0,
        'baseline': {'te_scale': 1.0, 'exec_scale': 1.0},
        'feasible_selected': False,
        'candidates': []
    }
    if not isinstance(correlation_matrices, dict) or len(correlation_matrices) == 0:
        out['enabled'] = False
        out['reason'] = 'missing_correlation_matrices'
        return out
    funding_model = regime_model.get('funding_model', {}) if isinstance(regime_model, dict) else {}
    if (not isinstance(funding_model, dict)) or ('base' not in funding_model):
        out['enabled'] = False
        out['reason'] = 'missing_funding_model_for_stage_c'
        return out

    strategy_ids_eval = list(strategy_ids) if isinstance(strategy_ids, list) and len(strategy_ids) > 0 else list(STAGE_C_EXEC_VOL_STRATEGIES)
    te_targets = _compute_realized_tracking_error_targets(df=df, funding_model=funding_model)
    if int(te_targets.get('assets_evaluated', 0)) < 2:
        out['enabled'] = False
        out['reason'] = 'insufficient_real_tracking_targets'
        out['tracking_targets'] = te_targets
        return out
    real_vol_ref = _compute_real_strategy_post_cost_vol_percentiles(df=df, strategy_ids=strategy_ids_eval, apply_costs=True)
    if int(real_vol_ref.get('strategies_evaluated', 0)) < 1:
        out['enabled'] = False
        out['reason'] = 'insufficient_real_strategy_vol_reference'
        out['strategy_vol_reference'] = real_vol_ref
        return out

    slippage_target = _compute_realized_slippage_target_bps(df=df, funding_model=funding_model)
    target_slip_bps = float(slippage_target.get('target_bps', np.nan))
    if not np.isfinite(target_slip_bps):
        target_slip_bps = 8.0

    try:
        dd_diag = _compute_spy_drawdown_episode_metrics(df=df, regime_model=regime_model, n_sims=dd_n_sims)
        dd_pass = bool(dd_diag.get('all_passed', False))
    except Exception as e:
        dd_diag = {'all_passed': False, 'error': str(e), 'error_type': type(e).__name__}
        dd_pass = False
        if require_drawdown_pass:
            out['enabled'] = False
            out['reason'] = 'drawdown_constraint_evaluation_failed'
            out['drawdown_constraint'] = dd_diag
            return out

    grid_te = list(te_scales) if isinstance(te_scales, list) and len(te_scales) > 0 else list(STAGE_C_EXEC_TE_GRID)
    grid_exec = list(exec_scales) if isinstance(exec_scales, list) and len(exec_scales) > 0 else list(STAGE_C_EXEC_COST_GRID)
    grid_te = sorted({float(np.clip(x, 0.40, 2.20)) for x in grid_te} | {1.0})
    grid_exec = sorted({float(np.clip(x, 0.40, 2.20)) for x in grid_exec} | {1.0})

    sim_cfg = get_simulation_config()
    bootstrap_sampler = None
    if sim_cfg.use_block_bootstrap and df is not None and len(df) > 0:
        bootstrap_sampler = create_bootstrap_sampler(df)

    base_te_snap = _snapshot_te_stress_params()
    base_exec_snap = _snapshot_execution_realism_params()
    candidate_rows: List[Dict[str, Any]] = []
    candidate_snapshots: Dict[Tuple[float, float], Dict[str, Dict[str, Any]]] = {}

    for te_sc in grid_te:
        for ex_sc in grid_exec:
            te_snap = _scale_te_stress_snapshot(base_te_snap, te_sc)
            ex_snap = _scale_execution_realism_snapshot(base_exec_snap, ex_sc)
            candidate_snapshots[(float(te_sc), float(ex_sc))] = {
                'te': copy.deepcopy(te_snap),
                'exec': copy.deepcopy(ex_snap)
            }
            with _temporary_te_stress_snapshot(te_snap), _temporary_execution_realism_snapshot(ex_snap):
                te_fit = _evaluate_tracking_channel_fit(df=df, regime_model=regime_model, te_targets=te_targets)
                model_slip = _compute_model_slippage_bps(df=df, strategy_ids=strategy_ids_eval)
                model_slip_bps = float(model_slip.get('median_bps', np.nan))
                if np.isfinite(model_slip_bps):
                    slip_err = float(abs(model_slip_bps - target_slip_bps) / max(target_slip_bps, 1e-6))
                else:
                    slip_err = float('inf')

                mc_res = _run_monte_carlo_paths_sequential(
                    strategy_ids=strategy_ids_eval,
                    time_horizon=int(max(1, horizon_years)),
                    regime_model=regime_model,
                    correlation_matrices=correlation_matrices,
                    n_sims=int(max(20, n_sims)),
                    historical_df=df,
                    seed_offset=83,
                    bootstrap_sampler=bootstrap_sampler
                )
                sim_vol_ref = _extract_simulated_strategy_vol_percentiles(mc_results=mc_res, strategy_ids=strategy_ids_eval)
                vol_err = _compute_strategy_vol_percentile_error(
                    real_ref=real_vol_ref,
                    sim_ref=sim_vol_ref,
                    percentile_weights=STAGE_C_EXEC_VOL_PERCENTILE_WEIGHTS
                )

            enough_strats = int(vol_err.get('strategies_compared', 0)) >= max(1, min(2, int(real_vol_ref.get('strategies_evaluated', 0))))
            feasible = bool(
                enough_strats and
                np.isfinite(float(vol_err.get('weighted_error_sum', np.nan))) and
                np.isfinite(float(te_fit.get('error_mean', np.nan))) and
                np.isfinite(float(slip_err)) and
                ((not require_drawdown_pass) or dd_pass)
            )
            row = {
                'te_scale': float(te_sc),
                'exec_scale': float(ex_sc),
                'feasible': bool(feasible),
                'drawdown_constraint_passed': bool(dd_pass),
                'strategies_compared': int(vol_err.get('strategies_compared', 0)),
                'vol_weighted_error_sum': float(vol_err.get('weighted_error_sum', float('inf'))),
                'vol_focus_p50_p75_sum': float(vol_err.get('focus_p50_p75_sum', float('inf'))),
                'tracking_error_mean': float(te_fit.get('error_mean', float('inf'))),
                'tracking_error_sum': float(te_fit.get('error_sum', float('inf'))),
                'slippage_error_rel': float(slip_err),
                'slippage_target_bps': float(target_slip_bps),
                'slippage_model_bps': float(model_slip_bps) if np.isfinite(model_slip_bps) else float('nan'),
                'tracking_detail': te_fit.get('assets', {}),
                'vol_detail': vol_err.get('strategies', {}),
            }
            row['score_key'] = (
                0 if row['feasible'] else 1,
                0 if np.isfinite(row['vol_weighted_error_sum']) else 1,
                float(row['vol_weighted_error_sum']),
                float(row['tracking_error_mean']),
                float(row['slippage_error_rel']),
                abs(float(row['te_scale']) - 1.0) + 0.70 * abs(float(row['exec_scale']) - 1.0)
            )
            candidate_rows.append(row)
            print(f"  Stage C candidate te={float(te_sc):.3f} exec={float(ex_sc):.3f}: "
                  f"feasible={row['feasible']}  vol_w={row['vol_weighted_error_sum']:.6f}  "
                  f"te_err={row['tracking_error_mean']:.6f}  slip_rel={row['slippage_error_rel']:.6f}")

    base_rows = [r for r in candidate_rows if abs(float(r['te_scale']) - 1.0) < 1e-10 and abs(float(r['exec_scale']) - 1.0) < 1e-10]
    if len(base_rows) == 0:
        base_row = min(candidate_rows, key=lambda x: tuple(x['score_key']))
    else:
        base_row = min(base_rows, key=lambda x: tuple(x['score_key']))
    feasible_rows = [r for r in candidate_rows if bool(r.get('feasible', False))]
    best_row = min(feasible_rows, key=lambda x: tuple(x['score_key'])) if len(feasible_rows) > 0 else base_row
    apply_tuned = bool(best_row.get('feasible', False) and tuple(best_row['score_key']) < tuple(base_row['score_key']))
    selected_row = best_row if apply_tuned else base_row
    selected_reason = 'lexicographic'

    strict_diag: Dict[str, Any] = {
        'enabled': bool(STAGE_C_INSTITUTIONAL_STRICT_ENABLED),
        'applied': False
    }
    if bool(STAGE_C_INSTITUTIONAL_STRICT_ENABLED) and len(feasible_rows) > 0:
        eps = float(max(0.0, STAGE_C_STRICT_NUMERIC_EPS))
        base_vol = float(base_row.get('vol_weighted_error_sum', np.inf))
        base_te = float(base_row.get('tracking_error_mean', np.inf))
        base_slip = float(base_row.get('slippage_error_rel', np.inf))

        vol_reg = float(max(-0.95, STAGE_C_STRICT_MAX_VOL_REGRESSION_REL))
        te_reg = float(max(-0.95, STAGE_C_STRICT_MAX_TE_REGRESSION_REL))
        slip_reg = float(max(-0.95, STAGE_C_STRICT_MAX_SLIPPAGE_REGRESSION_REL))
        min_slip_improve = float(np.clip(STAGE_C_STRICT_MIN_SLIPPAGE_IMPROVEMENT_REL, 0.0, 0.95))

        vol_cap = float(base_vol * (1.0 + vol_reg)) if np.isfinite(base_vol) else float('inf')
        te_cap = float(base_te * (1.0 + te_reg)) if np.isfinite(base_te) else float('inf')
        slip_cap = float(base_slip * (1.0 + slip_reg)) if np.isfinite(base_slip) else float('inf')
        slip_target = float(base_slip * (1.0 - min_slip_improve)) if np.isfinite(base_slip) else float('inf')
        slip_target = float(min(slip_target, slip_cap))

        strict_rows = [
            r for r in feasible_rows
            if float(r.get('vol_weighted_error_sum', np.inf)) <= (vol_cap + eps)
            and float(r.get('tracking_error_mean', np.inf)) <= (te_cap + eps)
            and float(r.get('slippage_error_rel', np.inf)) <= (slip_target + eps)
        ]
        strict_relaxed = False
        if len(strict_rows) == 0 and min_slip_improve > 0.0:
            strict_rows = [
                r for r in feasible_rows
                if float(r.get('vol_weighted_error_sum', np.inf)) <= (vol_cap + eps)
                and float(r.get('tracking_error_mean', np.inf)) <= (te_cap + eps)
                and float(r.get('slippage_error_rel', np.inf)) <= (slip_cap + eps)
            ]
            strict_relaxed = True

        strict_diag.update({
            'base_metrics': {
                'vol_weighted_error_sum': float(base_vol),
                'tracking_error_mean': float(base_te),
                'slippage_error_rel': float(base_slip)
            },
            'thresholds': {
                'vol_cap': float(vol_cap),
                'te_cap': float(te_cap),
                'slippage_target': float(slip_target),
                'slippage_cap': float(slip_cap),
                'min_slippage_improvement_rel': float(min_slip_improve)
            },
            'candidate_counts': {
                'feasible_rows': int(len(feasible_rows)),
                'strict_rows': int(len(strict_rows))
            },
            'slippage_target_relaxed': bool(strict_relaxed),
        })

        if len(strict_rows) > 0:
            strict_best = min(
                strict_rows,
                key=lambda r: (
                    float(r.get('slippage_error_rel', np.inf)),
                    float(r.get('vol_weighted_error_sum', np.inf)),
                    float(r.get('tracking_error_mean', np.inf)),
                    abs(float(r.get('exec_scale', 1.0)) - 1.0) + 0.60 * abs(float(r.get('te_scale', 1.0)) - 1.0)
                )
            )
            selected_row = strict_best
            selected_reason = 'institutional_strict'
            same_as_baseline = (
                abs(float(selected_row.get('te_scale', np.nan)) - float(base_row.get('te_scale', np.nan))) < 1e-12
                and abs(float(selected_row.get('exec_scale', np.nan)) - float(base_row.get('exec_scale', np.nan))) < 1e-12
            )
            apply_tuned = bool(selected_row.get('feasible', False) and (not same_as_baseline))
            strict_diag['applied'] = bool(apply_tuned)
            strict_diag['selected'] = {
                'te_scale': float(selected_row.get('te_scale', np.nan)),
                'exec_scale': float(selected_row.get('exec_scale', np.nan)),
                'vol_weighted_error_sum': float(selected_row.get('vol_weighted_error_sum', np.nan)),
